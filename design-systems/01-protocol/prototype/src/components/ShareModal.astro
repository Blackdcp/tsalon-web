---
// src/components/ShareModal.astro
export interface Props {
  leaderboard: any[];
  currentUserRank?: number;
  currentUser?: any;
}

const { leaderboard, currentUserRank, currentUser } = Astro.props;
const top10 = leaderboard.slice(0, 10);
const todayDateStr = new Date().toISOString().split('T')[0];

const formatPosterAmount = (num: any) => {
  const n = typeof num === 'number' ? num : (Number(num) || 0);
  if (n >= 100_000_000) return { val: (n / 100_000_000).toFixed(2), unit: '亿' };
  if (n >= 10_000) return { val: (n / 10_000).toFixed(1), unit: '万' };
  return { val: n.toFixed(0), unit: '' };
};
---

<div id="share-modal-overlay" class="share-modal-hidden">
  <div class="share-modal-container">
    
    <!-- The Card to be captured -->
    <div id="share-card" class="share-card">
      <div class="share-card-header">
        <img src="/images/logo-dark.png" alt="T Salon" class="share-logo-primary" crossorigin="anonymous" />
        <h2>Token 消耗排行榜</h2>
        <div class="share-tag-pill">造垃圾耻辱榜 · 实时排行</div>
      </div>
      
      <div class="share-top10">
        <div class="share-list-header">
          <span class="share-list-bar"></span> TOP 10 榜单
        </div>
        <ul class="share-list">
          {top10.map((user, idx) => (
            <li>
              <div class="share-list-left">
                <span class={`share-rank-badge rank-${idx + 1}`}>{idx + 1}</span>
                <img src={user.image} alt={user.name} class="share-avatar-small" crossorigin="anonymous" />
                <span class="share-list-name">{user.name}</span>
              </div>
              <div class="share-list-right">
                <strong class="share-list-tokens">{formatPosterAmount(user.tokens?.total || 0).val} {formatPosterAmount(user.tokens?.total || 0).unit}</strong>
                <span class="share-list-cost">~${((user.tokens?.total || 0) / 1000000 * 3).toFixed(0)}</span>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <div class="share-footer">
        <div class="share-qr-section">
          <img src="https://api.qrserver.com/v1/create-qr-code/?size=100x100&data=https://www.tsalon.tech/tokenrank" alt="QR Code" class="share-qr" crossorigin="anonymous" />
          <div class="share-qr-text">
            <strong>扫码看完整排行榜</strong>
            <p>Top 10 之外还有更多排名</p>
            <span class="share-link">www.tsalon.tech</span>
            <p class="share-update-note">数据每 30 分钟更新</p>
          </div>
        </div>
        {currentUser && currentUserRank ? (
          <div class="share-my-rank">我的排名 <strong>#{currentUserRank}</strong></div>
        ) : null}
        <div class="share-bottom-branding">
          T Salon · Token 消耗排行榜 · {todayDateStr} 生成
        </div>
      </div>
    </div>

    <!-- Actions -->
    <div class="share-actions">
      <button id="btn-save-image" class="share-action-btn primary">保存图片</button>
      <button id="btn-close-share" class="share-action-btn secondary">关闭</button>
    </div>
    <div class="share-instruction">
      手机端可长按图片保存或转发好友
    </div>
  </div>
</div>

<style>
  .share-modal-hidden {
    display: none !important;
  }
  
  #share-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.85);
    z-index: 9999;
    display: flex;
    justify-content: center;
    align-items: center;
    overflow-y: auto;
    padding: 2rem 1rem;
    backdrop-filter: blur(5px);
  }

  .share-modal-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 400px;
    width: 100%;
    margin: auto;
  }

  .share-card {
    background: white;
    border-radius: 20px;
    width: 100%;
    padding: 1.5rem;
    color: #111827;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);
    position: relative;
    overflow: hidden;
  }

  .share-card-header {
    text-align: left;
    margin-bottom: 1.5rem;
  }

  .share-logo-primary {
    height: 24px;
    object-fit: contain;
    margin-bottom: 0.5rem;
    display: block;
  }

  .share-card-header h2 {
    font-size: 1.5rem;
    font-weight: 800;
    margin: 0 0 0.25rem 0;
    color: #111827;
  }

  .share-subtitle {
    font-size: 0.8rem;
    color: #6B7280;
    margin: 0 0 0.75rem 0;
  }

  .share-tag-pill {
    display: inline-block;
    background: #F3F4F6;
    color: #374151;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.75rem;
    border-radius: 12px;
    margin-top: 0.35rem;
  }

  .share-top10 {
    margin-bottom: 1.5rem;
  }

  .share-list-header {
    font-size: 0.75rem;
    font-weight: 700;
    color: #6B7280;
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    letter-spacing: 0.05em;
  }

  .share-list-bar {
    width: 3px;
    height: 12px;
    background: #10B981;
    margin-right: 0.5rem;
    border-radius: 2px;
  }

  .share-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .share-list li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0;
    border-bottom: 1px solid #F3F4F6;
  }

  .share-list li:last-child {
    border-bottom: none;
  }

  .share-list-left {
    display: flex;
    align-items: center;
  }

  .share-rank-badge {
    width: 20px;
    height: 20px;
    border-radius: 4px;
    background: #E5E7EB;
    color: #6B7280;
    font-size: 0.7rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-right: 0.75rem;
  }

  .rank-1 { background: #FBBF24; color: white; }
  .rank-2 { background: #9CA3AF; color: white; }
  .rank-3 { background: #F59E0B; color: white; }

  .share-avatar-small {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    margin-right: 0.5rem;
  }

  .share-list-name {
    font-size: 0.85rem;
    font-weight: 600;
    color: #111827;
  }

  .share-list-right {
    text-align: right;
  }

  .share-list-tokens {
    display: block;
    font-size: 0.85rem;
    color: #059669;
  }

  .share-list-cost {
    font-size: 0.65rem;
    color: #9CA3AF;
  }

  .share-footer {
    background: #F9FAFB;
    border-radius: 16px;
    padding: 1rem;
    margin-top: 1rem;
  }

  .share-qr-section {
    display: flex;
    align-items: center;
    margin-bottom: 1rem;
  }

  .share-qr {
    width: 80px;
    height: 80px;
    border-radius: 8px;
    margin-right: 1rem;
  }

  .share-qr-text {
    flex: 1;
  }

  .share-qr-text strong {
    display: block;
    font-size: 0.9rem;
    color: #111827;
    margin-bottom: 0.2rem;
  }

  .share-qr-text p {
    font-size: 0.7rem;
    color: #6B7280;
    margin: 0 0 0.3rem 0;
  }

  .share-link {
    color: #10B981;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .share-update-note {
    font-size: 0.6rem !important;
    color: #9CA3AF !important;
    margin-top: 0.3rem !important;
  }

  .share-bottom-branding {
    text-align: center;
    font-size: 0.65rem;
    color: #9CA3AF;
    margin-top: 1rem;
  }

  .share-my-rank {
    text-align: center;
    font-size: 0.75rem;
    color: #6B7280;
    margin-top: 0.75rem;
    padding-top: 0.75rem;
    border-top: 1px dashed #E5E7EB;
  }

  .share-my-rank strong {
    color: #10B981;
    font-size: 0.9rem;
  }

  .share-actions {
    display: flex;
    gap: 1rem;
    margin-top: 2rem;
    width: 100%;
  }

  .share-action-btn {
    flex: 1;
    padding: 1rem;
    border-radius: 12px;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    border: none;
    transition: opacity 0.2s;
  }

  .share-action-btn:hover {
    opacity: 0.9;
  }

  .share-action-btn.primary {
    background: #111827;
    color: white;
  }

  .share-action-btn.secondary {
    background: #374151;
    color: white;
  }

  .share-instruction {
    color: #9CA3AF;
    font-size: 0.85rem;
    margin-top: 1.5rem;
    text-align: center;
  }
</style>

<script>
  import * as htmlToImage from 'html-to-image';

  const modal = document.getElementById('share-modal-overlay');
  const btnClose = document.getElementById('btn-close-share');
  const btnSave = document.getElementById('btn-save-image');
  const card = document.getElementById('share-card');

  // Expose function globally so other buttons can trigger it
  (window as any).openShareModal = () => {
    if (modal) {
      modal.classList.remove('share-modal-hidden');
      document.body.style.overflow = 'hidden'; // Prevent scrolling under modal
    }
  };

  if (btnClose && modal) {
    btnClose.addEventListener('click', () => {
      modal.classList.add('share-modal-hidden');
      document.body.style.overflow = '';
    });
  }

  if (btnSave && card) {
    btnSave.addEventListener('click', async () => {
      try {
        const originalText = btnSave.innerText;
        btnSave.innerText = '生成中...';
        btnSave.setAttribute('disabled', 'true');
        
        // Wait a tiny bit for fonts to render if needed
        await new Promise(r => setTimeout(r, 100));
        
        const dataUrl = await htmlToImage.toPng(card, {
          quality: 1,
          pixelRatio: 2, // High DPI for crisp text
          style: {
            transform: 'scale(1)',
            transformOrigin: 'top left'
          }
        });
        
        const link = document.createElement('a');
        link.download = `tokenrank-share-${Date.now()}.png`;
        link.href = dataUrl;
        link.click();
        
        btnSave.innerText = '保存成功';
        setTimeout(() => {
          btnSave.innerText = originalText;
          btnSave.removeAttribute('disabled');
        }, 2000);
      } catch (error) {
        console.error('oops, something went wrong!', error);
        btnSave.innerText = '生成失败';
        setTimeout(() => {
          btnSave.innerText = '保存图片';
          btnSave.removeAttribute('disabled');
        }, 2000);
      }
    });
  }
</script>
