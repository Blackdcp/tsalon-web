---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getResetRadarData } from '../lib/reset-radar';

type ProviderKey = 'codex' | 'claude' | 'grok';

interface Props {
  provider: ProviderKey;
  locale: 'zh' | 'en';
}

const { provider, locale } = Astro.props;
const isEn = locale === 'en';
const radarData = await getResetRadarData();
const { updatedAtBeijing, status } = radarData;
const pData = radarData[provider];
Astro.response.headers.set('Cache-Control', 'public, max-age=60, s-maxage=300, stale-while-revalidate=3600');

const stripTags = (html: string) => html.replace(/<[^>]*>/g, '');

const metaByProvider: Record<ProviderKey, {
  titleZh: string;
  titleEn: string;
  descZh: string;
  descEn: string;
  h1Zh: string;
  h1En: string;
  introZh: string;
  introEn: string;
  guideTitleZh: string;
  guideTitleEn: string;
  guidePointsZh: { title: string; body: string }[];
  guidePointsEn: { title: string; body: string }[];
  faqZh: { q: string; a: string }[];
  faqEn: { q: string; a: string }[];
}> = {
  claude: {
    titleZh: 'Claude 额度重置时间与 5 小时限流恢复计算器 (Claude Code / Pro / Max) | T Salon',
    titleEn: 'Claude Quota Reset Tracker & 5-Hour Limit Calculator (Claude Code / Pro / Max) | T Salon',
    descZh: '实时查询 Anthropic Claude 与 Claude Code 的全局重置、指定范围重置与发卡记录，提供 5 小时滑动窗口恢复时间计算器与每周额度消耗预算规划。',
    descEn: 'Track Anthropic Claude and Claude Code quota resets and bonus cards from WhenReset.dev, calculate your 5-hour rolling window recovery time, and plan weekly quota pacing.',
    h1Zh: 'Anthropic Claude 额度重置雷达与 5 小时窗口计算器',
    h1En: 'Anthropic Claude Quota Reset Radar & 5-Hour Window Calculator',
    introZh: '汇总 WhenReset.dev 收录的 Anthropic Claude（含 Claude Web、Claude Code、Pro 与 Max 订阅）全网重置与发卡记录，提供 5 小时滑动窗口恢复时间换算与 7 天周度配额预算规划。',
    introEn: 'Live WhenReset.dev event records for Anthropic Claude (including Claude Web, Claude Code, Pro, and Max tiers), paired with a 5-hour rolling window recovery calculator and 7-day weekly quota planner.',
    guideTitleZh: 'Claude 与 Claude Code 额度机制与恢复时间排查要点',
    guideTitleEn: 'Claude & Claude Code Quota Rules and Recovery Checklist',
    guidePointsZh: [
      {
        title: '5 小时滑动窗口（Session Window）从第一条消息起算',
        body: '当你遇到 Claude 提示达到使用上限时，恢复时间等于「本轮 5 小时窗口内的第一条有效请求时间 + 5 小时」，而不是报错发生的那一刻。在下方计算器输入已知窗口起点即可换算北京时间恢复点。',
      },
      {
        title: '周度限额（Weekly Limit）与 5 小时窗口相互独立',
        body: 'Claude Pro 与 Max 账号除 5 小时短窗口外，还受 7 天周期的周度配额约束。若周初高强度运行 Claude Code 多文件重构，建议用下方每周额度规划器计算每日安全消耗预算，防止周中提前触顶。',
      },
      {
        title: '区分全网全局重置与特定范围调整',
        body: '本页记录的「全局重置」指来源标注面向全部用户的重置事件；「指定范围重置」与「重置卡」仅适用于原帖说明的特定套餐或受影响用户，不代表你的个人账号已自动清零。',
      },
    ],
    guidePointsEn: [
      {
        title: 'The 5-hour rolling window starts from your first message in the session',
        body: 'When Claude displays a usage limit message, your recovery time is 5 hours after the first message that opened the current window—not 5 hours after you hit the cap. Enter your known window start below to calculate the assumed end time.',
      },
      {
        title: '7-day weekly limits operate alongside 5-hour windows',
        body: 'Claude Pro and Max accounts enforce both a 5-hour session cap and a 7-day rolling weekly budget. Heavy Claude Code refactoring early in the week can exhaust weekly quota ahead of schedule; use the weekly planner below to set a safe daily burn rate.',
      },
      {
        title: 'Distinguish global resets from scoped events and bonus cards',
        body: 'Only events explicitly marked for all users count as global resets on this page. Scoped resets and bonus cards apply only to the plans or users described in the linked source post.',
      },
    ],
    faqZh: [
      {
        q: 'Claude 提示达到 5 小时限制后，什么时候恢复额度？',
        a: 'Claude 的 5 小时限额按当前窗口的第一条请求时间起算，满 5 小时后重置该窗口。触顶报错时刻不等于窗口起点，请以客户端或网页设置内显示的重置时间为准，或用本页计算器按已知起点加 5 小时估算。',
      },
      {
        q: 'Claude Code 周限额用完后，全网重置记录代表我的账号恢复了吗？',
        a: '不一定。本页展示的是 WhenReset.dev 收录的公开事件记录，仅在官方执行全网重置时影响所有用户。常规情况下，个人周度限额需等待你账号自身的 7 天重置周期结束。',
      },
      {
        q: '如何避免 Claude Pro / Max 每周额度在周中提前耗尽？',
        a: '在客户端查看当前已消耗百分比与下次重置时间，填入本页的「每周额度规划计算器」，系统会自动算出距离重置的剩余小时数与建议每日消耗上限（如每天不超过 14%）。',
      },
    ],
    faqEn: [
      {
        q: 'When does my Claude quota recover after hitting the 5-hour limit?',
        a: 'Claude 5-hour windows reset 5 hours after the first message that started the active window, not 5 hours after the rate-limit message appeared. Check the exact reset timestamp inside your client or use the 5-hour calculator with a known start time.',
      },
      {
        q: 'Does a recorded Claude event mean my personal Claude Code weekly limit was reset?',
        a: 'Not necessarily. Records on this page reflect public events tracked by WhenReset.dev. Unless an event is a confirmed all-user global reset, your personal weekly quota follows the reset schedule shown in your account settings.',
      },
      {
        q: 'How can I prevent exhausting my Claude Pro or Max weekly quota mid-week?',
        a: 'Enter your current percentage used and next personal reset time into the Weekly Quota Planner on this page to compute your current burn pace and a safe daily percentage budget.',
      },
    ],
  },
  codex: {
    titleZh: 'OpenAI Codex 额度重置雷达与发卡记录查询 (ChatGPT Plus / Pro) | T Salon',
    titleEn: 'OpenAI Codex Quota Reset Radar & Bonus Card Tracker (ChatGPT Plus / Pro) | T Salon',
    descZh: '实时追踪 OpenAI Codex 全局额度重置、指定范围重置与官方发卡（Reset Card）历史记录，提供北京时间换算、历史间隔参考与周度配额规划工具。',
    descEn: 'Live tracker for OpenAI Codex global quota resets, scoped resets, and bonus reset cards from WhenReset.dev, with UTC+8 timestamps, historical cadence reference, and quota calculators.',
    h1Zh: 'OpenAI Codex 额度重置与发卡记录雷达',
    h1En: 'OpenAI Codex Quota Reset & Bonus Card Radar',
    introZh: '实时同步 WhenReset.dev 收录的 OpenAI Codex 全局重置、指定范围重置与重置卡（Reset Card）发放记录，附原始推文出处链接、北京时间换算与配额规划计算器。',
    introEn: 'Monitor OpenAI Codex global resets, scoped resets, and bonus reset card issuances tracked by WhenReset.dev, complete with original source post links, UTC+8 timestamps, and quota pacing calculators.',
    guideTitleZh: 'OpenAI Codex 重置记录、重置卡与额度规划说明',
    guideTitleEn: 'OpenAI Codex Reset Records, Bonus Cards & Pacing Guide',
    guidePointsZh: [
      {
        title: '全局重置（Global Reset）与发重置卡（Reset Card）的区别',
        body: '全局重置指官方对全部用户统一刷新可用配额；重置卡（Card）则是官方在特定活动或补偿中发放的额度卡，需要符合资格的账号按原帖说明领取或核销，不会自动清零所有人的已用额度。',
      },
      {
        title: '历史间隔参考点如何辅助判断节奏',
        body: '系统从已读取的最近最多 10 个不同全局重置时刻中计算相邻间隔中位数（自动剔除重置卡和局部重置），叠加到最近一次全局重置时间上作为历史算术参考，但不代表官方固定排期。',
      },
      {
        title: '高并发任务与长任务的配额节奏控制',
        body: '使用 Codex 跑批量 PR 审查或多仓库任务时，可通过下方每周额度规划器监控消耗斜率，并结合 TokenRank 对照本地实际 Token 消耗与缓存命中率。',
      },
    ],
    guidePointsEn: [
      {
        title: 'Global resets vs. bonus reset cards',
        body: 'A global reset refreshes quota across all users simultaneously, whereas a reset card represents a bonus issuance event that eligible users must claim or apply as described in the source post.',
      },
      {
        title: 'How the historical interval reference is derived',
        body: 'The median interval across up to 10 recent distinct global reset timestamps is added to the latest global reset time. Bonus cards and scoped resets are excluded so they never skew the cadence calculation.',
      },
      {
        title: 'Pacing multi-repo and long-running Codex tasks',
        body: 'When running parallel Codex tasks or automated reviews, use the Weekly Quota Planner below to keep daily usage within budget and check TokenRank to compare local token consumption.',
      },
    ],
    faqZh: [
      {
        q: '为什么看到有人说 Codex 发卡了，我的额度却没有恢复？',
        a: '发卡（重置卡）与全网重置不同。重置卡通常针对特定订阅层级（如 Pro 或 Plus）或需手动领取，具体适用范围与领取方式请点击本页记录表格中的「推文 ↗」查看官方原帖。',
      },
      {
        q: 'Codex 的历史间隔参考点是官方公布的下次重置时间吗？',
        a: '不是。该参考点仅基于已收录的历史全局重置间隔中位数做算术推算，供开发者了解过往频率，个人实际配额恢复时间始终以客户端内显示为准。',
      },
      {
        q: '如何第一时间收到 OpenAI Codex 全局重置或发卡通知？',
        a: '可使用本页下方的 RSS 订阅链接（https://www.tsalon.tech/whenreset/rss.xml），或接入飞书、企业微信 Webhook 与浏览器桌面通知。',
      },
    ],
    faqEn: [
      {
        q: 'Why did my Codex quota not reset when a bonus card event was posted?',
        a: 'Bonus reset cards are separate from all-user global resets. Cards often target specific tiers or require manual redemption; check the linked source post in the table for eligibility details.',
      },
      {
        q: 'Is the Codex historical cadence reference an official schedule?',
        a: 'No. It is an arithmetic reference computed from the median gap between past global resets. Always rely on your Codex client for your personal account reset schedule.',
      },
      {
        q: 'How can I get notified immediately when a new Codex reset or card lands?',
        a: 'Subscribe to our RSS feed, configure a GitHub Actions webhook to Feishu/Slack/Discord using /api/reset/data, or enable browser desktop notifications at the bottom of this page.',
      },
    ],
  },
  grok: {
    titleZh: 'xAI Grok 额度重置时间与配额监控雷达 (SuperGrok / Grok) | T Salon',
    titleEn: 'xAI Grok Quota Reset Tracker & Usage Pacing Calculator (SuperGrok) | T Salon',
    descZh: '实时监控 xAI Grok 与 SuperGrok 全网额度重置、指定范围重置与发卡事件记录，提供 5 小时窗口时间计算器与每周配额消耗规划工具。',
    descEn: 'Monitor xAI Grok and SuperGrok quota reset events and bonus cards from WhenReset.dev, with a 5-hour rolling window calculator and weekly quota pacing planner.',
    h1Zh: 'xAI Grok 额度重置监控与配额规划雷达',
    h1En: 'xAI Grok Quota Reset Tracker & Pacing Radar',
    introZh: '实时读取 WhenReset.dev 收录的 xAI Grok 重置与发卡记录，提供北京时间换算、原帖追踪、5 小时滑动窗口计算器以及每周额度规划工具。',
    introEn: 'Real-time WhenReset.dev event tracker for xAI Grok resets and bonus cards, complete with UTC+8 timestamps, source post links, a 5-hour window calculator, and weekly quota pacing tools.',
    guideTitleZh: 'xAI Grok 配额监控与滑动窗口计算说明',
    guideTitleEn: 'xAI Grok Quota Monitoring & Window Calculation Guide',
    guidePointsZh: [
      {
        title: '追踪官方全局重置与服务恢复补偿',
        body: '当 xAI 发布模型更新或完成服务恢复时，可能会触发全局或特定范围的配额重置。本页实时同步 WhenReset.dev 验证过的事件记录并保留原帖链接。',
      },
      {
        title: '5 小时窗口与周度消耗双维度推算',
        body: '针对高频深度推理与长上下文调用，可结合下方 5 小时窗口计算器（按已知窗口起点推算）与周度规划器，合理分配每日调用预算。',
      },
    ],
    guidePointsEn: [
      {
        title: 'Track global resets and service recovery notices',
        body: 'When xAI rolls out model updates or recovers from service incidents, global or scoped quota resets may occur. This page syncs verified WhenReset.dev records with direct links to original posts.',
      },
      {
        title: 'Combine 5-hour window and weekly pacing calculations',
        body: 'For intensive reasoning and long-context workflows, use both the 5-hour window calculator (from your known window start) and the weekly quota planner to keep daily consumption steady.',
      },
    ],
    faqZh: [
      {
        q: 'Grok 额度重置记录的数据来源是什么？',
        a: '本页在请求时读取 WhenReset.dev 公开记录接口（缓存 5 分钟），每条事件均附带触发原因、适用范围与官方或技术负责人的原帖链接。',
      },
      {
        q: '如何用计算器推算 Grok 窗口恢复时间？',
        a: '在「五小时窗口时间计算器」中输入已知的窗口起始时刻（非触顶报错时刻），即可换算假设 5 小时窗口结束的北京时间；个人实际限额请以 Grok 客户端内显示为准。',
      },
    ],
    faqEn: [
      {
        q: 'Where do the xAI Grok reset records come from?',
        a: 'T Salon reads the WhenReset.dev records API on request with a 5-minute cache. Every record displays its documented scope, reason, and original source post link.',
      },
      {
        q: 'How do I estimate Grok window recovery time?',
        a: 'Enter your known window start timestamp (not the moment you hit the rate limit) into the Five-Hour Window Calculator below to compute the assumed 5-hour window end in UTC+8.',
      },
    ],
  },
};

const meta = metaByProvider[provider];
const pagePath = isEn ? `/en/whenreset/${provider}/` : `/whenreset/${provider}/`;
const altPath = isEn ? `/whenreset/${provider}/` : `/en/whenreset/${provider}/`;
const hubPath = isEn ? '/en/whenreset/' : '/whenreset/';
const guidePath = isEn ? '/en/articles/ai-quota-reset-radar-guide/' : '/articles/ai-quota-reset-radar-guide/';
const pageUrl = new URL(pagePath, Astro.site).toString();
const faqList = isEn ? meta.faqEn : meta.faqZh;
const guidePoints = isEn ? meta.guidePointsEn : meta.guidePointsZh;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: isEn ? meta.h1En : meta.h1Zh,
    url: pageUrl,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Web',
    description: isEn ? meta.descEn : meta.descZh,
    publisher: { '@type': 'Organization', name: 'T Salon', url: 'https://www.tsalon.tech/' },
    inLanguage: isEn ? 'en-US' : 'zh-CN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: isEn ? 'Home' : '首页', item: new URL(isEn ? '/en/' : '/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: isEn ? 'Reset Radar' : '重置雷达', item: new URL(hubPath, Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: pData.name, item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    url: pageUrl,
    inLanguage: isEn ? 'en-US' : 'zh-CN',
    mainEntity: faqList.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: stripTags(item.a) },
    })),
  },
];
---

<BaseLayout
  title={isEn ? meta.titleEn : meta.titleZh}
  description={isEn ? meta.descEn : meta.descZh}
  alternatePath={altPath}
  locale={locale}
  jsonLd={jsonLd}
>
  <main class="reset-page">
    <div class="container">
      <nav class="reset-breadcrumb" aria-label={isEn ? 'Breadcrumb' : '面包屑'}>
        <a href={isEn ? '/en/' : '/'}>{isEn ? 'Home' : '首页'}</a>
        <span aria-hidden="true">/</span>
        <a href={hubPath}>{isEn ? 'Reset Radar' : '重置雷达'}</a>
        <span aria-hidden="true">/</span>
        <span>{pData.name}</span>
      </nav>

      <section class="reset-hero">
        <div class="hero-top-badge">
          <span class:list={['pulse-dot', { unavailable: status === 'unavailable' }]}></span>
          <span>
            {isEn
              ? (status === 'unavailable' ? 'WhenReset.dev records currently unavailable' : status === 'empty' ? 'No records available from WhenReset.dev' : 'WhenReset.dev Event Records')
              : (status === 'unavailable' ? '暂时无法读取 WhenReset.dev 记录' : status === 'empty' ? 'WhenReset.dev 暂无可用记录' : 'WhenReset.dev 事件记录')}
            {updatedAtBeijing && (isEn ? ` · Read at ${updatedAtBeijing} (UTC+8)` : ` · 北京时间 ${updatedAtBeijing} 读取`)}
          </span>
        </div>
        <h1 class="hero-title">{isEn ? meta.h1En : meta.h1Zh}</h1>
        <p class="hero-desc">{isEn ? meta.introEn : meta.introZh}</p>

        <nav class="provider-tabs" aria-label={isEn ? 'Select model provider' : '选择模型平台'}>
          <a href={hubPath} class="tab-btn">
            <span class="tab-name">{isEn ? 'All Models Overview' : '全部模型总览'}</span>
          </a>
          <a href={isEn ? '/en/whenreset/codex/' : '/whenreset/codex/'} class:list={['tab-btn', { active: provider === 'codex' }]} aria-current={provider === 'codex' ? 'page' : undefined}>
            <span class="tab-icon">⚡️</span>
            <span class="tab-name">OpenAI Codex</span>
          </a>
          <a href={isEn ? '/en/whenreset/claude/' : '/whenreset/claude/'} class:list={['tab-btn', { active: provider === 'claude' }]} aria-current={provider === 'claude' ? 'page' : undefined}>
            <span class="tab-icon">🧠</span>
            <span class="tab-name">Anthropic Claude</span>
          </a>
          <a href={isEn ? '/en/whenreset/grok/' : '/whenreset/grok/'} class:list={['tab-btn', { active: provider === 'grok' }]} aria-current={provider === 'grok' ? 'page' : undefined}>
            <span class="tab-icon">🚀</span>
            <span class="tab-name">xAI Grok</span>
          </a>
        </nav>
      </section>

      <div class="provider-section active">
        {pData.watchNotice?.isOpen && (
          <div class="alert-banner">
            <div class="alert-icon">🚨</div>
            <div class="alert-content">
              <div class="alert-title">{isEn ? (pData.watchNotice.titleEn || 'Notice in the source feed') : (pData.watchNotice.titleZh || '来源中的待发生通知')}</div>
              <p class="alert-text">{pData.watchNotice.text}</p>
              {pData.watchNotice.scheduledAtBeijing && (
                <div class="alert-meta">{isEn ? `Scheduled in the source: ${pData.watchNotice.scheduledAtBeijing} (UTC+8)` : `来源所列时间：北京时间 ${pData.watchNotice.scheduledAtBeijing}`}</div>
              )}
            </div>
            {pData.watchNotice.tweetUrl && (
              <a href={pData.watchNotice.tweetUrl} target="_blank" rel="noreferrer" class="btn btn-dark alert-btn">
                {isEn ? 'Source Post' : '查看来源原帖'} <span>↗</span>
              </a>
            )}
          </div>
        )}

        <div class="stats-bento">
          <div class="bento-card">
            <div class="card-label">{isEn ? 'Latest Event' : '最近一条事件'}</div>
            <div class="card-value highlight">{isEn ? (pData.latestEvent?.typeLabelEn || 'No records') : (pData.latestEvent?.typeLabelZh || '暂无记录')}</div>
            <div class="card-sub">{isEn ? (pData.latestEvent?.timeAgoEn || '—') : (pData.latestEvent?.timeAgoZh || '—')}</div>
            <div class="card-sub">{isEn ? `Scope: ${pData.latestEvent?.scopeEn || 'Not specified'}` : `适用范围：${pData.latestEvent?.scopeZh || '未说明'}`}</div>
          </div>
          <div class="bento-card">
            <div class="card-label">{isEn ? 'Event Time (UTC+8)' : '该事件时间（北京时间）'}</div>
            <div class="card-value">{pData.latestEvent?.landedAtBeijing || '—'}</div>
            <div class="card-sub">{isEn ? `Reason: ${pData.latestEvent?.reasonEn || 'Not specified in this record'}` : `原因：${pData.latestEvent?.reasonZh || '该记录未说明'}`}</div>
            {pData.latestEvent?.postUrl && (
              <a href={pData.latestEvent.postUrl} target="_blank" rel="noreferrer" class="card-link">{isEn ? 'Source post ↗' : '该事件原帖 ↗'}</a>
            )}
          </div>
          <div class="bento-card">
            <div class="card-label">{isEn ? 'Historical Cadence Reference' : '历史间隔参考点'}</div>
            <div class="card-value">{pData.nextEstimated.dateBeijing} <span class="time-sub">{pData.nextEstimated.timeBeijing}</span></div>
            <div class="card-sub">{isEn ? pData.nextEstimated.relativeTextEn : pData.nextEstimated.relativeTextZh}</div>
            <div class="card-hint">{isEn ? `Based on ${pData.cadenceIntervalCount} global reset intervals; not an official schedule` : `基于 ${pData.cadenceIntervalCount} 个全局重置间隔，不是官方排期`}</div>
