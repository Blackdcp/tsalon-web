---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { localeFromPath, localizedPath, type SiteLocale } from '../lib/i18n';
import '../../assets/pages.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  locale?: SiteLocale;
  alternatePath?: string | null;
  autoDetectLocale?: boolean;
  keywords?: string;
}

const {
  title,
  description,
  image = '/icon-512x512.png',
  noindex = false,
  jsonLd,
  locale = localeFromPath(Astro.url.pathname),
  alternatePath,
  autoDetectLocale = false,
  keywords = locale === 'zh'
    ? 'T Salon, 开发者社区, 技术沙龙, Apple 开发者, iOS 研发, AI Agent, 具身智能, TokenRank, WhenReset, 软件工程'
    : 'T Salon, developer community, tech salon, Apple developers, iOS engineering, AI agents, embodied intelligence, TokenRank, WhenReset, software engineering',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
const resolvedAlternatePath = alternatePath === null ? undefined : (alternatePath ?? localizedPath(Astro.url.pathname, locale === 'zh' ? 'en' : 'zh'));
const alternate = resolvedAlternatePath ? new URL(resolvedAlternatePath, Astro.site) : undefined;
const zhUrl = locale === 'zh' ? canonical : alternate;
const enUrl = locale === 'en' ? canonical : alternate;
---
<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'} data-locale={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="baidu-site-verification" content="codeva-V09RTo12fc" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={locale === 'zh' ? 'T Salon 内容订阅' : 'T Salon content feed'}
      href={locale === 'zh' ? '/rss.xml' : '/en/rss.xml'}
    />
    <link
      rel="alternate"
      type="text/plain"
      title={locale === 'zh' ? 'T Salon LLMs 入口' : 'T Salon LLMs Entry'}
      href={locale === 'zh' ? '/llms.txt' : '/en/llms.txt'}
    />
    <link
      rel="alternate"
      type="text/plain"
      title={locale === 'zh' ? 'T Salon LLMs 全文' : 'T Salon LLMs Full Text'}
      href={locale === 'zh' ? '/llms-full.txt' : '/en/llms-full.txt'}
    />
    <link rel="help" href={locale === 'zh' ? '/llms.txt' : '/en/llms.txt'} />
    {alternate && zhUrl && <link rel="alternate" hreflang="zh-Hans" href={zhUrl} />}
    {alternate && enUrl && <link rel="alternate" hreflang="en" href={enUrl} />}
    {alternate && zhUrl && <link rel="alternate" hreflang="x-default" href={zhUrl} />}
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="T Salon" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_US'} />
    {alternate && <meta property="og:locale:alternate" content={locale === 'zh' ? 'en_US' : 'zh_CN'} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#main-content">{locale === 'zh' ? '跳到主要内容' : 'Skip to main content'}</a>
    <Header locale={locale} alternatePath={resolvedAlternatePath} hasTranslation={Boolean(resolvedAlternatePath)} />
    <div id="main-content" tabindex="-1"><slot /></div>
    <Footer locale={locale} />
    <script is:inline define:vars={{ autoDetectLocale, locale }}>
      (() => {
        const preferenceKey = 'tsalon-locale';
        const readPreference = () => {
          try { return localStorage.getItem(preferenceKey); } catch { return null; }
        };
        const writePreference = (value) => {
          try { localStorage.setItem(preferenceKey, value); } catch { /* Storage can be unavailable in embedded WebViews. */ }
        };
        document.querySelectorAll('[data-locale-choice]').forEach((link) => {
          link.addEventListener('click', () => writePreference(link.dataset.localeChoice));
        });
        if (!autoDetectLocale || locale !== 'zh' || readPreference()) return;
        const preferred = (navigator.languages?.[0] || navigator.language || '').toLowerCase();
        if (preferred.startsWith('en')) location.replace('/en/');
      })();
    </script>
  </body>
</html>
