---
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { topicSlugFor } from '../../lib/topics';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  const talks = await getCollection('talks');
  return [
    ...articles.map((article) => ({ params: { id: article.id }, props: { kind: 'article' as const, article } })),
    ...talks.map((talk) => ({ params: { id: talk.id }, props: { kind: 'talk' as const, talk } })),
  ];
}

type Props =
  | { kind: 'article'; article: CollectionEntry<'articles'> }
  | { kind: 'talk'; talk: CollectionEntry<'talks'> };

type NavigationEntry = {
  id: string;
  title: string;
  label: string;
};

const props = Astro.props as Props;
const isTalk = props.kind === 'talk';
const talk = isTalk ? props.talk : undefined;
const article = !isTalk ? props.article : undefined;

let ArticleContent: any;
let headings: { depth: number; slug: string; text: string }[] = [];
let author: CollectionEntry<'people'> | undefined;
if (article) {
  const rendered = await render(article);
  ArticleContent = rendered.Content;
  headings = rendered.headings;
  author = await getEntry(article.data.author);
  if (!author) throw new Error(`Missing author for ${article.id}`);
}

const articleTypeLabels: Record<string, string> = {
  news: '社区动态',
  insight: '行业观察',
  interview: '人物采访',
  'field-note': '活动回顾',
  guide: '嘉宾观点',
  archive: '社区档案',
};

const publishedArticles = (await getCollection('articles', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime(),
);
const publishedTalks = (await getCollection('talks')).sort((a, b) => b.data.order - a.data.order);
const navigationEntries: NavigationEntry[] = isTalk
  ? publishedTalks.map((entry) => ({ id: entry.id, title: entry.data.title, label: `T Chat / ${String(entry.data.episode).padStart(2, '0')}` }))
  : publishedArticles.map((entry) => ({ id: entry.id, title: entry.data.title, label: articleTypeLabels[entry.data.type] ?? '文章' }));
const currentId = talk?.id ?? article!.id;
const currentIndex = navigationEntries.findIndex((entry) => entry.id === currentId);
const previousEntry = currentIndex > 0 ? navigationEntries[currentIndex - 1] : undefined;
const nextEntry = currentIndex >= 0 && currentIndex < navigationEntries.length - 1 ? navigationEntries[currentIndex + 1] : undefined;

const contentKind = talk ? '人物访谈' : articleTypeLabels[article!.data.type] ?? '文章';
const title = talk?.data.title ?? article!.data.title;
const summary = talk?.data.summary ?? article!.data.summary;
const cover = talk?.data.cover ?? article!.data.cover;
const coverAlt = talk?.data.coverAlt ?? article!.data.coverAlt;
const topics = talk?.data.topics ?? article!.data.topics;
const pageUrl = new URL(`/articles/${currentId}/`, Astro.site).toString();

const bvidMatch = talk?.data.videoUrl?.match(/BV[a-zA-Z0-9]+/);
const bvid = bvidMatch ? bvidMatch[0] : null;

const durationLabel = (seconds: number) => `${Math.floor(seconds / 60)}分${String(seconds % 60).padStart(2, '0')}秒`;
const relatedRecaps = talk ? publishedArticles.filter(entry => entry.data.relatedTalks.some(ref => ref.id === talk.id)) : [];
const recapDetails = await Promise.all(
  relatedRecaps.map(async (recap) => {
    const renderedRecap = await render(recap);
    return {
      recap,
      headings: renderedRecap.headings.filter((h) => h.depth === 2),
    };
  }),
);
const relatedTalks = article ? publishedTalks.filter(entry => article.data.relatedTalks.some(ref => ref.id === entry.id)) : [];
const relatedRecordings = article ? (await getCollection('recordings')).filter(entry => article.data.relatedRecordings.some(ref => ref.id === entry.id)) : [];

const currentTopicSlugs = new Set((topics ?? []).map((t: string) => topicSlugFor(t)).filter(Boolean));
const relatedByTopic = publishedArticles
  .filter((entry) => entry.id !== currentId && !relatedRecaps.some((r) => r.id === entry.id))
  .map((entry) => {
    const entrySlugs = new Set(entry.data.topics.map((t) => topicSlugFor(t)).filter(Boolean));
    let shared = 0;
    for (const s of currentTopicSlugs) {
      if (entrySlugs.has(s)) shared += 1;
    }
    const sameType = article && entry.data.type === article.data.type ? 0.5 : 0;
    return { entry, score: shared + sameType };
  })
  .filter((item) => item.score >= 1)
  .sort((a, b) => b.score - a.score || b.entry.data.publishedAt.getTime() - a.entry.data.publishedAt.getTime())
  .slice(0, 3)
  .map((item) => item.entry);

const verifiedGuests = article
  ? [
      ...new Set([
        ...relatedTalks.map((t) => t.data.speaker),
        ...relatedRecordings.flatMap((r) => r.data.guests),
      ].filter((name) => name && name !== 'T Salon')),
    ]
  : [];

const resolvedArticleImage = article && article.data.cover !== '/images/default-cover.svg'
  ? article.data.cover
  : '/images/share-logo.jpg';

const primaryPart = talk?.data.videoParts[0];
const jsonLd = talk && primaryPart ? [{
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: `${talk.data.speaker}：${talk.data.title}`,
  description: talk.data.summary,
  thumbnailUrl: [
    new URL(talk.data.cover, Astro.site).toString(),
    new URL('/images/share-logo.jpg', Astro.site).toString(),
  ],
  embedUrl: `https://player.bilibili.com/player.html?bvid=${bvid || primaryPart.url.match(/BV[a-zA-Z0-9]+/)?.[0]}&page=1&high_quality=1&danmaku=0`,
  contentUrl: primaryPart.url,
  url: pageUrl,
  mainEntityOfPage: pageUrl,
  uploadDate: primaryPart.uploadedAt,
  duration: `PT${primaryPart.durationSeconds}S`,
  publisher: { '@type': 'Organization', name: 'T Salon', url: 'https://www.tsalon.tech/' },
  author: { '@type': 'Person', name: talk.data.speaker, url: 'https://www.tsalon.tech/about/' },
  about: talk.data.topics,
  inLanguage: 'zh-CN',
}] : {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article!.data.title,
  description: article!.data.summary,
  datePublished: article!.data.publishedAt.toISOString(),
  dateModified: (article!.data.updatedAt ?? article!.data.publishedAt).toISOString(),
  url: pageUrl,
  image: new URL(resolvedArticleImage, Astro.site).toString(),
  author: {
    '@type': 'Organization',
    name: author!.data.name,
    description: author!.data.bio,
    url: new URL('/about/', Astro.site).toString(),
    ...(author!.data.links?.github ? { sameAs: [author!.data.links.github] } : {}),
  },
  ...(verifiedGuests.length > 0
    ? { contributor: verifiedGuests.map((guestName) => ({ '@type': 'Person', name: guestName })) }
    : {}),
  publisher: { '@type': 'Organization', name: 'T Salon', url: 'https://www.tsalon.tech/' },
  inLanguage: 'zh-CN',
  about: article!.data.topics,
  citation: article!.data.citations.map((source) => ({ '@type': 'CreativeWork', name: source.label, url: source.url })),
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: '内容', item: new URL('/articles/', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
  ],
};

const activeFaq = (talk ? talk.data.faq : article?.data.faq) ?? [];
const faqJsonLd = activeFaq.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      inLanguage: 'zh-CN',
      mainEntity: activeFaq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    }
  : null;
const pageJsonLd = [...(Array.isArray(jsonLd) ? jsonLd : [jsonLd]), breadcrumbJsonLd, ...(faqJsonLd ? [faqJsonLd] : [])];

const pageTitle = talk ? `${talk.data.title}｜T Chat 第 ${talk.data.episode} 期 — T Salon` : article!.data.seo.title;
const pageDescription = talk
  ? `T Chat 第 ${talk.data.episode} 期原视频回看与分段目录。${talk.data.summary}`
  : article!.data.seo.description;
const translation = article ? (await getCollection('articlesEn', ({ data }) => !data.draft)).find((entry) => entry.data.translationOf === article.id) : undefined;
---

<BaseLayout alternatePath={translation ? `/en/articles/${translation.id}/` : null} title={pageTitle} description={pageDescription} image={cover} noindex={article?.data.seo.noindex ?? false} jsonLd={pageJsonLd}>
  <main class="content-detail-page">
    <nav class="content-detail-shell content-detail-breadcrumb" aria-label="面包屑">
      <a href="/articles/">内容</a><span aria-hidden="true">/</span><span>{contentKind}</span>
    </nav>

    <header class="content-detail-shell content-detail-header">
      <div class="content-detail-kicker">
        <p class="eyebrow">{talk ? `T CHAT / EPISODE ${String(talk.data.episode).padStart(2, '0')}` : `${contentKind} / T SALON`}</p>
        <span class="mono">{talk ? '对谈' : '编辑内容'}</span>
      </div>
      <h1>{title}</h1>
      <p class="content-detail-summary">{summary}</p>
      <div class="content-detail-byline">
        <span class="content-detail-avatar" aria-hidden="true">{talk ? String(talk.data.episode).padStart(2, '0') : 'TS'}</span>
        <div>
          <strong>{talk ? talk.data.speaker : author!.data.name}</strong>
          <span>{talk ? `「我在大厂做研发」· T Salon` : `${article!.data.publishedAt.toISOString().slice(0, 10)} · ${article!.data.readingMinutes} 分钟阅读`}</span>
          {article?.data.updatedAt && <span>修订于 {article.data.updatedAt.toISOString().slice(0, 10)}</span>}
        </div>
      </div>
    </header>

    {!talk && cover !== '/images/default-cover.svg' && <figure class="content-detail-shell content-detail-cover">
      <div><img src={cover} alt={coverAlt} /></div>
      <figcaption class="mono">{coverAlt}</figcaption>
    </figure>}

    <section class="content-detail-shell content-detail-body">
      <article class="prose content-detail-prose">
        {talk ? (
          <>
            <h2 id="videos">视频回看</h2>
            {bvid && (
              <div class="talk-video-embed">
                <iframe
                  src={`https://player.bilibili.com/player.html?bvid=${bvid}&page=1&high_quality=1&danmaku=0`}
                  allowfullscreen
                  title={talk.data.title}
                ></iframe>
              </div>
            )}
            <p>按原视频分段观看主题分享与对谈。下面标注的是 B 站稿件发布日期；同一稿件下各分 P 共用该日期，不代表各分 P 的独立上传时间。</p>
            <ol class="video-parts">
              {talk.data.videoParts.map((part) => <li>
                <a href={part.url} target="_blank" rel="noopener noreferrer">{part.title} ↗</a>
                <p>{durationLabel(part.durationSeconds)} · 稿件发布于 <time datetime={part.uploadedAt}>{part.uploadedAt.slice(0, 10)}</time></p>
              </li>)}
            </ol>

            {recapDetails.length > 0 && (
              <section class="talk-recap-highlight" aria-label="文字回顾">
                <h2>文字回顾与章节导读</h2>
                {recapDetails.map(({ recap, headings: recapH2s }) => (
                  <div class="talk-recap-card">
                    <h3><a href={`/articles/${recap.id}/`}>{recap.data.title} →</a></h3>
                    <p>{recap.data.summary}</p>
                    {recap.data.tldr.length > 0 && (
                      <ul>
                        {recap.data.tldr.map((pt) => <li>{pt}</li>)}
                      </ul>
                    )}
                    {recapH2s.length > 0 && (
                      <div class="talk-recap-chapters">
                        <span class="mono">章节导航：</span>
                        {recapH2s.map((h) => (
                          <a href={`/articles/${recap.id}/#${h.slug}`}>{h.text}</a>
                        ))}
                      </div>
                    )}
                  </div>
                ))}
              </section>
            )}

            {talk.data.takeaways && talk.data.takeaways.length > 0 && (
              <section class="article-tldr" aria-label="核心实践看点">
                <p class="mono">核心实践看点 · KEY TAKEAWAYS</p>
                <ul>
                  {talk.data.takeaways.map((point: string) => <li>{point}</li>)}
                </ul>
              </section>
            )}

            {talk.data.faq && talk.data.faq.length > 0 && (
              <section class="article-faq" aria-label="讨论看点与常见问答">
                <h2>讨论看点与常见问答（FAQ）</h2>
                <dl>
                  {talk.data.faq.map((item: { question: string; answer: string }) => (
                    <>
                      <dt>{item.question}</dt>
                      <dd>{item.answer}</dd>
                    </>
                  ))}
                </dl>
              </section>
            )}

            <h2>本期讨论主题</h2>
            <ul>{talk.data.topics.map((topic: string) => <li>{topic}</li>)}</ul>
            <h2>关于「我在大厂做研发」</h2>
            <p>T Chat 由 T Salon 与老司机周报共同发起，通过主题分享与一对一交流，记录一线互联网研发团队与工程师的真实实践。本目录目前收录 {publishedTalks.length} 期原视频。</p>
          </>
        ) : (
          <>
            {article!.data.tldr.length > 0 && (
              <section class="article-tldr" aria-label="TL;DR">
                <p class="mono">TL;DR</p>
                <ul>{article!.data.tldr.map((point) => <li>{point}</li>)}</ul>
              </section>
            )}
            <ArticleContent />
            {relatedTalks.map(related => <><p><a href={`/articles/${related.id}/`}>查看本期原视频与分段信息：{related.data.title} →</a></p></>)}
            {relatedRecordings.map(related => <p><a href={`/recordings/${related.id}/`}>查看原视频与分段信息：{related.data.title} →</a></p>)}
            {article!.data.faq.length > 0 && (
              <section class="article-faq" aria-label="常见问题">
                <h2>常见问题（FAQ）</h2>
                <dl>
                  {article!.data.faq.map((item) => (
                    <>
                      <dt>{item.question}</dt>
                      <dd>{item.answer}</dd>
                    </>
                  ))}
                </dl>
              </section>
            )}
          </>
        )}
        <div style="margin: 2rem 0 1.25rem; padding: 1.1rem 1.25rem; border: 1px solid var(--border-default, #e2e8f0); border-radius: 10px; background: #f8fafc;">
          <strong class="mono" style="font-size: 0.78rem; color: #c2410c; display: block; margin-bottom: 0.45rem;">⚡ T SALON 开发者工具箱</strong>
          <div style="display: flex; flex-wrap: wrap; gap: 0.65rem 1.25rem; font-size: 0.9rem;">
            <a href="/whenreset/">WhenReset 额度重置雷达 →</a>
            <a href="/calculator/">AI 编程成本与缓存计算器 →</a>
            <a href="/errors/">限流与报错速查库 →</a>
            <a href="/reports/">2026 AI 编程消耗基准报告 →</a>
            <a href="/tokenrank/">TokenRank 排行榜 →</a>
          </div>
        </div>
        <footer class="content-detail-tags">
          <span class="mono">主题</span>
          <div class="tag-list">
            {topics.map((topic) => {
              const slug = topicSlugFor(topic);
              return slug ? (
                <a href={`/topics/${slug}/`} class="tag tag-link">{topic}</a>
              ) : (
                <span class="tag">{topic}</span>
              );
            })}
          </div>
        </footer>
      </article>

      <aside class="content-detail-aside">
        {article && headings.some((heading) => heading.depth === 2) && (
          <div class="content-detail-aside-section">
            <strong class="mono">本文目录</strong>
            <nav aria-label="本文目录">
              {headings.filter((heading) => heading.depth === 2).map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}
            </nav>
          </div>
        )}

        <div class="content-detail-aside-section">
          <strong class="mono">{talk ? '本期信息' : '文章信息'}</strong>
          <dl>
            <div><dt>类型</dt><dd>{contentKind}</dd></div>
            {talk ? (
              <>
                <div><dt>期数</dt><dd>{String(talk.data.episode).padStart(2, '0')} / 17</dd></div>
                <div><dt>嘉宾</dt><dd>{talk.data.speaker}</dd></div>
              </>
            ) : (
              <>
                <div><dt>作者</dt><dd>{author!.data.name}</dd></div>
                <div><dt>发布时间</dt><dd>{article!.data.publishedAt.toISOString().slice(0, 10)}</dd></div>
              </>
            )}
          </dl>
        </div>

        {talk && <a class="content-detail-source" href="#videos">查看全部视频分段 <span>↓</span></a>}
        {article && article.data.citations.map((citation) => <a class="content-detail-source" href={citation.url} target="_blank" rel="noreferrer">{citation.label} <span>↗</span></a>)}
      </aside>
    </section>

    {talk && (
      <aside class="content-detail-shell content-series-note">
        <div><p class="mono">T CHAT / 系列</p><h2>继续浏览「我在大厂做研发」</h2></div>
        <p>从第 1 期到第 17 期，查看完整嘉宾与主题目录。</p>
        <a href="/events/series/t-chat/">打开系列 <span aria-hidden="true">→</span></a>
      </aside>
    )}

    {relatedByTopic.length > 0 && (
      <section class="content-detail-shell related-articles-section" aria-label="相关阅读">
        <header class="related-articles-head">
          <p class="mono">RELATED / 同主题延伸</p>
          <h2>相关阅读</h2>
        </header>
        <div class="related-articles-grid">
          {relatedByTopic.map((rel) => (
            <a class="related-article-card" href={`/articles/${rel.id}/`}>
              <span class="mono">{articleTypeLabels[rel.data.type] ?? '文章'} · {rel.data.publishedAt.toISOString().slice(0, 10)}</span>
              <h3>{rel.data.title}</h3>
              <p>{rel.data.summary}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <nav class="content-pagination" aria-label="上一篇和下一篇">
      <div class="content-pagination-inner content-detail-shell">
        {previousEntry ? (
          <a class="content-pagination-item content-pagination-previous" href={`/articles/${previousEntry.id}/`}>
            <span>← 上一篇 · {previousEntry.label}</span><strong>{previousEntry.title}</strong>
          </a>
        ) : <span class="content-pagination-item is-empty" aria-hidden="true"></span>}
        <a class="content-pagination-back" href="/articles/">全部内容</a>
        {nextEntry ? (
          <a class="content-pagination-item content-pagination-next" href={`/articles/${nextEntry.id}/`}>
            <span>下一篇 · {nextEntry.label} →</span><strong>{nextEntry.title}</strong>
          </a>
        ) : <span class="content-pagination-item is-empty" aria-hidden="true"></span>}
      </div>
    </nav>
  </main>
</BaseLayout>

<style>
  .article-tldr {
    margin: 0 0 2rem;
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--accent, #2b6cb0);
    background: color-mix(in srgb, var(--accent, #2b6cb0) 8%, transparent);
    border-radius: 0 8px 8px 0;
  }
  .article-tldr .mono {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.7;
    margin: 0 0 0.5rem;
  }
  .article-tldr ul { margin: 0; padding-left: 1.1rem; }
  .article-tldr li { margin: 0.35rem 0; }
  .article-faq {
    margin: 2.5rem 0 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, currentColor 12%, transparent);
  }
  .article-faq h2 { font-size: 1.25rem; }
  .article-faq dl { margin: 0; }
  .article-faq dt { font-weight: 600; margin-top: 1rem; }
  .article-faq dd { margin: 0.25rem 0 0; opacity: 0.92; }
  .talk-video-embed {
    margin: 1.5rem 0 2rem;
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 8px;
    overflow: hidden;
    background: #000;
  }
  .talk-video-embed iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tag {
    display: inline-block;
    padding: 0.25rem 0.65rem;
    font-size: 0.8125rem;
    line-height: 1.4;
    border-radius: 4px;
    background: color-mix(in srgb, currentColor 8%, transparent);
    color: inherit;
  }
  .tag-link {
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    border: 1px solid transparent;
  }
  .tag-link:hover {
    background: color-mix(in srgb, var(--accent, #2b6cb0) 15%, transparent);
    color: var(--accent, #2b6cb0);
    border-color: color-mix(in srgb, var(--accent, #2b6cb0) 30%, transparent);
  }
  .talk-recap-highlight {
    margin: 0 0 2rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--border-default);
    background: var(--background-subtle);
  }
  .talk-recap-card h3 {
    margin: 0.5rem 0;
    font-size: 1.15rem;
  }
  .talk-recap-chapters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.85rem;
    margin-top: 0.75rem;
    font-size: 0.85rem;
  }
  .related-articles-section {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-default);
  }
  .related-articles-head {
    margin-bottom: 1.25rem;
  }
  .related-articles-head h2 {
    margin: 0.25rem 0 0;
    font-size: 1.35rem;
  }
  .related-articles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 1.25rem;
  }
  .related-article-card {
    display: block;
    padding: 1.25rem;
    border: 1px solid var(--border-default);
    background: #fff;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease;
  }
  .related-article-card:hover {
    border-color: var(--color-ink-950);
  }
  .related-article-card h3 {
    margin: 0.5rem 0;
    font-size: 1.05rem;
    line-height: 1.4;
  }
  .related-article-card p {
