---
import BaseLayout from '../layouts/BaseLayout.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: '联系我们 — T Salon',
  url: 'https://www.tsalon.tech/contact/',
  description: '联系 T Salon 开发者社区：获取活动报名、嘉宾分享、联合主办与内容合作通道。',
  publisher: {
    '@type': 'Organization',
    name: 'T Salon',
    url: 'https://www.tsalon.tech/',
  },
};
---
<BaseLayout alternatePath="/en/contact/" title="联系我们 — T Salon 开发者社区合作与交流通道" description="联系 T Salon 开发者社区：获取活动报名、嘉宾分享、联合主办与内容合作通道。" jsonLd={jsonLd}>
  <main class="content-detail-page">
    <div class="content-detail-shell" style="padding-top: 2rem; padding-bottom: 4rem;">
      <nav class="content-detail-breadcrumb" aria-label="面包屑">
        <a href="/">首页</a><span aria-hidden="true">/</span><span>联系我们</span>
      </nav>
      <header class="content-detail-header" style="margin-bottom: 2.5rem;">
        <div class="content-detail-kicker"><p class="eyebrow">COMMUNITY & COLLABORATION / T SALON</p><span class="mono">CONTACT</span></div>
        <h1>联系我们</h1>
        <p class="content-detail-summary">无论是参与活动、成为分享嘉宾，还是探讨品牌合作与内容共创，我们始终欢迎真实的技术实践者。</p>
      </header>
      
      <section class="about-participate" style="padding: 0;">
        <div class="about-channel-grid">
          <article class="about-channel-card" id="official">
            <p class="eyebrow">活动</p>
            <h2>关注公众号</h2>
            <p>活动发布与报名</p>
            <figure><img src="/images/connect/wechat-official.jpg" alt="T Salon 微信公众号二维码" /><figcaption>微信扫码关注 codetsalon</figcaption></figure>
          </article>
          <article class="about-channel-card" id="cooperate">
            <p class="eyebrow">合作</p>
            <h2>联系 Black</h2>
            <p>嘉宾、主办、品牌与内容合作</p>
            <figure><img src="/images/connect/wechat-cooperation-qr.png" alt="Black 合作微信二维码" /><figcaption>微信扫码添加发起人</figcaption></figure>
          </article>
          <a class="about-channel-card about-channel-link" href="https://github.com/Code-T" target="_blank" rel="noreferrer">
            <p class="eyebrow">开源</p>
            <h2>GitHub<br />Code-T</h2>
            <p>开源项目与社区资料</p>
            <span>打开主页 ↗</span>
          </a>
          <a class="about-channel-card about-channel-link" href="https://space.bilibili.com/488340243" target="_blank" rel="noreferrer">
            <p class="eyebrow">视频</p>
            <h2>bilibili<br />T Salon</h2>
            <p>活动视频与内容存档</p>
            <span>打开主页 ↗</span>
          </a>
        </div>
      </section>
    </div>
  </main>
</BaseLayout>
