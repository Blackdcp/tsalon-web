---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import topicsData from '../../../data/topics.json';

const topicSlugMap = new Map<string, string>();
for (const t of topicsData) {
  topicSlugMap.set(t.name.toLowerCase(), t.slug);
}
topicSlugMap.set('agent', 'agent');
topicSlugMap.set('engineering', 'engineering');
topicSlugMap.set('ai', 'ai');
topicSlugMap.set('security', 'security');

export async function getStaticPaths() {
  const articles = await getCollection('articlesEn', ({ data }) => !data.draft);
  return articles.map((article) => ({ params: { id: article.id }, props: { article } }));
}
const { article } = Astro.props as { article: CollectionEntry<'articlesEn'> };
const { Content, headings } = await render(article);
const all = (await getCollection('articlesEn', ({ data }) => !data.draft)).sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const index = all.findIndex((item) => item.id === article.id);
const previous = index > 0 ? all[index - 1] : undefined;
const next = index < all.length - 1 ? all[index + 1] : undefined;
const labels: Record<string, string> = { news: 'Community news', insight: 'Industry insight', interview: 'Interview', 'field-note': 'Field note', guide: 'Practitioner viewpoint', archive: 'Archive' };
const pageUrl = new URL(`/en/articles/${article.id}/`, Astro.site).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: article.data.title,
  description: article.data.summary,
  datePublished: article.data.publishedAt.toISOString(),
  dateModified: (article.data.updatedAt ?? article.data.publishedAt).toISOString(),
  url: pageUrl,
  image: new URL(article.data.cover, Astro.site).toString(),
  author: { '@type': 'Organization', name: 'T Salon Editorial', url: new URL('/en/about/', Astro.site).toString(), sameAs: ['https://github.com/Code-T'] },
  publisher: { '@type': 'Organization', name: 'T Salon', url: 'https://www.tsalon.tech/' },
  inLanguage: 'en',
  about: article.data.topics,
};
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: new URL('/en/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: 'Stories', item: new URL('/en/articles/', Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: article.data.title, item: pageUrl },
  ],
};
const faqJsonLd = article.data.faq.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: article.data.faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    }
  : null;
const alternatePath = article.data.translationOf ? `/articles/${article.data.translationOf}/` : null;
const pageJsonLd = [jsonLd, breadcrumbJsonLd, ...(faqJsonLd ? [faqJsonLd] : [])];
---
<BaseLayout locale="en" alternatePath={alternatePath} title={article.data.seo.title} description={article.data.seo.description} image={article.data.cover} noindex={article.data.seo.noindex} jsonLd={pageJsonLd}>
  <main class="content-detail-page">
    <nav class="content-detail-shell content-detail-breadcrumb" aria-label="Breadcrumb"><a href="/en/articles/">Stories</a><span aria-hidden="true">/</span><span>{labels[article.data.type]}</span></nav>
    <header class="content-detail-shell content-detail-header"><div class="content-detail-kicker"><p class="eyebrow">{labels[article.data.type]} / T SALON</p><span class="mono">EDITORIAL</span></div><h1>{article.data.title}</h1><p class="content-detail-summary">{article.data.summary}</p><div class="content-detail-byline"><span class="content-detail-avatar" aria-hidden="true">TS</span><div><strong>T Salon Editorial</strong><span>{article.data.publishedAt.toISOString().slice(0, 10)} · {article.data.readingMinutes} min read</span></div></div></header>
    <figure class="content-detail-shell content-detail-cover"><div><img src={article.data.cover} alt={article.data.coverAlt} /></div><figcaption class="mono">T SALON / COMMUNITY ARCHIVE</figcaption></figure>
    <section class="content-detail-shell content-detail-body">
      <article class="prose content-detail-prose">
        {article.data.tldr.length > 0 && (
          <section class="article-tldr" aria-label="TL;DR">
            <p class="mono">TL;DR</p>
            <ul>{article.data.tldr.map((point) => <li>{point}</li>)}</ul>
          </section>
        )}
        <Content />
        {article.data.faq.length > 0 && (
          <section class="article-faq" aria-label="FAQ">
            <h2>Frequently Asked Questions</h2>
            <dl>
              {article.data.faq.map((item) => (
                <>
                  <dt>{item.question}</dt>
                  <dd>{item.answer}</dd>
                </>
              ))}
            </dl>
          </section>
        )}
        <footer class="content-detail-tags">
          <span class="mono">TOPICS</span>
          <div class="tag-list">
            {article.data.topics.map((topic) => {
              const slug = topicSlugMap.get(topic.trim().toLowerCase());
              return slug ? (
                <a href={`/en/topics/${slug}/`} class="tag tag-link">{topic}</a>
              ) : (
                <span class="tag">{topic}</span>
              );
            })}
          </div>
        </footer>
      </article>
      <aside class="content-detail-aside">
        {headings.some((heading) => heading.depth === 2) && <div class="content-detail-aside-section"><strong class="mono">ON THIS PAGE</strong><nav aria-label="On this page">{headings.filter((heading) => heading.depth === 2).map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)}</nav></div>}
        <div class="content-detail-aside-section"><strong class="mono">ARTICLE INFO</strong><dl><div><dt>TYPE</dt><dd>{labels[article.data.type]}</dd></div><div><dt>PUBLISHED</dt><dd>{article.data.publishedAt.toISOString().slice(0, 10)}</dd></div><div><dt>READING TIME</dt><dd>{article.data.readingMinutes} minutes</dd></div></dl></div>
        {article.data.citations.map((citation) => <a class="content-detail-source" href={citation.url} target="_blank" rel="noopener noreferrer">{citation.label} <span>↗</span></a>)}
      </aside>
    </section>
    <nav class="content-pagination" aria-label="Article navigation"><div class="content-detail-shell content-pagination-inner">{previous ? <a class="content-pagination-item content-pagination-previous" href={`/en/articles/${previous.id}/`}><span>← Previous</span><strong>{previous.data.title}</strong></a> : <span></span>}<a class="content-pagination-back" href="/en/articles/">All stories</a>{next ? <a class="content-pagination-item content-pagination-next" href={`/en/articles/${next.id}/`}><span>Next →</span><strong>{next.data.title}</strong></a> : <span></span>}</div>    </nav>
  </main>
</BaseLayout>

<style>
  .article-tldr {
    margin: 0 0 2rem;
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--accent, #2b6cb0);
    background: color-mix(in srgb, var(--accent, #2b6cb0) 8%, transparent);
    border-radius: 0 8px 8px 0;
  }
  .article-tldr .mono {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.7;
    margin: 0 0 0.5rem;
  }
  .article-tldr ul { margin: 0; padding-left: 1.1rem; }
  .article-tldr li { margin: 0.35rem 0; }
  .article-faq {
    margin: 2.5rem 0 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, currentColor 12%, transparent);
  }
  .article-faq h2 { font-size: 1.25rem; }
  .article-faq dl { margin: 0; }
  .article-faq dt { font-weight: 600; margin-top: 1rem; }
  .article-faq dd { margin: 0.25rem 0 0; opacity: 0.92; }
  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .tag {
    display: inline-block;
    padding: 0.25rem 0.65rem;
    font-size: 0.8125rem;
    line-height: 1.4;
    border-radius: 4px;
    background: color-mix(in srgb, currentColor 8%, transparent);
    color: inherit;
  }
  .tag-link {
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
    border: 1px solid transparent;
  }
  .tag-link:hover {
    background: color-mix(in srgb, var(--accent, #2b6cb0) 15%, transparent);
    color: var(--accent, #2b6cb0);
    border-color: color-mix(in srgb, var(--accent, #2b6cb0) 30%, transparent);
  }
</style>
