---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { formatEventDate, formatEventTimeRange, getEventState, getVisibleEventFaq } from '../../../lib/event-display';
export async function getStaticPaths() {
  const events = await getCollection('eventsEn', ({ data }) => !data.draft);
  return events.map((event) => ({ params: { id: event.id }, props: { event } }));
}
const { event } = Astro.props as { event: CollectionEntry<'eventsEn'> };
const { Content } = await render(event);
const { ended, registrationOpen, status } = getEventState(event.data.endDate, event.data.registration);
const statusLabel = ended ? 'Ended' : status === 'waitlist' ? 'Waitlist open' : registrationOpen ? 'Registration open' : 'Registration closed';
const statusClass = ended ? 'is-ended' : registrationOpen ? 'is-open' : 'is-upcoming';
const visibleFaq = ended ? [] : getVisibleEventFaq(event.data.faq, registrationOpen);
const relatedArticles = (await getCollection('articlesEn', ({ data }) => !data.draft)).filter((article) => article.data.relatedEvents.includes(event.data.translationOf));
const time = formatEventTimeRange(event.data.startDate, event.data.endDate, event.data.timezone);
const date = formatEventDate(event.data.startDate, 'en', event.data.timezone, { year: 'numeric', month: 'long', day: 'numeric' });
const faqJsonLd = visibleFaq.length > 0
  ? { '@context': 'https://schema.org', '@type': 'FAQPage', inLanguage: 'en', mainEntity: visibleFaq.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })) }
  : null;
const jsonLd = [ ended ? {
  '@context': 'https://schema.org', '@type': 'WebPage', name: event.data.title, description: event.data.summary,
  url: new URL(`/en/events/${event.id}/`, Astro.site).toString(), image: new URL(event.data.cover, Astro.site).toString(), inLanguage: 'en',
  isPartOf: { '@type': 'WebSite', name: 'T Salon', url: 'https://www.tsalon.tech/' },
} : { '@context': 'https://schema.org', '@type': 'Event', name: event.data.title, description: event.data.summary, startDate: event.data.startDate.toISOString(), endDate: event.data.endDate.toISOString(), eventStatus: ended ? undefined : 'https://schema.org/EventScheduled', eventAttendanceMode: event.data.attendanceMode === 'online' ? 'https://schema.org/OnlineEventAttendanceMode' : event.data.attendanceMode === 'hybrid' ? 'https://schema.org/MixedEventAttendanceMode' : 'https://schema.org/OfflineEventAttendanceMode', url: new URL(`/en/events/${event.id}/`, Astro.site).toString(), organizer: { '@type': 'Organization', name: 'T Salon', url: 'https://www.tsalon.tech/' }, performer: { '@type': 'Organization', name: 'T Salon' }, image: new URL(event.data.cover, Astro.site).toString(), inLanguage: 'en', location: event.data.attendanceMode === 'online' ? { '@type': 'VirtualLocation', name: event.data.venue ?? 'T Salon Online Event', url: 'https://space.bilibili.com/488340243' } : { '@type': 'Place', name: event.data.venue ?? (ended ? 'Not recorded' : 'To be announced'), address: { '@type': 'PostalAddress', streetAddress: event.data.address ?? '', addressLocality: event.data.city ?? 'To be announced', addressCountry: 'CN' } } }, ...(faqJsonLd ? [faqJsonLd] : []) ];
---
<BaseLayout locale="en" alternatePath={`/events/${event.data.translationOf}/`} title={event.data.seo.title} description={event.data.seo.description} image={event.data.cover} noindex={event.data.seo.noindex} jsonLd={jsonLd}>
  <main><nav class="container breadcrumb" aria-label="Breadcrumb"><ol><li><a href="/en/">Home</a></li><li><a href="/en/events/">Events</a></li><li aria-current="page">Event details</li></ol></nav><header class="container page-title"><div class="page-title-main"><div class:list={["event-page-status", statusClass]}><span aria-hidden="true">{ended ? '✓' : '●'}</span>{statusLabel}</div><h1>{event.data.title}</h1><p class="lead">{event.data.summary}</p></div><div class="page-title-side"><span class="mono">EVENT / {event.data.series.toUpperCase()}</span></div><div class="page-title-main event-quickfacts"><div class="quickfact"><span class="mono">DATE</span><strong>{date}</strong></div><div class="quickfact"><span class="mono">TIME</span><strong>{time}</strong></div><div class="quickfact"><span class="mono">LOCATION</span><strong>{event.data.city ?? 'Online'} · {event.data.venue ?? (ended ? 'Not recorded' : 'To be announced')}</strong></div><div class="quickfact"><span class="mono">FORMAT</span><strong>{event.data.attendanceMode === 'offline' ? 'In person' : event.data.attendanceMode === 'online' ? 'Online' : 'Hybrid'}</strong></div><div class="quickfact"><span class="mono">LANGUAGE</span><strong>Chinese</strong></div></div></header><figure class="container page-cover"><img src={event.data.cover} alt={event.data.coverAlt} /><figcaption class="mono">EVENT POSTER · T SALON</figcaption></figure><div class="content-container event-content"><aside class="event-index"><strong class="mono">ON THIS PAGE</strong><a href="#intro">Introduction</a>{event.data.agenda.length > 0 && <a href="#agenda">Programme</a>}{relatedArticles.length > 0 && <a href="#related-content">Published content</a>}{visibleFaq.length > 0 && <a href="#faq">FAQ</a>}</aside><div class="event-main"><section id="intro" class="content-section event-body">{ended && <p class="event-archive-notice">This event has ended. The original announcement and programme are preserved below; its registration instructions no longer apply.</p>}<Content /></section>{relatedArticles.length > 0 && <section id="related-content" class="content-section"><h2>Published content</h2><ul>{relatedArticles.map((article) => <li><a href={`/en/articles/${article.id}/`}>{article.data.title}</a></li>)}</ul></section>}{event.data.agenda.length > 0 && <section id="agenda" class="content-section"><h2>Programme</h2><div class="agenda">{event.data.agenda.map((item) => <div class="agenda-item"><time>{item.time}</time><div><h3>{item.title}</h3><p>{item.description}</p></div></div>)}</div></section>}{visibleFaq.length > 0 && <section id="faq" class="content-section faq"><h2>{ended ? 'Event information' : 'Frequently Asked Questions'}</h2>{visibleFaq.map((item, index) => <details open={index === 0}><summary>{item.question}</summary><p>{item.answer}</p></details>)}</section>}</div><aside id="register" class="registration-panel"><div class:list={["event-page-status", statusClass]}>{statusLabel}</div><h3>{ended ? "Event archive" : "Registration"}</h3><p>{ended ? "This page preserves the event announcement. Published related content is listed separately when available." : registrationOpen ? (event.data.registration.url ? "See the registration page for participation details." : "A registration link has not been published.") : "Registration for this event is closed."}</p>{registrationOpen && event.data.registration.deadline && <p>Registration deadline: {formatEventDate(event.data.registration.deadline, "en", event.data.timezone)}</p>}{registrationOpen && event.data.registration.url && <a class="btn btn-blue btn-block" href={event.data.registration.url} target="_blank" rel="noreferrer">{status === "waitlist" ? "Join waitlist" : "Register"} <span>↗</span></a>}</aside></div></main>
</BaseLayout>
