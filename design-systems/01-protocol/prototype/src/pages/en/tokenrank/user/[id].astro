---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { kv, getUserAnalytics } from '../../../../lib/kv';
import { beijingDateString, beijingDateNDaysAgo } from '../../../../lib/date';
import { PRICING_SNAPSHOT_DATE } from '../../../../lib/token-pricing.mjs';
import { personalRankPresentation, rankEventMetric, rankMetricsFromTokens, resolveRankQuery, summarizeRankWindow } from '../../../../lib/tokenrank-domain.mjs';

export const prerender = false;

const { id } = Astro.params;
const rawTime = Astro.url.searchParams.get('time') || (Astro.url.searchParams.get('days') === '1' ? 'today' : (Astro.url.searchParams.get('days') ? `${Astro.url.searchParams.get('days')}d` : 'today'));
const resolvedQuery = resolveRankQuery(Astro.url.searchParams);
const timeFilter = ['today', 'yesterday', '3d', '7d', '30d', '90d', 'all'].includes(rawTime) ? rawTime : resolvedQuery.time;
const metricFilter = resolvedQuery.metric;
const metricLabel = metricFilter === 'norm' ? 'No cache' : metricFilter === 'cost' ? 'Estimated cost' : 'With cache';

let days = 1;
if (timeFilter === 'today') days = 1;
else if (timeFilter === 'yesterday') days = 2;
else if (timeFilter === '3d') days = 3;
else if (timeFilter === '7d') days = 7;
else if (timeFilter === '30d') days = 30;
else if (timeFilter === '90d') days = 90;
else if (timeFilter === 'all') days = 365;

// Verify user exists
const userDataStr = await kv?.get(`user:${id}:data`);
if (!userDataStr) {
  return Astro.redirect('/en/tokenrank');
}
const userData = JSON.parse(userDataStr);
const profileMetrics = userData.metrics || rankMetricsFromTokens(userData.tokens);

// --- Derived, per-user facts to replace the old hardcoded label ---
let joinDays = 0;
if (userData.createdAt) {
  const created = new Date(userData.createdAt);
  if (!isNaN(created.getTime())) {
    joinDays = Math.max(0, Math.floor((Date.now() - created.getTime()) / 86_400_000));
  }
}

const TOOL_LABELS: Record<string, string> = {
  codex: 'Codex', cursor: 'Cursor', claude: 'Claude', antigravity: 'Antigravity',
  codex_proxy: 'Codex', workbuddy: 'WorkBuddy', gemini: 'Gemini', windsurf: 'Windsurf',
  copilot: 'Copilot', aider: 'Aider', opencode: 'OpenCode'
};
let topTool = '';
let topToolTotal = 0;
if (userData.tokens) {
  for (const [t, v] of Object.entries(userData.tokens)) {
    if (t === 'total' || t === 'history') continue;
    const vv = v as any;
    const tot = typeof vv === 'object' && vv !== null ? (vv.total || 0) : (Number(vv) || 0);
    if (tot > topToolTotal) { topToolTotal = tot; topTool = t; }
  }
}
const topToolLabel = topTool ? (TOOL_LABELS[topTool] || topTool) : '';

let lifetimeRank: number | null = null;
if (kv) {
  const r = await kv.zrevrank(`leaderboard:${metricFilter}`, id as string);
  if (typeof r === 'number') lifetimeRank = r + 1;
}

// Fetch analytics
const rawEvents = await getUserAnalytics(id as string, days);

// Dates setup
const todayDateStr = beijingDateString();
const yesterdayDateStr = beijingDateNDaysAgo(1);

let events = rawEvents;
if (timeFilter === 'yesterday') {
  events = rawEvents.filter(e => {
    const d = beijingDateString(new Date(e.timestamp));
    return d === yesterdayDateStr;
  });
} else if (timeFilter === 'today') {
  events = rawEvents.filter(e => {
    const d = beijingDateString(new Date(e.timestamp));
    return d === todayDateStr;
  });
}

const eventTotal = (event: any) => rankEventMetric(event, 'total');
const eventCost = (event: any) => rankEventMetric(event, 'cost');
const eventMetric = (event: any) => rankEventMetric(event, metricFilter);
const windowSummary = summarizeRankWindow(events, metricFilter);
const windowMetricTotal = windowSummary.selected;

// Basic aggregations
let periodTokens = windowMetricTotal;
let periodRawTokens = windowSummary.metrics.total;

// For 'all' (lifetime) view, the headline total must be the persistent lifetime
// total from the profile — not just the sum of the days we have daily
// timeseries for. Keeps the personal page consistent with the homepage 'all'.
if (timeFilter === 'all' && userData && userData.tokens) {
  periodTokens = Number(profileMetrics[metricFilter]) || 0;
  periodRawTokens = Object.entries(userData.tokens).reduce((acc, [tool, raw]: [string, any]) => {
    if (tool === 'total' || tool === 'history') return acc;
    if (typeof raw === 'number') return acc + raw;
    return acc + (Number(raw?.raw_total ?? raw?.total) || 0);
  }, 0);
}

let periodCost = windowSummary.metrics.cost;
if (timeFilter === 'all') periodCost = Number(profileMetrics.cost) || 0;

// Cache READ tokens only (not the whole event), so "effective" = total minus
// the cached portion. This matches the homepage dashboard's definition; the old
// code summed the full event for cache-hit events, which over-subtracted and
// made the personal page's effective token / cache hit-rate diverge.
let cacheReadTokensTotal = windowSummary.cacheRead;
// Real hit-rate from events; when the window has expired ('all' with no
// timeseries), derive it from the persistent user breakdown instead of a
// hardcoded 93%.
let cacheHitRate = (windowSummary.cacheRate * 100).toFixed(1);
if (timeFilter === 'all' && userData && userData.tokens) {
  let cRead = 0;
  Object.entries(userData.tokens).forEach(([tool, raw]: [string, any]) => {
    if (tool === 'total' || tool === 'history') return;
    const o = (typeof raw === 'object' && raw !== null) ? raw : null;
    cRead += o?.cache_read || 0;
  });
  const cTotal = Number(profileMetrics.total) || 0;
  if (cTotal > 0) {
    cacheReadTokensTotal = cRead;
    cacheHitRate = (cRead / cTotal * 100).toFixed(1);
  }
}
let freshTokens = windowSummary.metrics.norm;
if (timeFilter === 'all' && userData?.tokens) {
  freshTokens = Number(profileMetrics.norm) || 0;
}

const presentation = personalRankPresentation(timeFilter, events, userData.tokens);
const toolsUsed = presentation.toolsUsed;

// Daily averages
const effectiveDays = timeFilter === 'today' || timeFilter === 'yesterday' ? 1 : days;
const avgTokens = effectiveDays > 0 ? windowMetricTotal / effectiveDays : 0;
const windowLabel = timeFilter === 'all' ? 'available event window (up to 365 days)' : `selected ${effectiveDays}-day window`;

// Group by Date for tables and streaks, tracking per-tool tokens dynamically
// (no hardcoded Codex/Antigravity columns) and a DETERMINISTIC session count
// derived from that day's volume (was Math.random() before).
const dailyMap: Record<string, any> = {};
events.forEach(e => {
  const d = beijingDateString(new Date(e.timestamp));
  if (!dailyMap[d]) dailyMap[d] = { tokens: 0, total: 0, cost: 0, cache: 0, sessions: 0, tools: {} as Record<string, number> };
  dailyMap[d].tokens += eventMetric(e);
  dailyMap[d].total += eventTotal(e);
  dailyMap[d].cost += eventCost(e);
  dailyMap[d].cache += Number(e.cacheReadTokens) || 0;
  dailyMap[d].tools[e.tool] = (dailyMap[d].tools[e.tool] || 0) + eventMetric(e);
});
// Deterministic session estimate: ~200k tokens per session, min 1 when active.
const AVG_TOKENS_PER_SESSION = 200_000;
for (const d of Object.keys(dailyMap)) {
  const dayTokens = dailyMap[d].total;
  dailyMap[d].sessions = dayTokens > 0 ? Math.max(1, Math.round(dayTokens / AVG_TOKENS_PER_SESSION)) : 0;
}

// Real period composition (in/out/cache) straight from events; fall back to the
// persistent user breakdown when the timeseries window has expired (e.g. 'all').
const periodInTokens = presentation.inTokens;
const periodOutTokens = presentation.outTokens;
const periodCacheRead = presentation.cacheRead;
const periodCacheWrite = presentation.cacheWrite;
// AI time = actual generated (output) tokens / 80 tok per second, in minutes.
const aiTimeMinutes = periodOutTokens > 0 ? Math.floor(periodOutTokens / 80 / 60) : 0;
const totalConversations = Object.values(dailyMap).reduce((s, d) => s + (d.sessions || 0), 0);
const avgTokensPerConv = totalConversations > 0 ? windowMetricTotal / totalConversations : 0;

// Token composition percentages (replaces the hardcoded 6.4/0.7/92.8 split).
const compSum = periodInTokens + periodOutTokens + periodCacheRead + periodCacheWrite;
const compInPct = compSum > 0 ? (periodInTokens / compSum * 100) : 0;
const compOutPct = compSum > 0 ? (periodOutTokens / compSum * 100) : 0;
const compCacheReadPct = compSum > 0 ? (periodCacheRead / compSum * 100) : 0;
const compCacheWritePct = compSum > 0 ? (periodCacheWrite / compSum * 100) : 0;

// Max Record
let maxDayTokens = 0;
let maxDayStr = '-';
for (const [date, data] of Object.entries(dailyMap)) {
  if (data.tokens > maxDayTokens) {
    maxDayTokens = data.tokens;
    maxDayStr = date;
  }
}

// Streak
let activeStreak = 0;
for (let i = 0; i < days; i++) {
  const dStr = beijingDateNDaysAgo(i);
  if (dailyMap[dStr] && dailyMap[dStr].total > 0) {
    activeStreak++;
  } else {
    break;
  }
}

const formatAmountObj = (num: number, metric: string = metricFilter) => {
  if (metric === 'cost') return { val: num.toFixed(2), unit: 'USD' };
  if (num >= 1_000_000_000) return { val: (num / 1_000_000_000).toFixed(2), unit: 'B' };
  if (num >= 1_000_000) return { val: (num / 1_000_000).toFixed(1), unit: 'M' };
  if (num >= 1_000) return { val: (num / 1_000).toFixed(1), unit: 'K' };
  return { val: num.toString(), unit: '' };
};

const formatAmountStr = (num: number, metric: string = metricFilter) => {
  if (metric === 'cost') return '$' + num.toFixed(2);
  if (num >= 1_000_000_000) return (num / 1_000_000_000).toFixed(2) + 'B';
  if (num >= 1_000_000) return (num / 1_000_000).toFixed(1) + 'M';
  if (num >= 1_000) return (num / 1_000).toFixed(1) + 'K';
  return num.toString();
};

const periodTokensObj = formatAmountObj(periodTokens);
const freshTokensObj = formatAmountObj(freshTokens, 'norm');

const timeLabel = timeFilter === 'today' ? 'Today' : timeFilter === 'yesterday' ? 'Yesterday' : timeFilter === 'all' ? 'All-time' : `Last ${days} days`;
const aiUnit = aiTimeMinutes >= 60 ? 'h' : 'm';
const joinDate = (userData.createdAt || '').substring(0, 10) || '—';

// For charts — cap at 30 bars for readability ('all' also caps at 30).
const chartWindow = days > 90 ? 30 : days;
const lastXDays = [];
for(let i=chartWindow-1; i>=0; i--) {
  lastXDays.push(beijingDateNDaysAgo(i));
}

// For the by-day table — use the FULL selected range.
const tableDays = [];
for(let i=days-1; i>=0; i--) {
  tableDays.push(beijingDateNDaysAgo(i));
}

const dailyUsage = lastXDays.map(date => dailyMap[date]?.tokens || 0);
const dailyCost = lastXDays.map(date => dailyMap[date]?.cost || 0);

const toolBreakdown: Record<string, number> = {};
const modelBreakdown: Record<string, number> = {};

// For 'all' mode, prefer the persistent userData (timeseries events have a 31-day
// TTL so they miss any tool whose data is older than that).
if (timeFilter === 'all' && userData && userData.tokens) {
  Object.entries(userData.tokens).forEach(([tool, rawVal]: [string, any]) => {
    if (tool === 'total' || tool === 'history') return;
    const tot = typeof rawVal === 'object' && rawVal !== null
      ? Number(rawVal[metricFilter] ?? rawVal.total) || 0
      : (metricFilter === 'cost' ? 0 : Number(rawVal) || 0);
    toolBreakdown[tool] = tot;
    let mod = 'unknown';
    if (tool === 'codex' || tool === 'cursor' || tool === 'codex_proxy') mod = 'gpt-5.6-sol';
    else if (tool === 'antigravity') mod = 'gemini-2.5-pro';
    else if (tool === 'claude') mod = 'claude-3-5-sonnet';
    modelBreakdown[mod] = (modelBreakdown[mod] || 0) + tot;
  });
} else if (events.length > 0) {
  events.forEach(e => {
    toolBreakdown[e.tool] = (toolBreakdown[e.tool] || 0) + eventMetric(e);
    modelBreakdown[e.model] = (modelBreakdown[e.model] || 0) + eventMetric(e);
  });
} else if (userData && userData.tokens) {
  Object.entries(userData.tokens).forEach(([tool, rawVal]: [string, any]) => {
    if (tool === 'total' || tool === 'history') return;
    const tot = typeof rawVal === 'object' && rawVal !== null
      ? Number(rawVal[metricFilter] ?? rawVal.total) || 0
      : (metricFilter === 'cost' ? 0 : Number(rawVal) || 0);
    toolBreakdown[tool] = tot;
    let mod = 'unknown';
    if (tool === 'codex' || tool === 'cursor' || tool === 'codex_proxy') mod = 'gpt-5.6-sol';
    else if (tool === 'antigravity') mod = 'gemini-2.5-pro';
    else if (tool === 'claude') mod = 'claude-3-5-sonnet';
    modelBreakdown[mod] = (modelBreakdown[mod] || 0) + tot;
  });
}

const toolKeys = Object.keys(toolBreakdown).sort((a,b) => toolBreakdown[b] - toolBreakdown[a]);
const toolValues = toolKeys.map(k => toolBreakdown[k]);
const modelKeys = Object.keys(modelBreakdown).sort((a,b) => modelBreakdown[b] - modelBreakdown[a]);
const modelValues = modelKeys.map(k => modelBreakdown[k]);

// Distinct tools present in the period, for the dynamic by-day table columns.
const tableTools = [...new Set(events.map(e => e.tool))]
  .sort((a, b) => (toolBreakdown[b] || 0) - (toolBreakdown[a] || 0))
  .slice(0, 8);

const chartData = {
  lastXDays: lastXDays.map(d => days > 90 ? d.substring(0, 7) : d.substring(5)),
  dailyUsage, dailyCost, metric: metricFilter
};
---

<BaseLayout alternatePath={`/tokenrank/user/${id}?time=${timeFilter}&metric=${metricFilter}`} title={`${userData.name}'s Data Dashboard — T Salon`} description={`See ${userData.name}'s AI token trends, cost, and tool breakdown.`}>
  <div class="dashboard-container">
    <header class="dashboard-header">
      <div class="user-info">
        <img src={userData.image} alt={userData.name} class="avatar" />
        <div>
          <h1>{userData.name}</h1>
          <span class="location">
            {topToolLabel && <><span class="loc-chip">🤖 Main tool {topToolLabel}</span></>}
            {joinDays > 0 && <><span class="loc-sep">·</span><span class="loc-chip">📅 Member for {joinDays} days</span></>}
            {lifetimeRank && <><span class="loc-sep">·</span><span class="loc-chip">🏆 Rank #{lifetimeRank} globally</span></>}
            {!topToolLabel && joinDays === 0 && !lifetimeRank && <span class="loc-chip">T Salon member</span>}
          </span>
        </div>
      </div>
      <div class="header-actions">
        <a href={`/en/tokenrank?time=${timeFilter}&metric=${metricFilter}`} class="back-link">Token Leaderboard ↗</a>
      </div>
    </header>

    <div class="tabs">
      <a href={`?time=today&metric=${metricFilter}`} class={timeFilter === 'today' ? 'active' : ''}>Today</a>
      <a href={`?time=yesterday&metric=${metricFilter}`} class={timeFilter === 'yesterday' ? 'active' : ''}>Yesterday</a>
      <a href={`?time=3d&metric=${metricFilter}`} class={timeFilter === '3d' ? 'active' : ''}>3D</a>
      <a href={`?time=7d&metric=${metricFilter}`} class={timeFilter === '7d' ? 'active' : ''}>7D</a>
      <a href={`?time=30d&metric=${metricFilter}`} class={timeFilter === '30d' ? 'active' : ''}>30D</a>
      <a href={`?time=90d&metric=${metricFilter}`} class={timeFilter === '90d' ? 'active' : ''}>90D</a>
      <a href={`?time=all&metric=${metricFilter}`} class={timeFilter === 'all' ? 'active' : ''}>All time</a>
      <a href={`?time=${timeFilter}&metric=total`} class={metricFilter === 'total' ? 'active' : ''}>With cache</a>
      <a href={`?time=${timeFilter}&metric=norm`} class={metricFilter === 'norm' ? 'active' : ''}>No cache</a>
      <a href={`?time=${timeFilter}&metric=cost`} class={metricFilter === 'cost' ? 'active' : ''}>Estimated cost</a>
      <span class="current-date">{todayDateStr}</span>
    </div>

    <!-- 8 Cards Grid -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-top">
          <span class="label">{timeLabel} · {metricLabel} ❔</span>
        </div>
        <div class="value">{periodTokensObj.val}<span class="unit">{periodTokensObj.unit}</span></div>
        <div class="subtext">Daily avg {formatAmountStr(avgTokens)} · {windowLabel}</div>
      </div>
      <div class="stat-card">
        <div class="stat-top">
          <span class="label">Estimated Cost ❔</span>
        </div>
        <div class="value"><span class="unit">$</span>{periodCost.toLocaleString('en-US', {maximumFractionDigits: 0})}</div>
        <div class="subtext">Equivalent cost at central pricing · {PRICING_SNAPSHOT_DATE}</div>
      </div>
      <div class="stat-card">
        <div class="stat-top">
          <span class="label">Billable Tokens ❔</span>
        </div>
        <div class="value">{freshTokensObj.val}<span class="unit">{freshTokensObj.unit}</span></div>
        <div class="subtext">{(periodRawTokens > 0 ? (freshTokens / periodRawTokens * 100).toFixed(1) : 0)}% of raw tokens</div>
      </div>
      <div class="stat-card">
        <div class="stat-top">
          <span class="label">Conversations ❔</span>
        </div>
        <div class="value">{totalConversations.toLocaleString()} <span class="unit">chats</span></div>
        <div class="subtext">{formatAmountStr(avgTokensPerConv)} avg</div>
      </div>

      <div class="stat-card">
        <div class="stat-top">
          <span class="label">Tools Used ❔</span>
        </div>
        <div class="value">{toolsUsed} <span class="unit">tools</span></div>
        <div class="subtext">Main: {toolKeys[0] || 'none'}</div>
      </div>
      <div class="stat-card">
        <div class="stat-top">
          <span class="label">AI Time ❔</span>
        </div>
        <div class="value">{aiTimeMinutes >= 60 ? (aiTimeMinutes / 60).toFixed(1) : aiTimeMinutes} <span class="unit">{aiUnit}</span></div>
        <div class="subtext">Est. at 80 tokens/sec of active generation</div>
      </div>
      <div class="stat-card">
        <div class="stat-top">
          <span class="label">Cache Hit Rate{timeFilter === 'all' ? ' (lifetime)' : ''} ❔</span>
        </div>
        <div class="value">{cacheHitRate}<span class="unit">%</span></div>
        <div class="subtext">Cache read {formatAmountStr(cacheReadTokensTotal, 'total')}</div>
      </div>
      <div class="stat-card">
        <div class="stat-top">
          <span class="label">Active Streak ❔</span>
        </div>
        <div class="value">{activeStreak} <span class="unit">days</span></div>
        <div class="subtext">Since joining {joinDate}</div>
      </div>
    </div>

    <!-- Key Facts Banner -->
    <div class="key-facts-banner">
      <div class="fact-col">
        <span class="fact-label">Best single day · {windowLabel}</span>
        <span class="fact-value">{formatAmountStr(maxDayTokens, metricFilter)} · {maxDayStr}</span>
      </div>
      <div class="fact-col">
        <span class="fact-label">Active streak</span>
        <span class="fact-value">{activeStreak} days</span>
      </div>
      <div class="fact-col">
        <span class="fact-label">Since joining</span>
        <span class="fact-value">{joinDate}</span>
      </div>
      <div class="fact-col">
        <span class="fact-label">Active days · {windowLabel}</span>
        <span class="fact-value">{Object.keys(dailyMap).length} days</span>
      </div>
      <div class="fact-col">
        <span class="fact-label">Daily avg · {windowLabel}</span>
        <span class="fact-value">{formatAmountStr(avgTokens, metricFilter)}</span>
      </div>
    </div>

    <!-- Charts -->
    <div class="charts-row">
      <div class="chart-box">
        <h3>{windowLabel} · daily {metricLabel.toLowerCase()} · last {chartWindow} days</h3>
        <div id="usageChart" style="height: 250px; width: 100%;"></div>
      </div>
      <div class="chart-box">
        <h3>Daily cost · last {chartWindow} days</h3>
        <div id="costChart" style="height: 250px; width: 100%;"></div>
      </div>
    </div>

    <!-- Progress Bars -->
    <div class="charts-row">
      <div class="chart-box">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 1rem;">
          <h3>By tool</h3>
        </div>
        <div class="progress-list">
          {toolKeys.map((k, i) => (
            <div class="progress-item">
              <span class="p-label">{k === 'codex' ? 'Codex' : k === 'antigravity' ? 'Antigravity' : k}</span>
              <div class="p-bar-wrapper">
                <div class="p-bar" style={`width: ${periodTokens > 0 ? (toolValues[i]/periodTokens*100) : 0}%; background-color: ${i===0 ? '#2563EB' : '#93C5FD'};`}></div>
              </div>
              <div class="p-values">
                <span class="p-val-amount">{formatAmountStr(toolValues[i], metricFilter)}</span>
                <span class="p-val-pct">{(periodTokens > 0 ? (toolValues[i]/periodTokens*100) : 0).toFixed(1)}%</span>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="chart-box">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 1rem;">
          <h3>By model</h3>
          <span style="font-size:0.75rem; color:var(--text-secondary);">Top 8</span>
        </div>
        <div class="progress-list">
          {modelKeys.map((k, i) => (
            <div class="progress-item">
              <span class="p-label">{k}</span>
              <div class="p-bar-wrapper">
                <div class="p-bar" style={`width: ${periodTokens > 0 ? (modelValues[i]/periodTokens*100) : 0}%; background-color: ${i===0 ? '#2563EB' : '#93C5FD'};`}></div>
              </div>
              <div class="p-values">
                <span class="p-val-amount">{formatAmountStr(modelValues[i], metricFilter)}</span>
                <span class="p-val-pct">{(periodTokens > 0 ? (modelValues[i]/periodTokens*100) : 0).toFixed(1)}%</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Token Composition -->
    <div class="chart-box" style="margin-bottom: 1.5rem;">
      <h3>Token Composition</h3>
      <div class="composition-bar">
        <div class="comp-input" style={`width: ${compInPct}%;`}></div>
        <div class="comp-output" style={`width: ${compOutPct}%;`}></div>
        <div class="comp-cache-read" style={`width: ${compCacheReadPct}%;`}></div>
        <div class="comp-cache-write" style={`width: ${compCacheWritePct}%;`}></div>
      </div>
      <div class="comp-legend">
        <span><div class="dot" style="background:#2563EB;"></div> Input {compInPct.toFixed(1)}%</span>
        <span><div class="dot" style="background:#93C5FD;"></div> Output {compOutPct.toFixed(1)}%</span>
        <span><div class="dot" style="background:#E5E7EB;"></div> Cache read {compCacheReadPct.toFixed(1)}%</span>
        <span><div class="dot" style="background:#D1D5DB;"></div> Cache write {compCacheWritePct.toFixed(1)}%</span>
      </div>
      <div class="subtext" style="margin-top:0.5rem;">Pricing snapshot: {PRICING_SNAPSHOT_DATE} · Cost is an API-equivalent estimate from central pricing.</div>
    </div>

    <!-- Data Table -->
    <div class="chart-box">
      <h3>Daily breakdown · {windowLabel}</h3>
      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>Date</th>
              {tableTools.map(t => <th>{t === 'codex' ? 'Codex' : t === 'antigravity' ? 'Antigravity' : t === 'codex_proxy' ? 'Codex' : t.charAt(0).toUpperCase() + t.slice(1)}</th>)}
              <th>{metricLabel}</th>
              <th>Cost</th>
              <th>Sessions</th>
              <th>Hit rate</th>
            </tr>
          </thead>
          <tbody>
            {tableDays.map(date => {
              const dData = dailyMap[date];
              if (!dData || dData.total === 0) return null;
              const hitRate = dData.total > 0 ? (dData.cache / dData.total * 100) : 0;
              return (
                <tr>
                  <td>{date}</td>
                  {tableTools.map(t => <td>{dData.tools[t] > 0 ? formatAmountStr(dData.tools[t], metricFilter) : '—'}</td>)}
                  <td class="td-total">{formatAmountStr(dData.tokens, metricFilter)}</td>
                  <td>${dData.cost.toFixed(2)}</td>
                  <td>{dData.sessions}</td>
                  <td>
                    <div class="hit-rate-cell">
                      <span>{hitRate.toFixed(1)}%</span>
                      <div class="tiny-bar"><div class="tiny-fill" style={`width: ${hitRate}%;`}></div></div>
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</BaseLayout>

<script is:inline src="https://cdn.jsdelivr.net/npm/echarts@5.5.0/dist/echarts.min.js"></script>
<script is:inline define:vars={{ chartData }}>
  function initCharts() {
    if (typeof echarts === 'undefined') { setTimeout(initCharts, 50); return; }
    const usageEl = document.getElementById('usageChart');
    const costEl = document.getElementById('costChart');
    if (!usageEl || !costEl) return;
    const usageChart = echarts.init(usageEl);
    const costChart = echarts.init(costEl);
    usageChart.setOption({
      tooltip: { trigger: 'axis' },
      grid: { left: '3%', right: '4%', bottom: '3%', top: '10%', containLabel: true },
      xAxis: { type: 'category', data: chartData.lastXDays, axisLine: { lineStyle: { color: '#e5e7eb' } }, axisLabel: { color: '#6b7280' } },
      yAxis: { type: 'value', splitLine: { show: false }, axisLabel: { color: '#6b7280', formatter: (val) => chartData.metric === 'cost' ? '$' + Number(val).toFixed(2) : (val/1e9) >= 1 ? (val/1e9).toFixed(1) + 'B' : (val/1e6) >= 1 ? (val/1e6).toFixed(1) + 'M' : (val/1e3 >= 1 ? (val/1e3).toFixed(0) + 'K' : val) } },
      series: [{ data: chartData.dailyUsage, type: 'bar', itemStyle: { color: '#93C5FD', borderRadius: [2,2,0,0] }, barWidth: '40%' }]
    });
    costChart.setOption({
      tooltip: { trigger: 'axis', formatter: '${c}' },
      grid: { left: '3%', right: '4%', bottom: '3%', top: '10%', containLabel: true },
      xAxis: { type: 'category', data: chartData.lastXDays, axisLine: { lineStyle: { color: '#e5e7eb' } }, axisLabel: { color: '#6b7280' } },
      yAxis: { type: 'value', splitLine: { show: false }, axisLabel: { color: '#6b7280', formatter: '${value}' } },
      series: [{ data: chartData.dailyCost, type: 'bar', itemStyle: { color: '#93C5FD', borderRadius: [2,2,0,0] }, barWidth: '40%' }]
    });
    window.addEventListener('resize', () => { usageChart.resize(); costChart.resize(); });
  }
  if (document.readyState !== 'loading') initCharts();
  else document.addEventListener('DOMContentLoaded', initCharts);
</script>

