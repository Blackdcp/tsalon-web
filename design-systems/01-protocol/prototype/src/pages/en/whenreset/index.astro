              <div class="range-wrap">
                <input type="range" id="weekly-used-slider" min="0" max="100" value="35" class="custom-range" />
                <div class="range-number-box">
                  <input type="number" id="weekly-used-number" min="0" max="100" value="35" class="number-input" />
                  <span class="unit">%</span>
                </div>
              </div>
            </div>

            <div class="control-card">
              <label class="control-label" for="weekly-reset-time">
                <span>Next Personal Reset Time (UTC+8)</span>
                <span class="control-hint">The next scheduled quota refresh time in your client</span>
              </label>
              <input type="datetime-local" id="weekly-reset-time" class="time-input full-width" step="60" />
