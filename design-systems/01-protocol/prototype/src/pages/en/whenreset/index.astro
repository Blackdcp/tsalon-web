            <div class="card-value">{claude.typicalGapDays ?? '—'} <span class="unit">days</span></div>
            <div class="card-sub">Loaded past 30 days: {status === 'unavailable' ? '—' : claude.resets30d} resets, {status === 'unavailable' ? '—' : claude.cards30d} cards</div>
            <div class="card-hint">Source: WhenReset.dev · Records may be partial</div>
          </div>
        </div>

        <!-- Window Time Calculator for Claude -->
        <div class="tool-card">
          <div class="tool-header">
            <div class="tool-icon">⏳</div>
            <div>
              <h2 class="tool-title">Five-Hour Window Calculator</h2>
              <p class="tool-sub">Enter a known window start, not the moment you hit the limit. Computes an assumed 5-hour window end only; refer to your product client for real account recovery.</p>
            </div>
          </div>
          <div class="calc-row">
            <div class="calc-input-group">
              <label for="claude-window-start">Known window start (UTC+8)</label>
              <input type="datetime-local" id="claude-window-start" class="time-input" step="60" />
              <button type="button" id="claude-calculate" class="btn btn-dark">Calculate with 5 hours</button>
            </div>
            <div class="calc-arrow" aria-hidden="true">➔</div>
            <div class="calc-result-box" aria-live="polite">
