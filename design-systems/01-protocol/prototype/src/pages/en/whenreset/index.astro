                  <th>Type</th>
                  <th>Scope</th>
                  <th>Reason / Context</th>
                  <th>Ago</th>
                  <th>Source</th>
                </tr>
              </thead>
              <tbody>
                {grok.events.length === 0 && <tr><td colspan="6">No event records available.</td></tr>}
                {grok.events.map((e) => (
