      <!-- Weekly Quota & Pacing Calculator -->
      <section id="weekly-calculator-app" class="planner-section">
        <div class="section-badge-tag">Quota Planning Tool</div>
        <div class="planner-header">
          <div>
            <h2 class="section-title">Weekly Quota Planner Calculator</h2>
            <p class="section-sub">Enter your percentage used and next reset time to estimate pacing, exhaustion risks, and recommended daily quota budgets.</p>
          </div>
          <div class="calc-presets">
            <button type="button" class="calc-preset-btn active" data-preset="claude">Claude (Weekly)</button>
            <button type="button" class="calc-preset-btn" data-preset="codex">Codex (Weekly)</button>
            <button type="button" class="calc-preset-btn" data-preset="grok">Grok (Weekly)</button>
            <button type="button" class="calc-preset-btn" data-preset="cursor">Cursor (Monthly 500)</button>
          </div>
        </div>

        <div class="planner-body">
          <div class="planner-controls">
            <div class="control-card">
              <label class="control-label" for="weekly-used-slider">
                <span>Current Percentage Used</span>
                <span class="control-hint">As reported by your client or product settings</span>
