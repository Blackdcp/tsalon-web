---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getResetRadarData } from '../../../lib/reset-radar';

export const prerender = false;

const radarData = await getResetRadarData();
const { codex, claude, grok, updatedAtBeijing, status } = radarData;

const stripTags = (html: string) => html.replace(/<[^>]*>/g, '');

const faqItems = [
  {
    "q": "What is the difference between global resets, scoped resets, and reset cards?",
    "a": "Only records explicitly scoped to all users are designated as global resets. Other resets retain their documented scope (such as paid, affected, or max plans). Reset card entries record bonus issuance events and do not imply an automatic reset for all accounts. Eligibility and expiry details can be found in the linked source post. None of these records establish your individual remaining quota."
  },
  {
    "q": "Can my quota recovery time be computed from when I hit the limit?",
    "a": "No. The moment you hit the limit does not equal the window start. The calculator only adds 5 hours to your <strong>known window start</strong>, showing the assumed window end. Different products and tiers may have varying limits; always consult the time and quota shown directly inside the product."
  },
  {
    "q": "How is the historical interval reference point calculated?",
    "a": "From loaded records, the median gap between up to 10 distinct global reset timestamps is computed and added to the latest global reset time. Reset cards and scoped resets are excluded. If fewer than two global resets are loaded, no reference point is displayed. This is purely a historical arithmetic point, not an official schedule."
  },
  {
    "q": "Where do records for Codex, Claude, and Grok come from?",
    "a": "T Salon queries the <a href=\"https://whenreset.dev/api/resets\" target=\"_blank\" rel=\"noreferrer\">WhenReset.dev records API</a> upon page request with a 5-minute cache. Records link directly to original posts by official teams and technical leads. When unreachable, the page indicates temporary unavailability."
  },
  {
    "q": "How does the weekly quota planner calculator work?",
    "a": "Enter your current percentage used and your next personal reset time as shown in your product client. The calculator estimates your hourly burn pace, remaining time until reset, and recommended daily quota budget. All calculations run client-side with data stored only in local storage."
  }
];

const pageUrl = new URL('/en/whenreset/', Astro.site).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'AI Quota Reset Radar',
    url: pageUrl,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Web',
    description:
      'Monitor Codex, Claude, and Grok quota resets and cards from WhenReset.dev, plan weekly usage pacing, calculate five-hour rolling windows, and subscribe to real-time RSS feeds.',
    publisher: { '@type': 'Organization', name: 'T Salon', url: 'https://www.tsalon.tech/' },
    inLanguage: 'en-US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    url: pageUrl,
    inLanguage: 'en-US',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: stripTags(item.a) },
    })),
  },
];
---

<BaseLayout
  title="AI Quota Reset Radar · Multi-Model Tracker & Weekly Planner | T Salon"
  description="Live tracking of Codex, Claude, and Grok quota resets and bonus cards from WhenReset.dev, with weekly pacing calculator, 5-hour window tools, and RSS feeds."
  alternatePath="/whenreset/"
  locale="en"
  jsonLd={jsonLd}
>
  <main class="reset-page">
    <div class="container">
      <!-- Top Title & Live Status -->
      <section class="reset-hero">
        <div class="hero-top-badge">
          <span class:list={['pulse-dot', { unavailable: status === 'unavailable' }]}></span>
          <span>{status === 'unavailable' ? 'WhenReset.dev records currently unavailable' : status === 'empty' ? 'No records available from WhenReset.dev' : 'WhenReset.dev Event Records'}{updatedAtBeijing && ` · Read at ${updatedAtBeijing} (UTC+8)`}</span>
        </div>
        <h1 class="hero-title">AI Quota Reset Radar</h1>
        <p class="hero-desc">Live tracker for OpenAI Codex, Anthropic Claude, and xAI Grok reset and bonus card events, featuring weekly quota pacing planning and real-time RSS/Webhook feeds. Recorded events do not establish your personal account quota status.</p>

        <!-- Provider Switcher Tabs -->
        <div class="provider-tabs">
          <button class="tab-btn active" data-provider="codex">
            <span class="tab-icon">⚡️</span>
            <span class="tab-name">OpenAI Codex</span>
            <span class="tab-badge">Records</span>
          </button>
          <button class="tab-btn" data-provider="claude">
            <span class="tab-icon">🧠</span>
            <span class="tab-name">Anthropic Claude</span>
            <span class="tab-badge">Records</span>
          </button>
          <button class="tab-btn" data-provider="grok">
            <span class="tab-icon">🚀</span>
            <span class="tab-name">xAI Grok</span>
            <span class="tab-badge">Records</span>
          </button>
        </div>
      </section>

      <!-- Codex Section -->
      <div id="section-codex" class="provider-section active">
        {codex.watchNotice?.isOpen && (
          <div class="alert-banner">
            <div class="alert-icon">🚨</div>
            <div class="alert-content">
              <div class="alert-title">{codex.watchNotice.titleEn || "Notice in the source feed"}</div>
              <p class="alert-text">{codex.watchNotice.text}</p>
              {codex.watchNotice.scheduledAtBeijing && (
                <div class="alert-meta">Scheduled in the source: {codex.watchNotice.scheduledAtBeijing} (UTC+8)</div>
              )}
            </div>
            {codex.watchNotice.tweetUrl && (
              <a href={codex.watchNotice.tweetUrl} target="_blank" rel="noreferrer" class="btn btn-dark alert-btn">
                Source Post <span>↗</span>
              </a>
            )}
          </div>
        )}

        <!-- 4 Stats Cards Bento -->
        <div class="stats-bento">
          <div class="bento-card">
            <div class="card-label">Latest Event</div>
            <div class="card-value highlight">{codex.latestEvent?.typeLabelEn || 'No records'}</div>
            <div class="card-sub">{codex.latestEvent?.timeAgoEn || '—'}</div>
            <div class="card-sub">Scope: {codex.latestEvent?.scopeEn || 'Not specified'}</div>
          </div>
          <div class="bento-card">
            <div class="card-label">Event Time (UTC+8)</div>
            <div class="card-value">{codex.latestEvent?.landedAtBeijing || '—'}</div>
            <div class="card-sub">Reason: {codex.latestEvent?.reasonEn || 'Not specified in this record'}</div>
            {codex.latestEvent?.postUrl && (
              <a href={codex.latestEvent.postUrl} target="_blank" rel="noreferrer" class="card-link">Source post ↗</a>
            )}
          </div>
          <div class="bento-card">
            <div class="card-label">Historical Cadence Reference</div>
            <div class="card-value">{codex.nextEstimated.dateBeijing} <span class="time-sub">{codex.nextEstimated.timeBeijing}</span></div>
            <div class="card-sub">{codex.nextEstimated.relativeTextEn}</div>
            <div class="card-hint">Based on {codex.cadenceIntervalCount} global reset intervals; not an official schedule</div>
          </div>
          <div class="bento-card">
            <div class="card-label">Median Global Gap</div>
            <div class="card-value">{codex.typicalGapDays ?? '—'} <span class="unit">days</span></div>
            <div class="card-sub">Loaded past 30 days: {status === 'unavailable' ? '—' : codex.resets30d} resets, {status === 'unavailable' ? '—' : codex.cards30d} cards</div>
            <div class="card-hint">Source: WhenReset.dev · Records may be partial</div>
          </div>
        </div>

        <!-- Window Time Calculator -->
        <div class="tool-card">
          <div class="tool-header">
            <div class="tool-icon">⏳</div>
            <div>
              <h2 class="tool-title">Five-Hour Window Calculator</h2>
              <p class="tool-sub">Enter a known window start, not the moment you hit the limit. Computes an assumed 5-hour window end only; refer to your product client for real account recovery.</p>
            </div>
          </div>
          <div class="calc-row">
            <div class="calc-input-group">
              <label for="codex-window-start">Known window start (UTC+8)</label>
              <input type="datetime-local" id="codex-window-start" class="time-input" step="60" />
              <button type="button" id="codex-calculate" class="btn btn-dark">Calculate with 5 hours</button>
            </div>
            <div class="calc-arrow" aria-hidden="true">➔</div>
            <div class="calc-result-box" aria-live="polite">
              <div class="result-label">Assumed window end (UTC+8)</div>
              <div class="result-time" id="codex-calc-result">—</div>
              <div class="result-tips" id="codex-calc-tips">Enter a known start, then select Calculate.</div>
            </div>
          </div>
        </div>

        <!-- Events Table -->
        <div class="history-section">
          <div class="history-header">
            <h2 class="history-title">Codex Reset & Card Records</h2>
            <span class="history-count">Up to 30 loaded records · UTC+8</span>
          </div>

          <div class="table-responsive">
            <table class="radar-table">
              <thead>
                <tr>
                  <th>Date (UTC+8)</th>
                  <th>Type</th>
                  <th>Scope</th>
                  <th>Reason / Context</th>
                  <th>Ago</th>
                  <th>Source</th>
                </tr>
              </thead>
              <tbody>
                {codex.events.length === 0 && <tr><td colspan="6">No event records available.</td></tr>}
                {codex.events.map((e) => (
                  <tr>
                    <td class="cell-date">{e.landedAtBeijing}</td>
                    <td>
                      <span class={`badge ${e.type === 'reset' ? 'badge-reset' : 'badge-card'}`}>{e.typeLabelEn}</span>
                    </td>
                    <td class="cell-scope">{e.scopeEn}</td>
                    <td class="cell-reason">{e.reasonEn}</td>
                    <td class="cell-timeago">{e.timeAgoEn}</td>
                    <td class="cell-src">
                      {e.postUrl ? (
                        <a href={e.postUrl} target="_blank" rel="noreferrer" class="src-link">
                          Post ↗
                        </a>
                      ) : (
                        '--'
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Claude Section -->
      <div id="section-claude" class="provider-section">
        {claude.watchNotice?.isOpen && (
          <div class="alert-banner">
            <div class="alert-icon">🚨</div>
            <div class="alert-content">
