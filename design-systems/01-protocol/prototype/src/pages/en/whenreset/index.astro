              <div class="result-time" id="claude-calc-result">—</div>
              <div class="result-tips" id="claude-calc-tips">Enter a known start, then select Calculate.</div>
            </div>
          </div>
        </div>

        <!-- Events Table -->
        <div class="history-section">
          <div class="history-header">
            <h2 class="history-title">Claude Reset & Card Records</h2>
            <span class="history-count">Up to 30 loaded records · UTC+8</span>
          </div>

          <div class="table-responsive">
            <table class="radar-table">
              <thead>
                <tr>
                  <th>Date (UTC+8)</th>
                  <th>Type</th>
                  <th>Scope</th>
                  <th>Reason / Context</th>
                  <th>Ago</th>
                  <th>Source</th>
                </tr>
              </thead>
              <tbody>
                {claude.events.length === 0 && <tr><td colspan="6">No event records available.</td></tr>}
                {claude.events.map((e) => (
                  <tr>
                    <td class="cell-date">{e.landedAtBeijing}</td>
                    <td>
                      <span class={`badge ${e.type === 'reset' ? 'badge-reset' : 'badge-card'}`}>{e.typeLabelEn}</span>
                    </td>
                    <td class="cell-scope">{e.scopeEn}</td>
                    <td class="cell-reason">{e.reasonEn}</td>
                    <td class="cell-timeago">{e.timeAgoEn}</td>
                    <td class="cell-src">
                      {e.postUrl ? (
                        <a href={e.postUrl} target="_blank" rel="noreferrer" class="src-link">
                          Post ↗
                        </a>
                      ) : (
                        '--'
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Grok Section -->
      <div id="section-grok" class="provider-section">
        {grok.watchNotice?.isOpen && (
          <div class="alert-banner">
            <div class="alert-icon">🚨</div>
            <div class="alert-content">
              <div class="alert-title">{grok.watchNotice.titleEn || "Notice in the source feed"}</div>
              <p class="alert-text">{grok.watchNotice.text}</p>
              {grok.watchNotice.scheduledAtBeijing && (
                <div class="alert-meta">Scheduled in the source: {grok.watchNotice.scheduledAtBeijing} (UTC+8)</div>
              )}
            </div>
            {grok.watchNotice.tweetUrl && (
              <a href={grok.watchNotice.tweetUrl} target="_blank" rel="noreferrer" class="btn btn-dark alert-btn">
                Source Post <span>↗</span>
              </a>
            )}
          </div>
        )}

        <!-- 4 Stats Cards Bento -->
        <div class="stats-bento">
          <div class="bento-card">
            <div class="card-label">Latest Event</div>
            <div class="card-value highlight">{grok.latestEvent?.typeLabelEn || 'No records'}</div>
