          </div>
          <div class="bento-card">
            <div class="card-label">Median Global Gap</div>
            <div class="card-value">{grok.typicalGapDays ?? '—'} <span class="unit">days</span></div>
            <div class="card-sub">Loaded past 30 days: {status === 'unavailable' ? '—' : grok.resets30d} resets, {status === 'unavailable' ? '—' : grok.cards30d} cards</div>
            <div class="card-hint">Source: WhenReset.dev · Records may be partial</div>
          </div>
        </div>

        <!-- Window Time Calculator for Grok -->
        <div class="tool-card">
          <div class="tool-header">
            <div class="tool-icon">⏳</div>
            <div>
              <h2 class="tool-title">Five-Hour Window Calculator</h2>
              <p class="tool-sub">Enter a known window start, not the moment you hit the limit. Computes an assumed 5-hour window end only; refer to your product client for real account recovery.</p>
            </div>
          </div>
          <div class="calc-row">
            <div class="calc-input-group">
