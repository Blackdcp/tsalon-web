          </div>

          <div class="planner-results">
            <div class="planner-metrics">
              <div class="metric-card">
                <span class="metric-label">Pace Verdict</span>
                <div class="metric-val"><span id="weekly-calc-badge" class="pace-badge badge-success">Evaluating...</span></div>
                <span class="metric-hint">Estimated from current burn rate</span>
              </div>
              <div class="metric-card">
                <span class="metric-label">Projected Total Usage</span>
                <div class="metric-val"><strong id="weekly-calc-burn">—</strong></div>
                <span class="metric-hint">At your current pace until reset</span>
              </div>
              <div class="metric-card">
                <span class="metric-label">Daily Budget Recommendation</span>
