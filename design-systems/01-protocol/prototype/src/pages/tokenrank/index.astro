---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareModal from '../../components/ShareModal.astro';
import { getSession } from 'auth-astro/server';
import { getLeaderboard, getGlobalStats } from '../../lib/kv';

// Opt-out of static rendering for real-time leaderboard
export const prerender = false;

let leaderboard: any[] = [];
let stats = { totalUsers: 0, totalTokens: 0 };
try {
  leaderboard = await getLeaderboard(100);
  stats = await getGlobalStats();
} catch (e) {
  console.error('Failed to fetch leaderboard data:', e);
}

let session: any = null;
let currentUser = null;
let currentUserRank = 0;

try {
  session = await getSession(Astro.request);
  if (session?.user) {
    // Find user in leaderboard
    const userIndex = leaderboard.findIndex(u => u.name === session.user.name); // Using name as fallback, ideally user id
    if (userIndex !== -1) {
      currentUser = leaderboard[userIndex];
      currentUserRank = userIndex + 1;
    }
  }
} catch(e) {}

const seoJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'T Salon Token 排行榜',
  description: '全网 AI 开发者 Token 消耗风云榜，实时统计各路大神的本地 AI 代码生成量。'
};

const PRICING: Record<string, { in: number, out: number, cache: number }> = {
  'gpt-5.6-sol': { in: 5, out: 30, cache: 0.5 },
  'gemini-2.5-pro': { in: 2, out: 12, cache: 0.2 },
  'claude-3-5-sonnet': { in: 2, out: 10, cache: 0.2 },
  'default': { in: 0.5, out: 2, cache: 0.075 }
};

const getToolEstimatedCost = (tool: string, tokens: number) => {
  let model = 'default';
  let cacheRate = 0.5;
  if (tool === 'cursor' || tool === 'codex' || tool === 'codex_proxy') {
    model = 'gpt-5.6-sol';
    cacheRate = 0.93;
  } else if (tool === 'antigravity') {
    model = 'gemini-2.5-pro';
    cacheRate = 0.1;
  } else if (tool === 'claude') {
    model = 'claude-3-5-sonnet';
    cacheRate = 0.8;
  }
  const p = PRICING[model] || PRICING['default'];
  const millions = tokens / 1_000_000;
  const cacheHitTokens = millions * cacheRate;
  const freshTokens = millions * (1 - cacheRate);
  return (cacheHitTokens * p.cache) + (freshTokens * (0.9 * p.in + 0.1 * p.out));
};
---

<BaseLayout alternatePath="/tokenrank/" title="Token 排行榜 — T Salon" description="全网 AI 开发者 Token 消耗风云榜，实时统计各路大神的本地 AI 代码生成量。" image="/images/home-community-group.webp" jsonLd={seoJsonLd}>
  <main>
    <header class="hero-stats">
      <div class="container hero-stats-inner">
        <div class="hero-badge"><span class="pulse-dot"></span> 全网排行榜活跃中</div>
        <h1 class="hero-title">Token 排行榜</h1>
        <p class="hero-subtitle">开发者本地 AI 编码能耗大比拼</p>
        
        <div class="hero-metrics">
          <div class="metric-card">
            <span class="metric-label">参与总人数</span>
            <strong class="metric-value">{stats.totalUsers} <span class="metric-unit">人</span></strong>
          </div>
          <div class="metric-card highlight">
            <span class="metric-label">全员总消耗</span>
            <strong class="metric-value">{(stats.totalTokens / 100000000).toFixed(2)} <span class="metric-unit">亿 Tokens</span></strong>
          </div>
          <div class="metric-card glowing">
            <span class="metric-label">预计总花费</span>
            <strong class="metric-value">≈ ${(stats.totalTokens / 1000000 * 3).toFixed(0)}</strong>
          </div>
        </div>
      </div>
    </header>

    <div class="container content-container" style="display: flex; flex-direction: column;">
      
      <div class="join-banner">
        <div class="join-banner-text">
          <h3>如何上榜？</h3>
          <p>将 GitHub 账号与本地环境绑定，运行专属提取脚本即可快速上榜。</p>
        </div>
        <div class="join-banner-action">
          <a class="btn btn-blue" href="/tokenrank/connect/" style="padding: 0.6rem 1.25rem;">生成专属接入命令 <span>↗</span></a>
          <button class="btn btn-dark" onclick="openShareModal()">分享榜单 ↗</button>
        </div>
      </div>

      <div class="event-main" style="width: 100%; margin-top: 2rem;">
        {leaderboard.length === 0 ? (
          <div class="content-section"><p>暂时还没有人上榜，快去抢首发吧！</p></div>
        ) : (
          <table class="tokenrank-table">
            <thead>
              <tr>
                <th>排名</th>
                <th>T 友</th>
                <th>消耗详情 (多端工具)</th>
                <th>总 Tokens</th>
              </tr>
            </thead>
            <tbody>
              {leaderboard.map((user, idx) => (
                <tr class="rank-row-wrapper" onclick={`window.location.href='/tokenrank/user/${user.userId}'`} style="cursor: pointer;">
                  <td class="rank-num">
                    {idx === 0 ? '🥇' : idx === 1 ? '🥈' : idx === 2 ? '🥉' : idx + 1}
                  </td>
                  <td>
                    <div class="rank-user">
                      <img src={user.image} alt={user.name} class="rank-avatar" crossorigin="anonymous" />
                      <strong>{user.name}</strong>
                    </div>
                  </td>
                  <td class="rank-details">
                    {Object.entries(user.tokens).filter(([k]) => k !== 'total').map(([tool, amount]: [string, any]) => (
                      <span class={`badge ${tool}`}>
                        {tool.charAt(0).toUpperCase() + tool.slice(1)} ~${getToolEstimatedCost(tool, amount).toFixed(0)}
                      </span>
                    ))}
                  </td>
                  <td class="rank-total">
                    <strong>{(user.tokens.total / 100000000).toFixed(2)} 亿</strong>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </div>
    </div>
  </main>

  <ShareModal leaderboard={leaderboard} currentUser={currentUser} currentUserRank={currentUserRank} />
</BaseLayout>

<style>
  /* HERO STATS STYLES */
  .hero-stats {
    background: linear-gradient(135deg, #111827 0%, #1f2937 100%);
    color: white;
    padding: 5rem 0 6rem 0;
    text-align: center;
    position: relative;
    overflow: hidden;
    margin-bottom: -3rem; /* overlap with content container */
  }
  .hero-stats::before {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(59,130,246,0.1) 0%, transparent 50%);
    z-index: 1;
    pointer-events: none;
  }
  .hero-stats-inner {
    position: relative;
    z-index: 2;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(4px);
    padding: 0.35rem 1rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    color: #e5e7eb;
    border: 1px solid rgba(255,255,255,0.2);
  }
  .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: #10B981;
    border-radius: 50%;
    margin-right: 8px;
    box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7);
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.7); }
    70% { transform: scale(1); box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
    100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(16, 185, 129, 0); }
  }
  .hero-title {
    font-size: 3.5rem;
    font-weight: 900;
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.02em;
    color: #ffffff;
  }
  .hero-subtitle {
    font-size: 1.25rem;
    color: #9ca3af;
    margin-bottom: 3rem;
  }
  .hero-metrics {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .metric-card {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(12px);
    border-radius: 20px;
    padding: 2rem 2.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 220px;
    transition: transform 0.3s ease;
  }
  .metric-card:hover {
    transform: translateY(-5px);
  }
  .metric-card.highlight {
    background: rgba(59, 130, 246, 0.1);
    border-color: rgba(59, 130, 246, 0.3);
  }
  .metric-card.glowing {
    background: rgba(16, 185, 129, 0.1);
    border-color: rgba(16, 185, 129, 0.4);
    box-shadow: 0 0 30px rgba(16, 185, 129, 0.2);
  }
  .metric-label {
    font-size: 0.9rem;
    color: #9ca3af;
    margin-bottom: 0.5rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .metric-value {
    font-size: 2.25rem;
    font-weight: 800;
    color: #ffffff;
    line-height: 1;
  }
  .metric-card.glowing .metric-value {
    color: #34d399;
  }
  .metric-unit {
    font-size: 1.1rem;
    font-weight: 500;
    color: #d1d5db;
  }

  /* JOIN BANNER STYLES */
  .join-banner {
    background: white;
    border-radius: 16px;
    padding: 2rem 2.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
    border: 1px solid var(--color-border);
    position: relative;
    z-index: 10;
    flex-wrap: wrap;
    gap: 1.5rem;
  }
  @media (prefers-color-scheme: dark) {
    .join-banner {
      background: var(--color-bg-alt);
      box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
    }
  }
  .join-banner-text h3 {
    margin: 0 0 0.5rem 0;
    font-size: 1.5rem;
  }
  .join-banner-text p {
    margin: 0;
    color: var(--color-gray);
    font-size: 1rem;
  }
  .join-banner-action {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  .btn-dark {
    background: var(--color-text);
    color: var(--color-bg);
    padding: 0.6rem 1.25rem;
    border-radius: 6px;
    font-weight: 500;
    text-decoration: none;
    border: none;
    cursor: pointer;
    font-size: 1rem;
  }
  .btn-dark:hover {
    opacity: 0.9;
  }

  /* TABLE STYLES */
  .tokenrank-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 1rem;
  }
  .tokenrank-table th {
    text-align: left;
    padding: 1rem;
    border-bottom: 2px solid var(--color-border);
    color: var(--color-gray);
    font-size: 0.9rem;
    font-weight: 500;
  }
  .tokenrank-table td {
    padding: 1rem;
    border-bottom: 1px solid var(--color-border);
    vertical-align: middle;
  }
  .rank-num {
    font-size: 1.25rem;
    font-weight: bold;
    color: var(--color-gray);
  }
  .rank-user {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .rank-avatar {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    object-fit: cover;
  }
  .rank-details {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .badge {
    padding: 0.35rem 0.6rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 600;
  }
  .badge.cursor { background: rgba(56, 189, 248, 0.1); color: #0284c7; }
  .badge.claude { background: rgba(245, 158, 11, 0.1); color: #d97706; }
  .badge.codex { background: rgba(34, 197, 94, 0.1); color: #15803d; }
  .badge.antigravity { background: rgba(168, 85, 247, 0.1); color: #7e22ce; }
  .badge.openclaw { background: rgba(239, 68, 68, 0.1); color: #b91c1c; }
  .badge.hermes { background: rgba(236, 72, 153, 0.1); color: #be185d; }
  .badge.kimi { background: rgba(249, 115, 22, 0.1); color: #c2410c; }
  .badge.qorder { background: rgba(14, 165, 233, 0.1); color: #0369a1; }
  .badge.workbuddy { background: rgba(20, 184, 166, 0.1); color: #0f766e; }
  .rank-total {
    font-size: 1.15rem;
    color: var(--color-primary);
  }
  
  .rank-row-wrapper:hover {
    background-color: var(--color-bg-alt);
    transition: background-color 0.2s;
  }
  
  @media (prefers-color-scheme: dark) {
    .badge.cursor { color: #38bdf8; }
    .badge.claude { color: #f59e0b; }
    .badge.codex { color: #4ade80; }
    .badge.antigravity { color: #c084fc; }
    .badge.openclaw { color: #f87171; }
    .badge.hermes { color: #f472b6; }
    .badge.kimi { color: #fb923c; }
    .badge.qorder { color: #38bdf8; }
    .badge.workbuddy { color: #2dd4bf; }
  }

  @media (max-width: 768px) {
    .hero-title { font-size: 2.5rem; }
    .metric-value { font-size: 1.75rem; }
    .join-banner { flex-direction: column; text-align: center; }
  }
</style>
