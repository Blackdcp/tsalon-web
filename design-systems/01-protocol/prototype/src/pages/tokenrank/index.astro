---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareModal from '../../components/ShareModal.astro';
import { getSession } from 'auth-astro/server';
import { getLeaderboard, getGlobalStats } from '../../lib/kv';

// Opt-out of static rendering for real-time leaderboard
export const prerender = false;

const timeFilter = Astro.url.searchParams.get('time') || '30d';
const modeFilter = Astro.url.searchParams.get('mode') || 'withcache';

let leaderboard: any[] = [];
let stats = { totalUsers: 0, totalTokens: 0 };
try {
  leaderboard = await getLeaderboard(100, timeFilter);
  stats = await getGlobalStats(leaderboard);
} catch (e) {
  console.error('Failed to fetch leaderboard data:', e);
}

let session: any = null;
let currentUser = null;
let currentUserRank = 0;

try {
  session = await getSession(Astro.request);
  if (session?.user) {
    // Find user in leaderboard
    const userIndex = leaderboard.findIndex(u => u.name === session.user.name); // Using name as fallback, ideally user id
    if (userIndex !== -1) {
      currentUser = leaderboard[userIndex];
      currentUserRank = userIndex + 1;
    }
  }
} catch(e) {}

const seoJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'T Salon Token 排行榜',
  description: '全网 AI 开发者 Token 消耗风云榜，实时统计各路大神的本地 AI 代码生成量。'
};

const PRICING: Record<string, { in: number, out: number, cache: number }> = {
  'gpt-5.6-sol': { in: 5, out: 30, cache: 0.5 },
  'gemini-2.5-pro': { in: 2, out: 12, cache: 0.2 },
  'claude-3-5-sonnet': { in: 2, out: 10, cache: 0.2 },
  'default': { in: 0.5, out: 2, cache: 0.075 }
};

const getToolEstimatedCost = (tool: string, tokens: number) => {
  let model = 'default';
  let cacheRate = 0.5;
  if (tool === 'cursor' || tool === 'codex' || tool === 'codex_proxy') {
    model = 'gpt-5.6-sol';
    cacheRate = 0.93;
  } else if (tool === 'antigravity') {
    model = 'gemini-2.5-pro';
    cacheRate = 0.1;
  } else if (tool === 'claude') {
    model = 'claude-3-5-sonnet';
    cacheRate = 0.8;
  }
  const p = PRICING[model] || PRICING['default'];
  const millions = tokens / 1_000_000;
  const cacheHitTokens = millions * cacheRate;
  const freshTokens = millions * (1 - cacheRate);
  return (cacheHitTokens * p.cache) + (freshTokens * (0.9 * p.in + 0.1 * p.out));
};

const getToolNoCache = (tool: string, tokens: number) => {
  let cacheRate = 0.5;
  if (tool === 'cursor' || tool === 'codex' || tool === 'codex_proxy') cacheRate = 0.93;
  else if (tool === 'antigravity') cacheRate = 0.1;
  else if (tool === 'claude') cacheRate = 0.8;
  return tokens * (1 - cacheRate);
};

const formatDisplayAmount = (num: number, mode: string) => {
  if (mode === 'cost') return '$' + num.toFixed(2);
  if (num >= 100_000_000) return (num / 100_000_000).toFixed(2) + '亿';
  if (num >= 10_000) return (num / 10_000).toFixed(1) + '万';
  return num.toFixed(0);
};

const formatAmountStr = (num: number) => {
  if (num >= 100_000_000) return (num / 100_000_000).toFixed(2) + '亿';
  if (num >= 10_000) return (num / 10_000).toFixed(1) + '万';
  return num.toString();
};

// --- Calculate Dynamic Global Metrics for Dashboard ---
let globalTokens = 0;
let globalCost = 0;
let globalNoCacheCost = 0;
let globalCacheHitTokens = 0;
const toolCounts: Record<string, number> = {};

leaderboard.forEach(user => {
  Object.entries(user.tokens).forEach(([tool, amount]: [string, any]) => {
    if (tool === 'total') return;
    toolCounts[tool] = (toolCounts[tool] || 0) + 1;
    
    const cost = getToolEstimatedCost(tool, amount);
    globalCost += cost;
    
    let cacheRate = 0.5;
    if (tool === 'cursor' || tool === 'codex' || tool === 'codex_proxy') cacheRate = 0.93;
    else if (tool === 'antigravity') cacheRate = 0.1;
    else if (tool === 'claude') cacheRate = 0.8;
    
    const cacheTokens = amount * cacheRate;
    globalCacheHitTokens += cacheTokens;
    
    let model = 'default';
    if (tool === 'cursor' || tool === 'codex' || tool === 'codex_proxy') model = 'gpt-5.6-sol';
    else if (tool === 'antigravity') model = 'gemini-2.5-pro';
    else if (tool === 'claude') model = 'claude-3-5-sonnet';
    const p = PRICING[model] || PRICING['default'];
    
    const millions = amount / 1_000_000;
    const noCacheCost = millions * (0.9 * p.in + 0.1 * p.out);
    globalNoCacheCost += noCacheCost;
  });
  globalTokens += user.tokens.total;
});

const cacheSavings = globalNoCacheCost - globalCost;
const globalCacheHitRate = globalTokens > 0 ? ((globalCacheHitTokens / globalTokens) * 100).toFixed(1) : '0.0';
const activeToolsCount = Object.keys(toolCounts).length;
const conversations = Math.floor(globalTokens / 4000);
const effectiveTokens = globalTokens - globalCacheHitTokens;
let topTool = 'codex';
let maxCount = 0;
Object.entries(toolCounts).forEach(([tool, count]) => {
  if (count > maxCount) { maxCount = count; topTool = tool; }
});
---

<BaseLayout alternatePath="/tokenrank/" title="Token 排行榜 — T Salon" description="全网 AI 开发者 Token 消耗风云榜，实时统计各路大神的本地 AI 代码生成量。" image="/images/home-community-group.webp" jsonLd={seoJsonLd}>
  <main class="container page-content">
    
    <header class="page-title" style="margin-bottom: 1rem; border-bottom: none; padding-bottom: 0;">
      <div class="page-title-main">
        <h1>Token 排行榜</h1>
      </div>
      <div class="page-title-side">
        <span class="mono">STATS / TOKEN RANK</span>
      </div>

    </header>

    <!-- Bento Grid Dashboard -->
    <div class="bento-grid">
      <!-- Card 1 -->
      <div class="bento-card">
        <div class="bc-header">
          <span class="bc-title">{timeFilter === 'all' ? '历史' : `近${timeFilter.replace('d', '天')}`}消耗 <span class="help-icon">?</span></span>
          {timeFilter !== 'today' && <span class="bc-trend positive">+558%</span>}
        </div>
        <div class="bc-value">
          {formatDisplayAmount(globalTokens, modeFilter).replace('亿', '').replace('万', '')}
          {formatDisplayAmount(globalTokens, modeFilter).includes('亿') ? <span class="bc-unit">亿</span> : formatDisplayAmount(globalTokens, modeFilter).includes('万') ? <span class="bc-unit">万</span> : ''}
        </div>
        <div class="bc-subtext">日均约 {(globalTokens / 100_000_000 / 30).toFixed(1)} 亿</div>
      </div>

      <!-- Card 2 -->
      <div class="bento-card">
        <div class="bc-header">
          <span class="bc-title">预估成本 <span class="help-icon">?</span></span>
        </div>
        <div class="bc-value">
          <span class="bc-unit-prefix">$</span>{globalCost.toLocaleString(undefined, {maximumFractionDigits: 0})}
        </div>
        <div class="bc-subtext">缓存节省 ${cacheSavings.toLocaleString(undefined, {maximumFractionDigits: 0})}</div>
      </div>

      <!-- Card 3 -->
      <div class="bento-card">
        <div class="bc-header">
          <span class="bc-title">有效 token <span class="help-icon">?</span></span>
          <span class="bc-trend positive">+473%</span>
        </div>
        <div class="bc-value">
          {(effectiveTokens / 10000).toFixed(1)} <span class="bc-unit">万</span>
        </div>
        <div class="bc-subtext">占 {(globalTokens > 0 ? (effectiveTokens / globalTokens) * 100 : 0).toFixed(1)}%</div>
      </div>

      <!-- Card 4 -->
      <div class="bento-card">
        <div class="bc-header">
          <span class="bc-title">对话次数 <span class="help-icon">?</span></span>
          <span class="bc-trend positive">+67%</span>
        </div>
        <div class="bc-value">
          {conversations.toLocaleString()} <span class="bc-unit">次</span>
        </div>
        <div class="bc-subtext">次均 4,000 tokens</div>
      </div>

      <!-- Card 5 -->
      <div class="bento-card">
        <div class="bc-header">
          <span class="bc-title">使用工具 <span class="help-icon">?</span></span>
        </div>
        <div class="bc-value">
          {activeToolsCount} <span class="bc-unit">个</span>
        </div>
        <div class="bc-subtext">主力 {topTool}</div>
      </div>

      <!-- Card 6 -->
      <div class="bento-card">
        <div class="bc-header">
          <span class="bc-title">AI 耗时 <span class="help-icon">?</span></span>
          <span class="bc-trend positive">+785%</span>
        </div>
        <div class="bc-value">
          {(globalTokens / 10_000_000).toFixed(1)} <span class="bc-unit">小时</span>
        </div>
        <div class="bc-subtext">日均 {(globalTokens / 10_000_000 / 30).toFixed(1)} 小时</div>
      </div>

      <!-- Card 7 -->
      <div class="bento-card">
        <div class="bc-header">
          <span class="bc-title">缓存命中 <span class="help-icon">?</span></span>
        </div>
        <div class="bc-value">
          {globalCacheHitRate} <span class="bc-unit">%</span>
        </div>
        <div class="bc-subtext">缓存读 {formatAmountStr(globalCacheHitTokens)}</div>
      </div>

      <!-- Card 8 -->
      <div class="bento-card">
        <div class="bc-header">
          <span class="bc-title">连续活跃 <span class="help-icon">?</span></span>
        </div>
        <div class="bc-value">
          {stats.totalUsers} <span class="bc-unit">人</span>
        </div>
        <div class="bc-subtext">接入以来 45 天</div>
      </div>
    </div>

    <!-- Time Filters moved below the Bento Grid -->
    <div class="filter-panel-premium">
      <div class="time-filter-pills">
        <a href={`?time=today&mode=${modeFilter}`} class={`pill-item ${timeFilter === 'today' ? 'active' : ''}`}>今天</a>
        <a href={`?time=3d&mode=${modeFilter}`} class={`pill-item ${timeFilter === '3d' ? 'active' : ''}`}>近 3 天</a>
        <a href={`?time=7d&mode=${modeFilter}`} class={`pill-item ${timeFilter === '7d' ? 'active' : ''}`}>近 7 天</a>
        <a href={`?time=30d&mode=${modeFilter}`} class={`pill-item ${timeFilter === '30d' ? 'active' : ''}`}>近 30 天</a>
        <a href={`?time=90d&mode=${modeFilter}`} class={`pill-item ${timeFilter === '90d' ? 'active' : ''}`}>近 90 天</a>
        <a href={`?time=all&mode=${modeFilter}`} class={`pill-item ${timeFilter === 'all' ? 'active' : ''}`}>全部</a>
      </div>
      
      <div class="date-display">
        {new Date().toISOString().split('T')[0]}
      </div>
    </div>

    <div class="leaderboard-list">
      
      <!-- Table Headers (Desktop Only) -->
      <div class="lb-header-row">
        <div class="lb-h-left">
          <div class="lb-h-rank">排名</div>
          <div class="lb-h-name">T友</div>
          <div class="lb-h-details">消耗详情 (多端工具)</div>
        </div>
        <div class="lb-h-right">总 {modeFilter === 'cost' ? '花费' : 'Tokens'}</div>
      </div>
      
      <!-- Current User Section -->
      {currentUser ? (
        <div class="lb-card user-highlight-card">
          <div class="lb-card-left">
            <div class="lb-avatar-wrapper">
              <img src={currentUser.image} alt={currentUser.name} class="lb-avatar" crossorigin="anonymous" />
            </div>
            <div class="lb-user-info">
              <div class="lb-name-row">
                <strong>{currentUser.name}</strong> <span class="tag-me">我</span>
              </div>
              <div class="lb-details-row">
                {(currentUser.tokens.total / 100000000).toFixed(2)}亿 tokens · {Object.keys(currentUser.tokens).length - 1} 个工具
              </div>
            </div>
          </div>
          <div class="lb-card-right">
            <div class="lb-highlight-rank">#{currentUserRank}</div>
            <button class="btn-share" onclick="openShareModal()">分享</button>
          </div>
        </div>
      ) : (
        <div class="lb-card user-onboard-card">
          <div class="lb-card-left">
            <div class="lb-user-info">
              <div class="lb-name-row">
                <strong>你尚未登榜</strong>
              </div>
              <div class="lb-details-row">
                将 GitHub 账号与本地环境绑定，运行专属提取脚本即可快速上榜。
              </div>
            </div>
          </div>
          <div class="lb-card-right">
            <a href="/tokenrank/connect/" class="btn-onboard">绑定 GitHub 上榜 ↗</a>
          </div>
        </div>
      )}

      <!-- Main Leaderboard -->
      {leaderboard.length === 0 ? (
        <div class="content-section" style="margin-top: 1rem;"><p>该时间段内暂无数据，快去抢首发吧！</p></div>
      ) : (
        leaderboard.map((user, idx) => {
          let userTotalEstimatedCost = 0;
          let userTotalDisplay = 0;
          
          const toolsBreakdown = Object.entries(user.tokens)
            .filter(([k]) => k !== 'total')
            .map(([tool, amount]: [string, any]) => {
              const cost = getToolEstimatedCost(tool, amount);
              const noCacheTokens = getToolNoCache(tool, amount);
              userTotalEstimatedCost += cost;
              
              let displayAmount = amount;
              if (modeFilter === 'nocache') displayAmount = noCacheTokens;
              else if (modeFilter === 'cost') displayAmount = cost;
              
              userTotalDisplay += displayAmount;
              return { tool, amount: displayAmount };
            });

          return (
            <div class="lb-card" onclick={`window.location.href='/tokenrank/user/${user.userId}'`}>
              <div class="lb-card-left">
                <div class="lb-rank">
                  {idx === 0 ? <div class="rank-badge gold">1</div> : 
                   idx === 1 ? <div class="rank-badge silver">2</div> : 
                   idx === 2 ? <div class="rank-badge bronze">3</div> : 
                   <div class="rank-badge normal">{idx + 1}</div>}
                </div>
                <div class="lb-avatar-wrapper">
                  <img src={user.image} alt={user.name} class="lb-avatar" crossorigin="anonymous" />
                </div>
                <div class="lb-user-info">
                  <div class="lb-name-row">
                    <strong>{user.name}</strong>
                  </div>
                  <div class="lb-details-row">
                    {toolsBreakdown.map(({ tool, amount }) => {
                      const toolName = tool.charAt(0).toUpperCase() + tool.slice(1);
                      let tagClass = 'tag-default';
                      const t = tool.toLowerCase();
                      if (t.includes('codex')) tagClass = 'tag-codex';
                      else if (t.includes('antigravity')) tagClass = 'tag-antigravity';
                      else if (t.includes('cherry')) tagClass = 'tag-cherry';
                      else if (t.includes('claude')) tagClass = 'tag-claude';
                      return <span class={`tool-tag ${tagClass}`}>{toolName} {formatDisplayAmount(amount, modeFilter)}</span>;
                    })}
                  </div>
                </div>
              </div>
              <div class="lb-card-right">
                <div class="lb-totals">
                  <div class="lb-total-tokens">{formatDisplayAmount(userTotalDisplay, modeFilter)}</div>
                  {modeFilter !== 'cost' && <div class="lb-total-cost">≈${userTotalEstimatedCost.toFixed(0)}</div>}
                </div>
              </div>
            </div>
          );
        })
      )}
    </div>

    <!-- Floating Onboarding Widget (Bottom Pill) -->
    <a href="/tokenrank/connect/" class="floating-pill-widget">
      <span class="fp-icon">🚀</span>
      <span class="fp-text">尚未登榜？</span>
      <span class="fp-cta">立即接入统计 &rarr;</span>
    </a>

  </main>

  <ShareModal leaderboard={leaderboard} currentUser={currentUser} currentUserRank={currentUserRank} />
</BaseLayout>

<style>
  .page-content {
    padding-top: 2rem;
    padding-bottom: 4rem;
  }

  .filter-panel-premium {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    width: 100%;
  }

  .time-filter-pills {
    display: flex;
    gap: 0.5rem;
  }

  .pill-item {
    padding: 0.35rem 1rem;
    border-radius: 20px;
    font-size: 0.85rem;
    color: #999;
    background: #fff;
    border: 1px solid #eaeaea;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .pill-item:hover {
    border-color: #ccc;
    color: #333;
  }

  .pill-item.active {
    background: #f8f9fa;
    color: #111;
    font-weight: 600;
    border-color: #e2e8f0;
    box-shadow: 0 1px 2px rgba(0,0,0,0.02);
  }

  .date-display {
    font-size: 0.85rem;
    color: #999;
    font-weight: 500;
  }

  /* Bento Grid Dashboard - Exact Match */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin-bottom: 2rem;
  }
  
  .bento-card {
    background: #fff;
    border: 1px solid #f0f0f0;
    border-radius: 8px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 124px;
    box-shadow: 0 1px 2px rgba(0,0,0,0.01);
  }

  .bc-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }
  
  .bc-title {
    font-size: 13px;
    color: #999;
    display: flex;
    align-items: center;
    gap: 4px;
    font-weight: 400;
  }
  
  .help-icon {
    font-size: 11px;
    color: #ccc;
    font-weight: normal;
    font-style: normal;
  }
  
  .bc-trend {
    font-size: 12px;
    font-weight: 700;
  }
  .bc-trend.positive { color: #10B981; }

  .bc-value {
    font-size: 30px;
    font-weight: 700;
    color: #1c1c1e;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol";
    line-height: 1;
    display: flex;
    align-items: baseline;
    letter-spacing: -0.5px;
    margin-bottom: 8px;
  }
  
  .bc-unit {
    font-size: 13px;
    font-weight: 500;
    color: #1c1c1e;
    margin-left: 4px;
    letter-spacing: 0;
  }
  
  .bc-unit-prefix {
    font-size: 16px;
    font-weight: 500;
    margin-right: 2px;
    color: #666;
  }

  .bc-subtext {
    font-size: 12px;
    color: #999;
    margin-top: 0;
    font-weight: 400;
  }

  @media (prefers-color-scheme: dark) {
    .bento-card {
      background: #111;
      border-color: #333;
    }
    .bc-value, .bc-unit { color: #fff; }
    .pill-item { background: #111; border-color: #333; color: #888; }
    .pill-item.active { background: #222; color: #fff; border-color: #444; }
  }

  /* Table Headers */
  .lb-header-row {
    display: flex;
    justify-content: space-between;
    padding: 0 1.5rem 0.75rem 1.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--color-gray);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 0.5rem;
  }
  
  .lb-h-left {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex: 1;
  }

  .lb-h-rank { width: 50px; text-align: center; }
  .lb-h-name { width: 170px; }
  .lb-h-details { flex: 1; }
  .lb-h-right { text-align: right; width: 120px; }

  /* Leaderboard List */
  .leaderboard-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .lb-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    border-radius: 12px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    transition: all 0.2s ease;
    cursor: pointer;
  }
  .lb-card:hover {
    background: var(--color-bg-alt);
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0,0,0,0.06);
    border-color: var(--color-gray);
  }

  .lb-card-left {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex: 1;
  }

  .lb-rank {
    width: 50px;
    display: flex;
    justify-content: center;
  }
  
  .rank-badge {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    font-weight: 800;
    font-size: 1rem;
    color: var(--color-text);
  }
  
  .rank-badge.gold {
    background: linear-gradient(135deg, #FFD700 0%, #F59E0B 100%);
    color: #fff;
    box-shadow: 0 4px 10px rgba(245, 158, 11, 0.3);
  }
  .rank-badge.silver {
    background: linear-gradient(135deg, #E2E8F0 0%, #94A3B8 100%);
    color: #1E293B;
    box-shadow: 0 4px 10px rgba(148, 163, 184, 0.3);
  }
  .rank-badge.bronze {
    background: linear-gradient(135deg, #FDBA74 0%, #D97706 100%);
    color: #fff;
    box-shadow: 0 4px 10px rgba(217, 119, 6, 0.3);
  }
  .rank-badge.normal {
    font-family: 'Inter', monospace;
    color: var(--color-gray);
    font-size: 1.1rem;
  }

  .lb-avatar-wrapper {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    padding: 2px;
    background: linear-gradient(135deg, var(--color-border) 0%, transparent 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .lb-avatar {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .lb-user-info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    flex: 1;
  }

  .lb-name-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-text);
    width: 150px;
  }

  .tag-me {
    background: var(--color-text);
    color: var(--color-bg);
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    border-radius: 20px;
