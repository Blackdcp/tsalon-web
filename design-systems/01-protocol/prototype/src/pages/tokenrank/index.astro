---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareModal from '../../components/ShareModal.astro';
import { getSession } from 'auth-astro/server';
import { getLeaderboard, getGlobalStats } from '../../lib/kv';

// Opt-out of static rendering for real-time leaderboard
export const prerender = false;

let leaderboard: any[] = [];
let stats = { totalUsers: 0, totalTokens: 0 };
try {
  leaderboard = await getLeaderboard(100);
  stats = await getGlobalStats();
} catch (e) {
  console.error('Failed to fetch leaderboard data:', e);
}

let session: any = null;
let currentUser = null;
let currentUserRank = 0;

try {
  session = await getSession(Astro.request);
  if (session?.user) {
    // Find user in leaderboard
    const userIndex = leaderboard.findIndex(u => u.name === session.user.name); // Using name as fallback, ideally user id
    if (userIndex !== -1) {
      currentUser = leaderboard[userIndex];
      currentUserRank = userIndex + 1;
    }
  }
} catch(e) {}

const seoJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'T Salon Token 排行榜',
  description: '全网 AI 开发者 Token 消耗风云榜，实时统计各路大神的本地 AI 代码生成量。'
};
---

<BaseLayout alternatePath="/tokenrank/" title="Token 排行榜 — T Salon" description="全网 AI 开发者 Token 消耗风云榜，实时统计各路大神的本地 AI 代码生成量。" image="/images/home-community-group.webp" jsonLd={seoJsonLd}>
  <main>
    <header class="container page-title">
      <div class="page-title-main">
        <div class="event-page-status is-open"><span aria-hidden="true">●</span>活跃中</div>
        <h1>Token 排行榜</h1>
        <p class="lead">开发者本地 AI 编码能耗大比拼</p>
      </div>
      <div class="page-title-side">
        <span class="mono">STATS / TOKEN RANK</span>
      </div>
      <div class="page-title-main event-quickfacts">
        <div class="quickfact"><span class="mono">参与总人数</span><strong>{stats.totalUsers} 人</strong></div>
        <div class="quickfact"><span class="mono">全员总消耗</span><strong>{(stats.totalTokens / 100000000).toFixed(2)} 亿 Tokens</strong></div>
        <div class="quickfact"><span class="mono">预计总花费</span><strong>≈ ${(stats.totalTokens / 1000000 * 3).toFixed(0)}</strong></div>
        <button class="btn btn-blue" onclick="openShareModal()" style="padding: 0.5rem 1rem; border: none; border-radius: 8px; cursor: pointer; align-self: center;">分享榜单 ↗</button>
      </div>
    </header>

    <div class="container content-container" style="display: flex; flex-direction: column;">
      <div class="event-main" style="width: 100%;">
        {leaderboard.length === 0 ? (
          <div class="content-section"><p>暂时还没有人上榜，快去抢首发吧！</p></div>
        ) : (
          <table class="tokenrank-table">
            <thead>
              <tr>
                <th>排名</th>
                <th>开发者</th>
                <th>消耗详情 (多端工具)</th>
                <th>总 Tokens</th>
              </tr>
            </thead>
            <tbody>
              {leaderboard.map((user, idx) => (
                <tr class="rank-row-wrapper" onclick={`window.location.href='/tokenrank/user/${user.userId}'`} style="cursor: pointer;">
                  <td class="rank-num">
                    {idx === 0 ? '🥇' : idx === 1 ? '🥈' : idx === 2 ? '🥉' : idx + 1}
                  </td>
                  <td>
                    <div class="rank-user">
                      <img src={user.image} alt={user.name} class="rank-avatar" />
                      <strong>{user.name}</strong>
                    </div>
                  </td>
                  <td class="rank-details">
                    {Object.entries(user.tokens).filter(([k]) => k !== 'total').map(([tool, amount]: [string, any]) => (
                      <span class={`badge ${tool}`}>
                        {tool.charAt(0).toUpperCase() + tool.slice(1)} {amount >= 10000 ? (amount / 10000).toFixed(0) + 'w' : amount}
                      </span>
                    ))}
                  </td>
                  <td class="rank-total">
                    <strong>{(user.tokens.total / 100000000).toFixed(2)} 亿</strong>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </div>

      <aside class="registration-panel" style="margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--color-border); width: 100%; max-width: 800px; margin-left: auto; margin-right: auto; text-align: center;">
        <h3 style="font-size: 1.5rem; margin-bottom: 1rem;">如何上榜？</h3>
        <p style="margin-bottom: 2rem; color: var(--color-gray);">上榜需要将你的 GitHub 账号与本地环境绑定，运行专属提取脚本。</p>
        <a class="btn btn-blue" href="/tokenrank/connect/" style="display: inline-block; padding: 1rem 3rem; font-size: 1.1rem;">生成专属接入命令 <span>↗</span></a>
        
        <div class="tokenrank-note" style="margin-top: 3rem; text-align: left; background: var(--color-bg-alt); padding: 2rem; border-radius: 8px;">
          <h4 style="margin-bottom: 1rem;">支持统计的工具</h4>
          <ul style="margin-bottom: 1.5rem; line-height: 1.6;">
            <li><strong>IDE 级</strong>: Cursor, Claude Code, Codex, Kimi, 通义灵码, Workbuddy</li>
            <li><strong>Agent 级</strong>: Antigravity, OpenClaw (小龙虾), Hermes</li>
          </ul>
          <p style="font-size: 0.85rem; color: var(--color-gray);">*我们致力于保护隐私，提取脚本完全开源且仅在本地计算使用量，绝不上报代码内容。</p>
        </div>
      </aside>
    </div>
  </main>

  <ShareModal leaderboard={leaderboard} currentUser={currentUser} currentUserRank={currentUserRank} />
</BaseLayout>

<style>
  .tokenrank-table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 2rem;
  }
  .tokenrank-table th {
    text-align: left;
    padding: 1rem;
    border-bottom: 2px solid var(--color-border);
    color: var(--color-gray);
    font-size: 0.9rem;
    font-weight: 500;
  }
  .tokenrank-table td {
    padding: 1rem;
    border-bottom: 1px solid var(--color-border);
    vertical-align: middle;
  }
  .rank-num {
    font-size: 1.25rem;
    font-weight: bold;
    color: var(--color-gray);
  }
  .rank-user {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .rank-avatar {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    object-fit: cover;
  }
  .rank-details {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .badge {
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 600;
  }
  .badge.cursor { background: rgba(56, 189, 248, 0.1); color: #0284c7; }
  .badge.claude { background: rgba(245, 158, 11, 0.1); color: #d97706; }
  .badge.codex { background: rgba(34, 197, 94, 0.1); color: #15803d; }
  .badge.antigravity { background: rgba(168, 85, 247, 0.1); color: #7e22ce; }
  .badge.openclaw { background: rgba(239, 68, 68, 0.1); color: #b91c1c; }
  .badge.hermes { background: rgba(236, 72, 153, 0.1); color: #be185d; }
  .badge.kimi { background: rgba(249, 115, 22, 0.1); color: #c2410c; }
  .badge.qorder { background: rgba(14, 165, 233, 0.1); color: #0369a1; }
  .badge.workbuddy { background: rgba(20, 184, 166, 0.1); color: #0f766e; }
  .rank-total {
    font-size: 1.1rem;
    color: var(--color-primary);
  }
  
  .rank-row-wrapper:hover {
    background-color: var(--color-bg-alt);
    transition: background-color 0.2s;
  }
  
  @media (prefers-color-scheme: dark) {
    .badge.cursor { color: #38bdf8; }
    .badge.claude { color: #f59e0b; }
    .badge.codex { color: #4ade80; }
    .badge.antigravity { color: #c084fc; }
    .badge.openclaw { color: #f87171; }
    .badge.hermes { color: #f472b6; }
    .badge.kimi { color: #fb923c; }
    .badge.qorder { color: #38bdf8; }
    .badge.workbuddy { color: #2dd4bf; }
  }
</style>
