---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShareModal from '../../components/ShareModal.astro';
import { getSession } from 'auth-astro/server';
import { getLeaderboard, getGlobalStats } from '../../lib/kv';

// Opt-out of static rendering for real-time leaderboard
export const prerender = false;

const timeFilter = Astro.url.searchParams.get('time') || '30d';
const modeFilter = Astro.url.searchParams.get('mode') || 'withcache';

let leaderboard: any[] = [];
let stats = { totalUsers: 0, totalTokens: 0 };
try {
  leaderboard = await getLeaderboard(100, timeFilter);
  stats = await getGlobalStats(leaderboard); // Pass filtered leaderboard to get accurate stats
} catch (e) {
  console.error('Failed to fetch leaderboard data:', e);
}

let session: any = null;
let currentUser = null;
let currentUserRank = 0;

try {
  session = await getSession(Astro.request);
  if (session?.user) {
    // Find user in leaderboard
    const userIndex = leaderboard.findIndex(u => u.name === session.user.name); // Using name as fallback, ideally user id
    if (userIndex !== -1) {
      currentUser = leaderboard[userIndex];
      currentUserRank = userIndex + 1;
    }
  }
} catch(e) {}

const seoJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'T Salon Token 排行榜',
  description: '全网 AI 开发者 Token 消耗风云榜，实时统计各路大神的本地 AI 代码生成量。'
};

const PRICING: Record<string, { in: number, out: number, cache: number }> = {
  'gpt-5.6-sol': { in: 5, out: 30, cache: 0.5 },
  'gemini-2.5-pro': { in: 2, out: 12, cache: 0.2 },
  'claude-3-5-sonnet': { in: 2, out: 10, cache: 0.2 },
  'default': { in: 0.5, out: 2, cache: 0.075 }
};

const getToolEstimatedCost = (tool: string, tokens: number) => {
  let model = 'default';
  let cacheRate = 0.5;
  if (tool === 'cursor' || tool === 'codex' || tool === 'codex_proxy') {
    model = 'gpt-5.6-sol';
    cacheRate = 0.93;
  } else if (tool === 'antigravity') {
    model = 'gemini-2.5-pro';
    cacheRate = 0.1;
  } else if (tool === 'claude') {
    model = 'claude-3-5-sonnet';
    cacheRate = 0.8;
  }
  const p = PRICING[model] || PRICING['default'];
  const millions = tokens / 1_000_000;
  const cacheHitTokens = millions * cacheRate;
  const freshTokens = millions * (1 - cacheRate);
  return (cacheHitTokens * p.cache) + (freshTokens * (0.9 * p.in + 0.1 * p.out));
};

const getToolNoCache = (tool: string, tokens: number) => {
  let cacheRate = 0.5;
  if (tool === 'cursor' || tool === 'codex' || tool === 'codex_proxy') cacheRate = 0.93;
  else if (tool === 'antigravity') cacheRate = 0.1;
  else if (tool === 'claude') cacheRate = 0.8;
  return tokens * (1 - cacheRate);
};

const formatDisplayAmount = (num: number, mode: string) => {
  if (mode === 'cost') return '$' + num.toFixed(2);
  if (num >= 100_000_000) return (num / 100_000_000).toFixed(2) + '亿';
  if (num >= 10_000) return (num / 10_000).toFixed(1) + '万';
  return num.toFixed(0);
};

const formatAmountStr = (num: number) => {
  if (num >= 100_000_000) return (num / 100_000_000).toFixed(2) + '亿';
  if (num >= 10_000) return (num / 10_000).toFixed(1) + '万';
  return num.toString();
};
---

<BaseLayout alternatePath="/tokenrank/" title="Token 排行榜 — T Salon" description="全网 AI 开发者 Token 消耗风云榜，实时统计各路大神的本地 AI 代码生成量。" image="/images/home-community-group.webp" jsonLd={seoJsonLd}>
  <main class="container page-content">
    
    <header class="page-title" style="margin-bottom: 1rem; border-bottom: none; padding-bottom: 0;">
      <div class="page-title-main">
        <h1>Token 排行榜</h1>
      </div>
      <div class="page-title-side">
        <span class="mono">STATS / TOKEN RANK</span>
      </div>
    </header>

    <!-- Hero Stats Dashboard -->
    <div class="hero-stats-panel">
      <div class="hero-stat-card primary-stat">
        <div class="stat-label">{timeFilter === 'all' ? '全史' : timeFilter === 'today' ? '今天' : timeFilter === 'yesterday' ? '昨天' : `近${timeFilter.replace('d', '天')}`}全员累计消耗</div>
        <div class="stat-value gradient-text">
          {formatDisplayAmount(stats.totalTokens, modeFilter)} {modeFilter === 'cost' ? '' : '<span class="unit">tokens</span>'}
        </div>
      </div>
      <div class="hero-stat-card secondary-stats">
        <div class="stat-label">参与黑客</div>
        <div class="stat-value">{stats.totalUsers}</div>
      </div>
      <div class="hero-stat-card secondary-stats">
        <div class="stat-label">数据规则</div>
        <div class="stat-value"><a href="#" class="rules-link">查看机制 ↗</a></div>
      </div>
    </div>

    <!-- Filters Section -->
    <div class="filter-panel-premium">
      <div class="segmented-control">
        <a href={`?time=today&mode=${modeFilter}`} class={`segment-item ${timeFilter === 'today' ? 'active' : ''}`}>今天</a>
        <a href={`?time=yesterday&mode=${modeFilter}`} class={`segment-item ${timeFilter === 'yesterday' ? 'active' : ''}`}>昨天</a>
        <a href={`?time=3d&mode=${modeFilter}`} class={`segment-item ${timeFilter === '3d' ? 'active' : ''}`}>近 3 天</a>
        <a href={`?time=7d&mode=${modeFilter}`} class={`segment-item ${timeFilter === '7d' ? 'active' : ''}`}>近 7 天</a>
        <a href={`?time=30d&mode=${modeFilter}`} class={`segment-item ${timeFilter === '30d' ? 'active' : ''}`}>近 30 天</a>
        <a href={`?time=all&mode=${modeFilter}`} class={`segment-item ${timeFilter === 'all' ? 'active' : ''}`}>全部历史</a>
      </div>
      
      <div class="segmented-control mode-control">
        <a href={`?time=${timeFilter}&mode=withcache`} class={`segment-item ${modeFilter === 'withcache' ? 'active' : ''}`}>含缓存</a>
        <a href={`?time=${timeFilter}&mode=nocache`} class={`segment-item ${modeFilter === 'nocache' ? 'active' : ''}`}>不含缓存</a>
        <a href={`?time=${timeFilter}&mode=cost`} class={`segment-item ${modeFilter === 'cost' ? 'active' : ''}`}>预估费用</a>
      </div>
    </div>

    <div class="leaderboard-list">
      
      <!-- Table Headers (Desktop Only) -->
      <div class="lb-header-row">
        <div class="lb-h-left">
          <div class="lb-h-rank">排名</div>
          <div class="lb-h-name">T友</div>
          <div class="lb-h-details">消耗详情 (多端工具)</div>
        </div>
        <div class="lb-h-right">总 {modeFilter === 'cost' ? '花费' : 'Tokens'}</div>
      </div>
      
      <!-- Current User Section -->
      {currentUser ? (
        <div class="lb-card user-highlight-card">
          <div class="lb-card-left">
            <div class="lb-avatar-wrapper">
              <img src={currentUser.image} alt={currentUser.name} class="lb-avatar" crossorigin="anonymous" />
            </div>
            <div class="lb-user-info">
              <div class="lb-name-row">
                <strong>{currentUser.name}</strong> <span class="tag-me">我</span>
              </div>
              <div class="lb-details-row">
                {(currentUser.tokens.total / 100000000).toFixed(2)}亿 tokens · {Object.keys(currentUser.tokens).length - 1} 个工具
              </div>
            </div>
          </div>
          <div class="lb-card-right">
            <div class="lb-highlight-rank">#{currentUserRank}</div>
            <button class="btn-share" onclick="openShareModal()">分享</button>
          </div>
        </div>
      ) : (
        <div class="lb-card user-onboard-card">
          <div class="lb-card-left">
            <div class="lb-user-info">
              <div class="lb-name-row">
                <strong>你尚未登榜</strong>
              </div>
              <div class="lb-details-row">
                将 GitHub 账号与本地环境绑定，运行专属提取脚本即可快速上榜。
              </div>
            </div>
          </div>
          <div class="lb-card-right">
            <a href="/tokenrank/connect/" class="btn-onboard">绑定 GitHub 上榜 ↗</a>
          </div>
        </div>
      )}

      <!-- Main Leaderboard -->
      {leaderboard.length === 0 ? (
        <div class="content-section" style="margin-top: 1rem;"><p>该时间段内暂无数据，快去抢首发吧！</p></div>
      ) : (
        leaderboard.map((user, idx) => {
          let userTotalEstimatedCost = 0;
          let userTotalDisplay = 0;
          
          const toolsBreakdown = Object.entries(user.tokens)
            .filter(([k]) => k !== 'total')
            .map(([tool, amount]: [string, any]) => {
              const cost = getToolEstimatedCost(tool, amount);
              const noCacheTokens = getToolNoCache(tool, amount);
              userTotalEstimatedCost += cost;
              
              let displayAmount = amount;
              if (modeFilter === 'nocache') displayAmount = noCacheTokens;
              else if (modeFilter === 'cost') displayAmount = cost;
              
              userTotalDisplay += displayAmount;
              return { tool, amount: displayAmount };
            });

          return (
            <div class="lb-card" onclick={`window.location.href='/tokenrank/user/${user.userId}'`}>
              <div class="lb-card-left">
                <div class="lb-rank">
                  {idx === 0 ? <div class="rank-badge gold">1</div> : 
                   idx === 1 ? <div class="rank-badge silver">2</div> : 
                   idx === 2 ? <div class="rank-badge bronze">3</div> : 
                   <div class="rank-badge normal">{idx + 1}</div>}
                </div>
                <div class="lb-avatar-wrapper">
                  <img src={user.image} alt={user.name} class="lb-avatar" crossorigin="anonymous" />
                </div>
                <div class="lb-user-info">
                  <div class="lb-name-row">
                    <strong>{user.name}</strong>
                  </div>
                  <div class="lb-details-row">
                    {toolsBreakdown.map(({ tool, amount }) => {
                      const toolName = tool.charAt(0).toUpperCase() + tool.slice(1);
                      let tagClass = 'tag-default';
                      const t = tool.toLowerCase();
                      if (t.includes('codex')) tagClass = 'tag-codex';
                      else if (t.includes('antigravity')) tagClass = 'tag-antigravity';
                      else if (t.includes('cherry')) tagClass = 'tag-cherry';
                      else if (t.includes('claude')) tagClass = 'tag-claude';
                      return <span class={`tool-tag ${tagClass}`}>{toolName} {formatDisplayAmount(amount, modeFilter)}</span>;
                    })}
                  </div>
                </div>
              </div>
              <div class="lb-card-right">
                <div class="lb-totals">
                  <div class="lb-total-tokens">{formatDisplayAmount(userTotalDisplay, modeFilter)}</div>
                  {modeFilter !== 'cost' && <div class="lb-total-cost">≈${userTotalEstimatedCost.toFixed(0)}</div>}
                </div>
              </div>
            </div>
          );
        })
      )}
    </div>

    <!-- Onboarding Footer (Terminal Style) -->
    <div class="terminal-onboarding">
      <div class="terminal-header">
        <div class="terminal-dots">
          <span class="dot red"></span>
          <span class="dot yellow"></span>
          <span class="dot green"></span>
        </div>
        <div class="terminal-title">bash - tsalon-tokenrank</div>
      </div>
      <div class="terminal-body">
        <p class="comment"># 想要让你的 AI 编程实力在榜单上闪耀吗？只需两步：</p>
        <p class="comment"># 1. 在页面上方点击“绑定 GitHub 上榜 ↗”</p>
        <p class="comment"># 2. 复制并运行开源的终端统计脚本 (支持 macOS / Linux)</p>
        <div class="code-line">
          <span class="prompt">$</span> <code>bash &lt;(curl -s https://tsalon.tech/install.sh)</code>
        </div>
        <p class="comment margin-top"># 💡 本地拦截，隐私安全。源码公开透明，随时欢迎<a href="/tokenrank/about">查看提取原理</a>。</p>
      </div>
    </div>

  </main>

  <ShareModal leaderboard={leaderboard} currentUser={currentUser} currentUserRank={currentUserRank} />
</BaseLayout>

<style>
