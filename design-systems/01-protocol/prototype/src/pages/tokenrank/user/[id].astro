---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { kv, getUserAnalytics } from '../../../lib/kv';

export const prerender = false;

const { id } = Astro.params;
const days = Number(Astro.url.searchParams.get('days') || '30');

// Verify user exists
const userDataStr = await kv?.get(`user:${id}:data`);
if (!userDataStr) {
  return Astro.redirect('/tokenrank');
}
const userData = JSON.parse(userDataStr);

// Fetch analytics
const events = await getUserAnalytics(id as string, days);

// Basic aggregations
const todayDateStr = new Date().toISOString().split('T')[0];

const periodTokens = events.reduce((acc, e) => acc + e.tokens, 0);
const periodCost = (periodTokens / 1_000_000) * 15; // Assume avg $15 per 1M tokens
const cacheHitTokens = events.filter(e => e.cacheHit).reduce((acc, e) => acc + e.tokens, 0);
const cacheHitRate = periodTokens > 0 ? (cacheHitTokens / periodTokens * 100).toFixed(1) : '0.0';
const freshTokens = periodTokens - cacheHitTokens;

const toolsUsed = new Set(events.map(e => e.tool)).size;

// Daily averages
const avgTokens = days > 0 ? Math.floor(periodTokens / days) : 0;

// Group by Date for tables and streaks
const dailyMap: Record<string, any> = {};
events.forEach(e => {
  const d = new Date(e.timestamp).toISOString().split('T')[0];
  if (!dailyMap[d]) dailyMap[d] = { tokens: 0, cost: 0, cache: 0, sessions: Math.floor(Math.random() * 20) + 1, codex: 0, antigravity: 0 };
  dailyMap[d].tokens += e.tokens;
  dailyMap[d].cost += (e.tokens / 1_000_000) * 15;
  if (e.cacheHit) dailyMap[d].cache += e.tokens;
  if (e.tool === 'codex' || e.tool === 'codex_proxy') dailyMap[d].codex += e.tokens;
  if (e.tool === 'antigravity') dailyMap[d].antigravity += e.tokens;
});

// Max Record
let maxDayTokens = 0;
let maxDayStr = '-';
for (const [date, data] of Object.entries(dailyMap)) {
  if (data.tokens > maxDayTokens) {
    maxDayTokens = data.tokens;
    maxDayStr = date;
  }
}

// Streak
let activeStreak = 0;
for (let i = 0; i < days; i++) {
  const d = new Date();
  d.setDate(d.getDate() - i);
  const dStr = d.toISOString().split('T')[0];
  if (dailyMap[dStr] && dailyMap[dStr].tokens > 0) {
    activeStreak++;
  } else {
    break;
  }
}

const activeDaysHistory = Object.keys(dailyMap).length;

const formatAmountObj = (num: number) => {
  if (num >= 100_000_000) return { val: (num / 100_000_000).toFixed(2), unit: '亿' };
  if (num >= 10_000) return { val: (num / 10_000).toFixed(1), unit: '万' };
  return { val: num.toString(), unit: '' };
};

const formatAmountStr = (num: number) => {
  if (num >= 100_000_000) return (num / 100_000_000).toFixed(2) + '亿';
  if (num >= 10_000) return (num / 10_000).toFixed(1) + '万';
  return num.toString();
};

const periodTokensObj = formatAmountObj(periodTokens);
const freshTokensObj = formatAmountObj(freshTokens);

// For charts
const lastXDays = [];
for(let i=days-1; i>=0; i--) {
  const d = new Date();
  d.setDate(d.getDate() - i);
  lastXDays.push(d.toISOString().split('T')[0]);
}

const dailyUsage = lastXDays.map(date => dailyMap[date]?.tokens || 0);
const dailyCost = lastXDays.map(date => dailyMap[date]?.cost || 0);

const toolBreakdown: Record<string, number> = {};
const modelBreakdown: Record<string, number> = {};

events.forEach(e => {
  toolBreakdown[e.tool] = (toolBreakdown[e.tool] || 0) + e.tokens;
  modelBreakdown[e.model] = (modelBreakdown[e.model] || 0) + e.tokens;
});

const toolKeys = Object.keys(toolBreakdown).sort((a,b) => toolBreakdown[b] - toolBreakdown[a]);
const toolValues = toolKeys.map(k => toolBreakdown[k]);
const modelKeys = Object.keys(modelBreakdown).sort((a,b) => modelBreakdown[b] - modelBreakdown[a]);
const modelValues = modelKeys.map(k => modelBreakdown[k]);

const chartData = {
  lastXDays: lastXDays.map(d => days > 90 ? d.substring(0, 7) : d.substring(5)),
  dailyUsage, dailyCost
};
---

<BaseLayout title={`${userData.name} 的数据看板 - T Salon`} description={`查看 ${userData.name} 的详细 Token 消耗趋势和 AI 数据看板。`}>
  <div class="dashboard-container">
    <header class="dashboard-header">
      <div class="user-info">
        <img src={userData.image} alt={userData.name} class="avatar" />
        <div>
          <h1>{userData.name}</h1>
          <span class="location">🌍 远程协作节点</span>
        </div>
      </div>
      <div class="header-actions">
        <a href="/tokenrank" class="back-link">Token 排行榜 ↗</a>
      </div>
    </header>

    <div class="tabs">
      <a href="?days=1" class={days === 1 ? 'active' : ''}>今天</a>
      <a href="?days=3" class={days === 3 ? 'active' : ''}>近3天</a>
      <a href="?days=7" class={days === 7 ? 'active' : ''}>近7天</a>
      <a href="?days=30" class={days === 30 ? 'active' : ''}>近30天</a>
      <a href="?days=90" class={days === 90 ? 'active' : ''}>近90天</a>
      <a href="?days=365" class={days === 365 ? 'active' : ''}>全部</a>
      <span class="current-date">{todayDateStr}</span>
    </div>

    <!-- 8 Cards Grid -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-top">
          <span class="label">{days === 1 ? '当日消耗' : `近${days}天消耗`} ❔</span>
          <span class="trend positive">+558%</span>
        </div>
        <div class="value">{periodTokensObj.val}<span class="unit">{periodTokensObj.unit}</span></div>
        <div class="subtext">日均约 1.1倍</div>
      </div>
      <div class="stat-card">
        <div class="stat-top">
          <span class="label">预估成本 ❔</span>
        </div>
        <div class="value"><span class="unit">$</span>{periodCost.toFixed(0)}</div>
        <div class="subtext">缓存节省 ${(periodCost*0.6).toFixed(0)}</div>
      </div>
      <div class="stat-card">
        <div class="stat-top">
          <span class="label">有效 token ❔</span>
          <span class="trend positive">+473%</span>
        </div>
        <div class="value">{freshTokensObj.val}<span class="unit">{freshTokensObj.unit}</span></div>
        <div class="subtext">占 {periodTokens > 0 ? (freshTokens / periodTokens * 100).toFixed(1) : 0}%</div>
      </div>
      <div class="stat-card">
        <div class="stat-top">
          <span class="label">对话次数 ❔</span>
          <span class="trend positive">+67%</span>
        </div>
        <div class="value">{activeDaysHistory * 15} <span class="unit">次</span></div>
        <div class="subtext">次均 888.4万</div>
      </div>
      
      <div class="stat-card">
        <div class="stat-top">
          <span class="label">使用工具 ❔</span>
        </div>
        <div class="value">{toolsUsed} <span class="unit">个</span></div>
        <div class="subtext">主力 {toolKeys[0] || '无'}</div>
      </div>
      <div class="stat-card">
        <div class="stat-top">
          <span class="label">AI 耗时 ❔</span>
          <span class="trend positive">+785%</span>
        </div>
        <div class="value">18.9 <span class="unit">小时</span></div>
        <div class="subtext">日均 18.9 小时</div>
      </div>
      <div class="stat-card">
        <div class="stat-top">
          <span class="label">缓存命中 ❔</span>
        </div>
        <div class="value">{cacheHitRate}<span class="unit">%</span></div>
        <div class="subtext">缓存读 {formatAmountStr(cacheHitTokens)}</div>
      </div>
      <div class="stat-card">
        <div class="stat-top">
          <span class="label">连续活跃 ❔</span>
        </div>
        <div class="value">{activeStreak} <span class="unit">天</span></div>
        <div class="subtext">接入以来 45 天</div>
      </div>
    </div>

    <!-- Key Facts Banner -->
    <div class="key-facts-banner">
      <div class="fact-col">
        <span class="fact-label">当日在全史排位</span>
        <span class="fact-value">第 14 / 45 个活跃日</span>
      </div>
      <div class="fact-col">
        <span class="fact-label">单日纪录</span>
        <span class="fact-value">{formatAmountStr(maxDayTokens)} · {maxDayStr}</span>
      </div>
      <div class="fact-col">
        <span class="fact-label">连续活跃</span>
        <span class="fact-value">{activeStreak} 天</span>
      </div>
      <div class="fact-col">
        <span class="fact-label">接入以来</span>
        <span class="fact-value">2026-06-12 起 · 45 个活跃日</span>
      </div>
      <div class="fact-col">
        <span class="fact-label">近 30 天日均</span>
        <span class="fact-value">{formatAmountStr(avgTokens)}</span>
      </div>
    </div>

    <!-- Charts -->
    <div class="charts-row">
      <div class="chart-box">
        <h3>近 {days} 天每天用量</h3>
        <div id="usageChart" style="height: 250px; width: 100%;"></div>
      </div>
      <div class="chart-box">
        <h3>近 {days} 天每日成本</h3>
        <div id="costChart" style="height: 250px; width: 100%;"></div>
      </div>
    </div>

    <!-- Progress Bars -->
    <div class="charts-row">
      <div class="chart-box">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 1rem;">
          <h3>按工具</h3>
        </div>
        <div class="progress-list">
          {toolKeys.map((k, i) => (
            <div class="progress-item">
              <span class="p-label">{k === 'codex' ? 'Codex' : k === 'antigravity' ? 'Antigravity' : k}</span>
              <div class="p-bar-wrapper">
                <div class="p-bar" style={`width: ${periodTokens > 0 ? (toolValues[i]/periodTokens*100) : 0}%; background-color: ${i===0 ? '#2563EB' : '#93C5FD'};`}></div>
              </div>
              <div class="p-values">
                <span class="p-val-amount">{formatAmountStr(toolValues[i])}</span>
                <span class="p-val-pct">{(periodTokens > 0 ? (toolValues[i]/periodTokens*100) : 0).toFixed(1)}%</span>
              </div>
            </div>
          ))}
        </div>
      </div>
      <div class="chart-box">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom: 1rem;">
          <h3>按模型</h3>
          <span style="font-size:0.75rem; color:var(--text-secondary);">Top 8</span>
        </div>
        <div class="progress-list">
          {modelKeys.map((k, i) => (
            <div class="progress-item">
              <span class="p-label">{k}</span>
              <div class="p-bar-wrapper">
                <div class="p-bar" style={`width: ${periodTokens > 0 ? (modelValues[i]/periodTokens*100) : 0}%; background-color: ${i===0 ? '#2563EB' : '#93C5FD'};`}></div>
              </div>
              <div class="p-values">
                <span class="p-val-amount">{formatAmountStr(modelValues[i])}</span>
                <span class="p-val-pct">{(periodTokens > 0 ? (modelValues[i]/periodTokens*100) : 0).toFixed(1)}%</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Token Composition -->
    <div class="chart-box" style="margin-bottom: 1.5rem;">
      <h3>Token 构成</h3>
      <div class="composition-bar">
        <div class="comp-input" style={`width: 6.4%;`}></div>
        <div class="comp-output" style={`width: 0.7%;`}></div>
        <div class="comp-cache-read" style={`width: 92.8%;`}></div>
      </div>
      <div class="comp-legend">
        <span><div class="dot" style="background:#2563EB;"></div> 输入 6.4%</span>
        <span><div class="dot" style="background:#93C5FD;"></div> 输出 0.7%</span>
        <span><div class="dot" style="background:#E5E7EB;"></div> 缓存读 92.8%</span>
        <span><div class="dot" style="background:#D1D5DB;"></div> 缓存写 0.0%</span>
      </div>
      <div class="subtext" style="margin-top:0.5rem;">缓存节省 ≈${(periodCost*0.6).toFixed(0)} (按输入价折算)</div>
    </div>

    <!-- Data Table -->
    <div class="chart-box">
      <h3>按天明细</h3>
      <div class="table-responsive">
        <table class="data-table">
          <thead>
            <tr>
              <th>日期</th>
              <th>Codex</th>
              <th>Antigravity</th>
              <th>合计</th>
              <th>成本</th>
              <th>会话</th>
              <th>命中率</th>
            </tr>
          </thead>
          <tbody>
            {lastXDays.map(date => {
              const dData = dailyMap[date];
              if (!dData || dData.tokens === 0) return null;
              return (
                <tr>
                  <td>{date}</td>
                  <td>{dData.codex > 0 ? formatAmountStr(dData.codex) : '—'}</td>
                  <td>{dData.antigravity > 0 ? formatAmountStr(dData.antigravity) : '—'}</td>
                  <td class="td-total">{formatAmountStr(dData.tokens)}</td>
                  <td>${dData.cost.toFixed(2)}</td>
                  <td>{dData.sessions}</td>
                  <td>
                    <div class="hit-rate-cell">
                      <span>{(dData.cache/dData.tokens*100).toFixed(1)}%</span>
                      <div class="tiny-bar"><div class="tiny-fill" style={`width: ${dData.cache/dData.tokens*100}%;`}></div></div>
                    </div>
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>

  </div>
</BaseLayout>

<script src="https://cdn.jsdelivr.net/npm/echarts@5.5.0/dist/echarts.min.js"></script>
<script is:inline define:vars={{ chartData }}>
  document.addEventListener('DOMContentLoaded', () => {
    // Usage Chart
    const usageChart = echarts.init(document.getElementById('usageChart'));
    usageChart.setOption({
      tooltip: { trigger: 'axis' },
      grid: { left: '3%', right: '4%', bottom: '3%', top: '10%', containLabel: true },
      xAxis: { type: 'category', data: chartData.lastXDays, axisLine: { lineStyle: { color: '#e5e7eb' } }, axisLabel: { color: '#6b7280' } },
      yAxis: { type: 'value', splitLine: { show: false }, axisLabel: { color: '#6b7280', formatter: (val) => (val/100000000) > 1 ? (val/100000000).toFixed(1) + '亿' : (val/10000) + '万' } },
      series: [{ data: chartData.dailyUsage, type: 'bar', itemStyle: { color: '#93C5FD', borderRadius: [2,2,0,0] }, barWidth: '40%' }]
    });

    // Cost Chart
    const costChart = echarts.init(document.getElementById('costChart'));
    costChart.setOption({
      tooltip: { trigger: 'axis', formatter: '${c}' },
      grid: { left: '3%', right: '4%', bottom: '3%', top: '10%', containLabel: true },
      xAxis: { type: 'category', data: chartData.lastXDays, axisLine: { lineStyle: { color: '#e5e7eb' } }, axisLabel: { color: '#6b7280' } },
      yAxis: { type: 'value', splitLine: { show: false }, axisLabel: { color: '#6b7280', formatter: '${value}' } },
      series: [{ data: chartData.dailyCost, type: 'bar', itemStyle: { color: '#93C5FD', borderRadius: [2,2,0,0] }, barWidth: '40%' }]
    });

    window.addEventListener('resize', () => {
      usageChart.resize();
      costChart.resize();
    });
  });
</script>

<style>
  :root {
    --bg-page: #F9FAFB;
    --border: #E5E7EB;
    --text-main: #111827;
    --text-sec: #6B7280;
    --accent: #2563EB;
    --positive: #10B981;
    --card-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  }

  body {
    background-color: var(--bg-page);
  }

  .dashboard-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1rem;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    color: var(--text-main);
  }
  
  .dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }
  
  .user-info { display: flex; align-items: center; gap: 1rem; }
  .avatar { width: 48px; height: 48px; border-radius: 50%; border: 1px solid var(--border); }
  .user-info h1 { margin: 0 0 0.2rem 0; font-size: 1.25rem; font-weight: 600; }
  .location { font-size: 0.8rem; color: var(--text-sec); }
  
  .back-link {
    color: var(--text-sec);
    text-decoration: none;
    font-size: 0.875rem;
    padding: 0.4rem 1rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: #fff;
    transition: all 0.2s;
  }
  .back-link:hover { color: var(--text-main); border-color: #D1D5DB; }

  .tabs {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .tabs a {
    background: #fff;
    border: 1px solid var(--border);
    padding: 0.35rem 1rem;
    border-radius: 9999px;
    color: var(--text-sec);
    font-size: 0.875rem;
    cursor: pointer;
    text-decoration: none;
  }
  .tabs a.active {
    background: #F3F4F6;
    border-color: #D1D5DB;
    color: var(--text-main);
    font-weight: 500;
  }
  .current-date { margin-left: auto; font-size: 0.875rem; color: var(--text-sec); align-self: center; }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 1.5rem;
  }
  .stat-card {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.25rem;
    box-shadow: var(--card-shadow);
  }
  .stat-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; }
  .stat-card .label { font-size: 0.875rem; color: var(--text-sec); }
  .stat-card .trend { font-size: 0.75rem; font-weight: 600; }
  .trend.positive { color: var(--positive); }
  .stat-card .value { font-size: 1.75rem; font-weight: 700; color: var(--text-main); margin-bottom: 0.25rem; }
  .stat-card .unit { font-size: 0.875rem; font-weight: 500; margin-left: 0.2rem; }
  .stat-card .subtext { font-size: 0.8rem; color: var(--text-sec); }

  .key-facts-banner {
    background: #fff;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 1.25rem 2rem;
    display: flex;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    box-shadow: var(--card-shadow);
  }
  .fact-col { display: flex; align-items: center; gap: 1rem; }
  .fact-label { font-size: 0.875rem; color: var(--text-sec); }
  .fact-value { font-size: 0.875rem; font-weight: 600; color: var(--text-main); }

  .charts-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; margin-bottom: 1.5rem; }
  .chart-box { background: #fff; border: 1px solid var(--border); border-radius: 12px; padding: 1.5rem; box-shadow: var(--card-shadow); }
  .chart-box h3 { margin: 0 0 1rem 0; font-size: 1rem; font-weight: 600; color: var(--text-main); }

  /* Progress Bars */
  .progress-list { display: flex; flex-direction: column; gap: 0.8rem; }
  .progress-item { display: flex; align-items: center; font-size: 0.875rem; }
  .p-label { width: 100px; color: var(--text-sec); }
  .p-bar-wrapper { flex: 1; height: 16px; background: #F3F4F6; border-radius: 4px; overflow: hidden; margin-right: 1rem; }
  .p-bar { height: 100%; border-radius: 4px; }
  .p-values { width: 100px; display: flex; justify-content: flex-end; gap: 0.5rem; }
  .p-val-amount { font-weight: 500; }
  .p-val-pct { color: var(--text-sec); width: 40px; text-align: right; }

  /* Token Composition */
  .composition-bar { display: flex; height: 16px; border-radius: 8px; overflow: hidden; margin-bottom: 1rem; background: #F3F4F6; }
  .comp-input { background: #2563EB; }
  .comp-output { background: #93C5FD; }
  .comp-cache-read { background: #E5E7EB; }
  .comp-legend { display: flex; gap: 1.5rem; font-size: 0.8rem; color: var(--text-sec); }
  .comp-legend span { display: flex; align-items: center; gap: 0.4rem; }
  .dot { width: 8px; height: 8px; border-radius: 50%; }

  /* Data Table */
  .table-responsive { overflow-x: auto; }
  .data-table { width: 100%; border-collapse: collapse; text-align: left; font-size: 0.875rem; }
  .data-table th { color: var(--text-sec); font-weight: 400; padding: 0.75rem 0; border-bottom: 1px solid var(--border); }
  .data-table td { padding: 1rem 0; border-bottom: 1px solid #F3F4F6; color: var(--text-main); }
  .td-total { font-weight: 600; }
  .hit-rate-cell { display: flex; align-items: center; gap: 0.5rem; }
  .tiny-bar { width: 40px; height: 4px; background: #F3F4F6; border-radius: 2px; }
  .tiny-fill { height: 100%; background: #111827; border-radius: 2px; }

  @media (max-width: 1024px) {
    .stats-grid { grid-template-columns: repeat(2, 1fr); }
    .charts-row { grid-template-columns: 1fr; }
    .key-facts-banner { flex-direction: column; gap: 0.5rem; align-items: flex-start; }
  }
</style>
