          <div class="bento-card">
            <div class="card-label">历史间隔参考点</div>
            <div class="card-value">{claude.nextEstimated.dateBeijing} <span class="time-sub">{claude.nextEstimated.timeBeijing}</span></div>
            <div class="card-sub">{claude.nextEstimated.relativeTextZh}</div>
            <div class="card-hint">基于 {claude.cadenceIntervalCount} 个全局重置间隔，不是官方排期</div>
