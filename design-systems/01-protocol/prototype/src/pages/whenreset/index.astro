                查看来源原帖 <span>↗</span>
              </a>
            )}
          </div>
        )}

        <!-- 4 Stats Cards Bento -->
        <div class="stats-bento">
          <div class="bento-card">
            <div class="card-label">最近一条事件</div>
            <div class="card-value highlight">{grok.latestEvent?.typeLabelZh || '暂无记录'}</div>
