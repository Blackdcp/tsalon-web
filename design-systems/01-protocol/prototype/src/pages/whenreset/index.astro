---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getResetRadarData } from '../../lib/reset-radar';

export const prerender = false;

const radarData = await getResetRadarData();
const { codex, claude, updatedAtBeijing } = radarData;

const stripTags = (html: string) => html.replace(/<[^>]*>/g, '');

const faqItems = [
  {
    q: '官方重置（Reset）与 5 小时窗口有什么区别',
    a: '<strong>官方重置</strong>是平台运营方的全员福利或活动（例如新模型上线庆祝、服务故障补偿、发卡活动），通常由官方人员在 X 上官宣后生效。<strong>5 小时窗口</strong>则是每个账号系统固定的滑动限制，从你发起请求开始滚动计算 5 小时后自动释放部分配额。',
  },
  {
    q: '重置卡（Reset Card）怎么用',
    a: '重置卡是官方空投给部分用户的额度应急券。在用量触顶时可以主动消耗一张卡，瞬间刷新个人额度。重置卡通常具有时效性或账号绑定属性，老号与新号发放规则以官方公告为准。',
  },
  {
    q: '预测下次重置时间是如何计算的',
    a: '该时间基于过去 10 次官方重置之间的<strong>间隔中位数</strong>（Median Gap）进行数学推算，仅作为社群经验参考，并非官方固定排期日程。官方突袭往往伴随模型重大升级或偶发技术故障。',
  },
  {
    q: '被限额后如何继续高效工作',
    a: '建议建立多工具互备策略（例如 Codex 与 Claude Code 双持）；合理利用 Thinking 开关与 Prompt 缓存；在等待 5 小时窗口冷却期间，可复盘架构或在 T Salon TokenRank 检查用量消耗分布。',
  },
];

const pageUrl = new URL('/whenreset/', Astro.site).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'AI 编程额度重置雷达',
    url: pageUrl,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Web',
    description:
      '实时监控 OpenAI Codex 与 Anthropic Claude 的官方用量重置（Reset）与空投补卡记录，全部换算为北京时间，并基于历史间隔中位数推算下次重置时间，另提供 5 小时滑动窗口推算器。',
    publisher: { '@type': 'Organization', name: 'T Salon', url: 'https://www.tsalon.tech/' },
    inLanguage: 'zh-CN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    url: pageUrl,
    inLanguage: 'zh-CN',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: stripTags(item.a) },
    })),
  },
];
---

<BaseLayout
  title="AI 编程额度重置雷达 · 实时监控 | T Salon"
  description="实时监控 OpenAI Codex、Claude 等 AI 编程工具用量重置（Reset）倒计时、官方掉卡记录及北京时间恢复推算。"
  alternatePath="/en/whenreset/"
  locale="zh"
  jsonLd={jsonLd}
>
  <main class="reset-page">
    <div class="container">
      <!-- Top Title & Live Status -->
      <section class="reset-hero">
        <div class="hero-top-badge">
          <span class="pulse-dot"></span>
          <span>雷达监控中 · 北京时间 {updatedAtBeijing} 更新</span>
        </div>
        <h1 class="hero-title">AI 编程额度重置雷达</h1>
        <p class="hero-desc">
          全天候监控 OpenAI Codex 与 Claude 官方突发用量重置、空投补卡动态与周期规律。告别时差折算，全量换算北京时间。
        </p>

        <!-- Provider Switcher Tabs -->
        <div class="provider-tabs">
          <button class="tab-btn active" data-provider="codex">
            <span class="tab-icon">⚡️</span>
            <span class="tab-name">OpenAI Codex</span>
            <span class="tab-badge">最频繁</span>
          </button>
          <button class="tab-btn" data-provider="claude">
            <span class="tab-icon">🧠</span>
            <span class="tab-name">Anthropic Claude</span>
            <span class="tab-badge">周重置</span>
          </button>
        </div>
      </section>

      <!-- Codex Section -->
      <div id="section-codex" class="provider-section active">
        {codex.watchNotice?.isOpen && (
          <div class="alert-banner">
            <div class="alert-icon">🚨</div>
            <div class="alert-content">
              <div class="alert-title">{codex.watchNotice.titleZh || "官方突袭重置预警"}</div>
              <p class="alert-text">{codex.watchNotice.text}</p>
              {codex.watchNotice.scheduledAtBeijing && (
                <div class="alert-meta">预计落地：北京时间 {codex.watchNotice.scheduledAtBeijing}</div>
              )}
            </div>
            {codex.watchNotice.tweetUrl && (
              <a href={codex.watchNotice.tweetUrl} target="_blank" rel="noreferrer" class="btn btn-dark alert-btn">
                查看推特原文 <span>↗</span>
              </a>
            )}
          </div>
        )}

        <!-- 4 Stats Cards Bento -->
        <div class="stats-bento">
          <div class="bento-card">
            <div class="card-label">距上次全局重置已过</div>
            <div class="card-value highlight">{codex.sinceLastReset.textZh}</div>
            <div class="card-sub">适用范围：{codex.lastReset.scopeZh}</div>
          </div>

          <div class="bento-card">
            <div class="card-label">上次重置落地时间</div>
            <div class="card-value">{codex.lastReset.dateBeijing} <span class="time-sub">{codex.lastReset.timeBeijing}</span></div>
            <div class="card-sub text-truncate">原因：{codex.lastReset.reasonZh}</div>
            {codex.lastReset.postUrl && (
              <a href={codex.lastReset.postUrl} target="_blank" rel="noreferrer" class="card-link">官方出处 ↗</a>
            )}
          </div>

          <div class="bento-card">
            <div class="card-label">下次重置预测（经验模型）</div>
            <div class={`card-value ${codex.nextEstimated.isOverdue ? 'warn' : 'accent'}`}>
              {codex.nextEstimated.dateBeijing} <span class="time-sub">{codex.nextEstimated.timeBeijing}</span>
            </div>
            <div class="card-sub">{codex.nextEstimated.relativeTextZh}</div>
            <div class="card-hint">基于最近 10 次重置中位数推算</div>
          </div>

          <div class="bento-card">
            <div class="card-label">历史节奏与发卡</div>
            <div class="card-value">{codex.typicalGapDays} <span class="unit">天 / 次</span></div>
            <div class="card-sub">近 30 天：已重置 {codex.resets30d} 次，空投补卡 {codex.cards30d} 次</div>
            <div class="card-hint">数据源自 {codex.sourceAccount}</div>
          </div>
        </div>

        <!-- 5-Hour Rolling Window Calculator -->
        <div class="tool-card">
          <div class="tool-header">
            <div class="tool-icon">⏳</div>
            <div>
              <h2 class="tool-title">个人 5 小时滑动窗口推算器</h2>
              <p class="tool-sub">官方突发重置是全员福利；个人的用量上限遵循 5 小时滑动窗口。输入你触发限额的时间，自动推算恢复时刻</p>
            </div>
          </div>
          <div class="calc-row">
            <div class="calc-input-group">
              <label for="codex-limit-time">触发限额时间（北京时间）</label>
              <input type="time" id="codex-limit-time" class="time-input" />
            </div>
            <div class="calc-arrow">➔</div>
            <div class="calc-result-box">
              <div class="result-label">预计第一波额度释放时刻</div>
              <div class="result-time" id="codex-calc-result">--:--</div>
              <div class="result-tips" id="codex-calc-tips">选择时间后自动推算</div>
            </div>
          </div>
        </div>

        <!-- Events Table -->
        <div class="history-section">
          <div class="history-header">
            <h2 class="history-title">Codex 历史重置与掉卡记录</h2>
            <span class="history-count">最近 30 次记录 · 全部换算为北京时间</span>
          </div>

          <div class="table-responsive">
            <table class="radar-table">
              <thead>
                <tr>
                  <th>日期 (北京时间)</th>
                  <th>类型</th>
                  <th>适用范围</th>
                  <th>触发原因 / 说明</th>
                  <th>距今</th>
                  <th>出处</th>
                </tr>
              </thead>
              <tbody>
                {codex.events.map((e) => (
                  <tr>
                    <td class="cell-date">{e.landedAtBeijing}</td>
                    <td>
                      <span class={`badge ${e.type === 'reset' ? 'badge-reset' : 'badge-card'}`}>
                        {e.typeLabelZh}
                      </span>
                    </td>
                    <td class="cell-scope">{e.scopeZh}</td>
                    <td class="cell-reason">{e.reasonZh}</td>
                    <td class="cell-timeago">{e.timeAgoZh}</td>
                    <td class="cell-src">
                      {e.postUrl ? (
                        <a href={e.postUrl} target="_blank" rel="noreferrer" class="src-link">
                          推文 ↗
                        </a>
                      ) : (
                        '--'
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Claude Section -->
      <div id="section-claude" class="provider-section">
        <!-- 4 Stats Cards Bento -->
        <div class="stats-bento">
          <div class="bento-card">
            <div class="card-label">距上次周额度重置已过</div>
            <div class="card-value highlight">{claude.sinceLastReset.textZh}</div>
            <div class="card-sub">适用范围：{claude.lastReset.scopeZh}</div>
          </div>

          <div class="bento-card">
            <div class="card-label">上次重置落地时间</div>
            <div class="card-value">{claude.lastReset.dateBeijing} <span class="time-sub">{claude.lastReset.timeBeijing}</span></div>
            <div class="card-sub text-truncate">原因：{claude.lastReset.reasonZh}</div>
            {claude.lastReset.postUrl && (
              <a href={claude.lastReset.postUrl} target="_blank" rel="noreferrer" class="card-link">官方出处 ↗</a>
            )}
          </div>

          <div class="bento-card">
            <div class="card-label">下次周重置预测</div>
            <div class={`card-value ${claude.nextEstimated.isOverdue ? 'warn' : 'accent'}`}>
              {claude.nextEstimated.dateBeijing} <span class="time-sub">{claude.nextEstimated.timeBeijing}</span>
            </div>
            <div class="card-sub">{claude.nextEstimated.relativeTextZh}</div>
            <div class="card-hint">基于中位数周期（约 7.1 天）推算</div>
          </div>

          <div class="bento-card">
            <div class="card-label">30 天重置节奏</div>
            <div class="card-value">{claude.typicalGapDays} <span class="unit">天 / 次</span></div>
            <div class="card-sub">近 30 天：已重置 {claude.resets30d} 次</div>
            <div class="card-hint">数据源自 {claude.sourceAccount}</div>
          </div>
        </div>

        <!-- 5-Hour Rolling Window Calculator for Claude -->
        <div class="tool-card">
          <div class="tool-header">
            <div class="tool-icon">⏳</div>
            <div>
              <h2 class="tool-title">Claude Code 5 小时滑动窗口推算器</h2>
              <p class="tool-sub">Claude Pro/Max 会员设有 5 小时动态消息上限。输入你提示达到上限的时间，推算配额恢复点</p>
            </div>
          </div>
          <div class="calc-row">
            <div class="calc-input-group">
              <label for="claude-limit-time">触发限额时间（北京时间）</label>
              <input type="time" id="claude-limit-time" class="time-input" />
            </div>
            <div class="calc-arrow">➔</div>
            <div class="calc-result-box">
              <div class="result-label">预计第一批额度释放时刻</div>
              <div class="result-time" id="claude-calc-result">--:--</div>
              <div class="result-tips" id="claude-calc-tips">选择时间后自动推算</div>
            </div>
          </div>
        </div>

        <!-- Events Table -->
        <div class="history-section">
          <div class="history-header">
            <h2 class="history-title">Claude 历史重置记录</h2>
            <span class="history-count">全部换算为北京时间</span>
          </div>

          <div class="table-responsive">
            <table class="radar-table">
              <thead>
                <tr>
                  <th>日期 (北京时间)</th>
                  <th>类型</th>
                  <th>适用范围</th>
                  <th>触发原因 / 说明</th>
                  <th>距今</th>
                  <th>出处</th>
                </tr>
              </thead>
              <tbody>
                {claude.events.map((e) => (
                  <tr>
                    <td class="cell-date">{e.landedAtBeijing}</td>
                    <td>
                      <span class="badge badge-reset">{e.typeLabelZh}</span>
                    </td>
                    <td class="cell-scope">{e.scopeZh}</td>
                    <td class="cell-reason">{e.reasonZh}</td>
                    <td class="cell-timeago">{e.timeAgoZh}</td>
                    <td class="cell-src">
                      {e.postUrl ? (
                        <a href={e.postUrl} target="_blank" rel="noreferrer" class="src-link">
                          推文 ↗
                        </a>
                      ) : (
                        '--'
                      )}
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- FAQ & Strategy Section -->
      <section class="faq-section">
        <h2 class="faq-main-title">关于额度重置常见规则</h2>
        <div class="faq-grid">
          {faqItems.map((item) => (
            <div class="faq-item">
              <h3 class="faq-q">{item.q}</h3>
              <p class="faq-a" set:html={item.a} />
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>
</BaseLayout>

<script>
  // Tab Switcher
  const tabBtns = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const sections = document.querySelectorAll<HTMLElement>('.provider-section');

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const provider = btn.dataset.provider;
      tabBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      sections.forEach((sec) => {
        if (sec.id === `section-${provider}`) {
          sec.classList.add('active');
        } else {
          sec.classList.remove('active');
        }
      });
    });
  });

  // 5-Hour Calculator Helper
  function initCalculator(inputId: string, resultId: string, tipsId: string) {
    const input = document.getElementById(inputId) as HTMLInputElement | null;
    const result = document.getElementById(resultId);
    const tips = document.getElementById(tipsId);
    if (!input || !result || !tips) return;

    // Set default to current time
    const now = new Date();
    const curH = String(now.getHours()).padStart(2, '0');
    const curM = String(now.getMinutes()).padStart(2, '0');
    input.value = `${curH}:${curM}`;

    const calculate = () => {
      const val = input.value;
      if (!val) return;
      const [h, m] = val.split(':').map(Number);
      if (isNaN(h) || isNaN(m)) return;

      const date = new Date();
      date.setHours(h);
      date.setMinutes(m);
      date.setSeconds(0);

      // Add 5 hours
      const recoverDate = new Date(date.getTime() + 5 * 60 * 60 * 1000);
      const rh = String(recoverDate.getHours()).padStart(2, '0');
      const rm = String(recoverDate.getMinutes()).padStart(2, '0');

      const isNextDay = recoverDate.getDate() !== date.getDate();
      result.textContent = `${rh}:${rm} ${isNextDay ? '(次日)' : ''}`;
      tips.textContent = `在 ${rh}:${rm} 左右，你的第一批 5 小时滑动额度将陆续回血`;
    };

    input.addEventListener('change', calculate);
    input.addEventListener('input', calculate);
    calculate();
  }

  initCalculator('codex-limit-time', 'codex-calc-result', 'codex-calc-tips');
  initCalculator('claude-limit-time', 'claude-calc-result', 'claude-calc-tips');
</script>

<style>
  .reset-page {
    padding-top: var(--space-12);
    padding-bottom: var(--space-24);
    min-height: 80vh;
  }

  .reset-hero {
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--border-default);
  }

  .hero-top-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 4px 12px;
    background: var(--background-subtle);
    border: 1px solid var(--border-default);
    font-size: var(--text-12);
    font-family: var(--font-mono);
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
    border-radius: 999px;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #10b981;
    box-shadow: 0 0 8px #10b981;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.85); }
  }

  .hero-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.03em;
    line-height: 1.15;
    margin: 0 0 var(--space-4);
  }

  .hero-desc {
    max-width: 680px;
    color: var(--text-secondary);
    font-size: var(--text-15);
    line-height: 1.6;
    margin: 0 0 var(--space-8);
  }

  .provider-tabs {
    display: flex;
    gap: var(--space-3);
  }

  .tab-btn {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    background: var(--background-subtle);
    border: 1px solid var(--border-default);
    color: var(--text-secondary);
    font-size: var(--text-14);
    font-weight: var(--font-weight-medium);
    cursor: pointer;
    transition: all var(--duration-base) var(--ease-standard);
  }

  .tab-btn:hover {
    background: #fff;
    border-color: var(--color-ink-950);
    color: var(--color-ink-950);
  }

  .tab-btn.active {
    background: var(--color-ink-950);
    color: #fff;
    border-color: var(--color-ink-950);
  }

  .tab-badge {
    font-size: var(--text-10);
    padding: 2px 6px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 4px;
    font-family: var(--font-mono);
  }

  .tab-btn:not(.active) .tab-badge {
    background: var(--border-default);
    color: var(--text-secondary);
  }

  .provider-section {
    display: none;
  }

  .provider-section.active {
    display: block;
  }

  /* Alert Banner */
  .alert-banner {
    margin-bottom: var(--space-8);
    padding: var(--space-5) var(--space-6);
    background: #fffbeb;
    border: 1px solid #fde68a;
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }

  .alert-icon {
    font-size: 1.8rem;
  }

  .alert-content {
    flex: 1;
  }

  .alert-title {
    font-weight: var(--font-weight-bold);
    color: #92400e;
    margin-bottom: 2px;
  }

  .alert-text {
    font-size: var(--text-13);
    color: #78350f;
    margin: 0;
  }

  .alert-meta {
    font-size: var(--text-11);
    font-family: var(--font-mono);
    color: #b45309;
    margin-top: 4px;
  }

  .alert-btn {
    white-space: nowrap;
  }

  /* Stats Bento Grid */
  .stats-bento {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-4);
    margin-bottom: var(--space-10);
  }

  .bento-card {
    background: #fff;
    border: 1px solid var(--border-default);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .card-label {
    font-size: var(--text-11);
    font-family: var(--font-mono);
    color: var(--text-tertiary);
    text-transform: uppercase;
    margin-bottom: var(--space-3);
  }

  .card-value {
    font-size: 1.85rem;
    font-weight: var(--font-weight-bold);
    color: var(--color-ink-950);
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: var(--space-2);
  }

  .card-value.highlight {
    color: #2563eb;
  }

  .card-value.accent {
    color: #059669;
  }

  .card-value.warn {
    color: #ea580c;
  }

  .time-sub {
    font-size: 1.1rem;
    font-weight: var(--font-weight-normal);
    color: var(--text-secondary);
  }

  .unit {
    font-size: 1.1rem;
    font-weight: var(--font-weight-normal);
    color: var(--text-tertiary);
  }

  .card-sub {
    font-size: var(--text-12);
    color: var(--text-secondary);
    line-height: 1.4;
  }

  .card-hint {
    font-size: var(--text-10);
    font-family: var(--font-mono);
    color: var(--text-tertiary);
    margin-top: auto;
    padding-top: var(--space-3);
  }

  .card-link {
    font-size: var(--text-11);
    color: #2563eb;
    margin-top: var(--space-2);
    text-decoration: underline;
  }

  .text-truncate {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

