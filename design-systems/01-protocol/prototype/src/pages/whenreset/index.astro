              <tbody>
                {claude.events.length === 0 && <tr><td colspan="6">暂无可用事件记录。</td></tr>}
                {claude.events.map((e) => (
                  <tr>
                    <td class="cell-date">{e.landedAtBeijing}</td>
                    <td>
                      <span class={`badge ${e.type === 'reset' ? 'badge-reset' : 'badge-card'}`}>{e.typeLabelZh}</span>
