---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getResetRadarData } from '../../lib/reset-radar';

export const prerender = false;

const radarData = await getResetRadarData();
const { codex, claude, grok, updatedAtBeijing, status } = radarData;

const stripTags = (html: string) => html.replace(/<[^>]*>/g, '');

const faqItems = [
  {
    "q": "全局重置、指定范围重置和重置卡有什么区别？",
    "a": "本页只将范围标为全部用户的重置记录称为全局重置；其他重置保留记录中的适用范围。重置卡记录表示发卡事件，不代表所有账号已自动重置。资格、使用方式和有效期请查看该条原帖。这些记录都不能确定你的个人剩余额度。"
  },
  {
    "q": "能从触顶时间算出恢复时间吗？",
    "a": "不能。触顶时刻不等于窗口起点。计算器只对你输入的<strong>已知窗口起点</strong>加 5 小时，结果仅表示该假设下的窗口结束时间。不同产品和套餐可能有不同或额外限额，请以产品内显示的时间和额度为准。"
  },
  {
    "q": "历史间隔参考点如何计算？",
    "a": "从本次读取的记录中取最近最多 10 个不同的全局重置时刻，计算相邻间隔的中位数，再加到最近一次全局重置时刻上。重置卡和指定范围重置不参与计算。全局重置少于两次时不显示参考点。这只是历史时间计算，不是官方排期，也不是个人额度恢复预测。"
  },
  {
    "q": "Codex、Claude 与 Grok 记录来自哪里？",
    "a": "T Salon 在页面被请求时读取 <a href=\"https://whenreset.dev/api/resets\" target=\"_blank\" rel=\"noreferrer\">WhenReset.dev 记录接口</a>，缓存 5 分钟，各条记录附原帖链接。“读取时间”表示获取来源数据的时刻，不代表刚发生新重置。请求失败时显示暂不可用；来源记录可能不完整。"
  },
  {
    "q": "每周额度规划计算器如何使用？",
    "a": "在客户端用量页查看本周已消耗百分比并设置下次重置时间，计算器将自动推算当前消耗速度、距重置剩余时间以及建议的每日消耗预算。数据仅保存在浏览器本地，不会上传服务器。"
  }
];

const pageUrl = new URL('/whenreset/', Astro.site).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'AI 编程额度重置雷达',
    url: pageUrl,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Web',
    description:
      '查看 WhenReset.dev 收录的 Codex、Claude 与 Grok 重置和重置卡记录、北京时间与原帖链接，提供每周额度规划、五小时窗口计算与多渠道推送订阅。',
    publisher: { '@type': 'Organization', name: 'T Salon', url: 'https://www.tsalon.tech/' },
    inLanguage: 'zh-CN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    url: pageUrl,
    inLanguage: 'zh-CN',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: stripTags(item.a) },
    })),
  },
];
---

<BaseLayout
  title="AI 编程额度重置雷达 · 多产品监控与周额度规划 | T Salon"
  description="查看 WhenReset.dev 收录的 Codex、Claude、Grok 重置和重置卡记录及原帖，提供每周额度规划计算、五小时窗口计算与 RSS/Webhook 多渠道订阅。"
  alternatePath="/en/whenreset/"
  locale="zh"
  jsonLd={jsonLd}
>
  <main class="reset-page">
    <div class="container">
      <!-- Top Title & Live Status -->
      <section class="reset-hero">
        <div class="hero-top-badge">
          <span class:list={['pulse-dot', { unavailable: status === 'unavailable' }]}></span>
          <span>{status === 'unavailable' ? '暂时无法读取 WhenReset.dev 记录' : status === 'empty' ? 'WhenReset.dev 暂无可用记录' : 'WhenReset.dev 事件记录'}{updatedAtBeijing && ` · 北京时间 ${updatedAtBeijing} 读取`}</span>
        </div>
        <h1 class="hero-title">AI 编程额度重置雷达</h1>
        <p class="hero-desc">实时监控 OpenAI Codex、Anthropic Claude 与 xAI Grok 的全网重置与发卡记录，支持每周配额节奏规划与多渠道消息订阅。全局重置、指定范围重置与重置卡均不代表个人额度恢复时间。</p>

        <!-- Provider Switcher Tabs -->
        <div class="provider-tabs">
          <button class="tab-btn active" data-provider="codex">
            <span class="tab-icon">⚡️</span>
            <span class="tab-name">OpenAI Codex</span>
            <span class="tab-badge">事件记录</span>
          </button>
          <button class="tab-btn" data-provider="claude">
            <span class="tab-icon">🧠</span>
            <span class="tab-name">Anthropic Claude</span>
            <span class="tab-badge">事件记录</span>
          </button>
          <button class="tab-btn" data-provider="grok">
            <span class="tab-icon">🚀</span>
            <span class="tab-name">xAI Grok</span>
            <span class="tab-badge">事件记录</span>
          </button>
        </div>
      </section>

      <!-- Codex Section -->
      <div id="section-codex" class="provider-section active">
        {codex.watchNotice?.isOpen && (
          <div class="alert-banner">
            <div class="alert-icon">🚨</div>
            <div class="alert-content">
              <div class="alert-title">{codex.watchNotice.titleZh || "来源中的待发生通知"}</div>
              <p class="alert-text">{codex.watchNotice.text}</p>
              {codex.watchNotice.scheduledAtBeijing && (
                <div class="alert-meta">来源所列时间：北京时间 {codex.watchNotice.scheduledAtBeijing}</div>
              )}
            </div>
            {codex.watchNotice.tweetUrl && (
              <a href={codex.watchNotice.tweetUrl} target="_blank" rel="noreferrer" class="btn btn-dark alert-btn">
                查看来源原帖 <span>↗</span>
              </a>
            )}
          </div>
        )}

        <!-- 4 Stats Cards Bento -->
        <div class="stats-bento">
          <div class="bento-card">
            <div class="card-label">最近一条事件</div>
            <div class="card-value highlight">{codex.latestEvent?.typeLabelZh || '暂无记录'}</div>
            <div class="card-sub">{codex.latestEvent?.timeAgoZh || '—'}</div>
            <div class="card-sub">适用范围：{codex.latestEvent?.scopeZh || '未说明'}</div>
          </div>
          <div class="bento-card">
            <div class="card-label">该事件时间（北京时间）</div>
            <div class="card-value">{codex.latestEvent?.landedAtBeijing || '—'}</div>
            <div class="card-sub">原因：{codex.latestEvent?.reasonZh || '该记录未说明'}</div>
            {codex.latestEvent?.postUrl && (
              <a href={codex.latestEvent.postUrl} target="_blank" rel="noreferrer" class="card-link">该事件原帖 ↗</a>
            )}
          </div>
          <div class="bento-card">
            <div class="card-label">历史间隔参考点</div>
            <div class="card-value">{codex.nextEstimated.dateBeijing} <span class="time-sub">{codex.nextEstimated.timeBeijing}</span></div>
            <div class="card-sub">{codex.nextEstimated.relativeTextZh}</div>
            <div class="card-hint">基于 {codex.cadenceIntervalCount} 个全局重置间隔，不是官方排期</div>
          </div>
          <div class="bento-card">
            <div class="card-label">全局重置间隔中位数</div>
            <div class="card-value">{codex.typicalGapDays ?? '—'} <span class="unit">天</span></div>
            <div class="card-sub">已读取的近 30 天记录：{status === 'unavailable' ? '—' : codex.resets30d} 次重置，{status === 'unavailable' ? '—' : codex.cards30d} 次发卡</div>
            <div class="card-hint">来源：WhenReset.dev · 记录可能不完整</div>
          </div>
        </div>

        <!-- Window Time Calculator -->
        <div class="tool-card">
          <div class="tool-header">
            <div class="tool-icon">⏳</div>
            <div>
              <h2 class="tool-title">五小时窗口时间计算器</h2>
              <p class="tool-sub">填写已知窗口起点，不是触顶时刻。这里只按五小时假设计算结束时间；个人实际重置时间请以产品内显示为准。</p>
            </div>
          </div>
          <div class="calc-row">
            <div class="calc-input-group">
              <label for="codex-window-start">已知窗口起点（北京时间）</label>
              <input type="datetime-local" id="codex-window-start" class="time-input" step="60" />
              <button type="button" id="codex-calculate" class="btn btn-dark">按 5 小时计算</button>
            </div>
            <div class="calc-arrow" aria-hidden="true">➔</div>
            <div class="calc-result-box" aria-live="polite">
              <div class="result-label">假设窗口结束时间（北京时间）</div>
              <div class="result-time" id="codex-calc-result">—</div>
              <div class="result-tips" id="codex-calc-tips">输入已知起点后点击计算按钮。</div>
            </div>
          </div>
        </div>

        <!-- Events Table -->
        <div class="history-section">
          <div class="history-header">
            <h2 class="history-title">Codex 重置与重置卡记录</h2>
            <span class="history-count">最多 30 条已读取记录 · 北京时间</span>
          </div>

          <div class="table-responsive">
            <table class="radar-table">
              <thead>
                <tr>
                  <th>日期 (北京时间)</th>
                  <th>类型</th>
                  <th>适用范围</th>
                  <th>触发原因 / 说明</th>
                  <th>距今</th>
                  <th>出处</th>
                </tr>
              </thead>
              <tbody>
                {codex.events.length === 0 && <tr><td colspan="6">暂无可用事件记录。</td></tr>}
