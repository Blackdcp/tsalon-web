<script>
  import { initResetWindowCalculator } from '../../lib/reset-window';
  import { initWeeklyQuotaCalculator } from '../../lib/weekly-calculator';

  // Tab Switcher
  const tabBtns = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const sections = document.querySelectorAll<HTMLElement>('.provider-section');

  tabBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const provider = btn.dataset.provider;
      tabBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');

      sections.forEach((sec) => {
        if (sec.id === `section-${provider}`) {
          sec.classList.add('active');
        } else {
          sec.classList.remove('active');
        }
      });
    });
  });

  initResetWindowCalculator('codex', 'zh');
  initResetWindowCalculator('claude', 'zh');
  initResetWindowCalculator('grok', 'zh');
  initWeeklyQuotaCalculator('zh');

  // RSS Copy button
  const copyBtn = document.getElementById('copy-rss-btn');
  const rssInput = document.getElementById('rss-link-input') as HTMLInputElement | null;
  if (copyBtn && rssInput) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(rssInput.value);
        copyBtn.textContent = '已复制！';
        setTimeout(() => { copyBtn.textContent = '复制链接'; }, 2000);
      } catch (_) {
        rssInput.select();
      }
    });
  }

  // Desktop Notification
  const notifyBtn = document.getElementById('desktop-notification-btn');
  if (notifyBtn) {
    if ('Notification' in window && Notification.permission === 'granted') {
      notifyBtn.textContent = '已开启桌面通知 ✓';
      notifyBtn.classList.add('disabled');
    }
    notifyBtn.addEventListener('click', async () => {
      if (!('Notification' in window)) {
        alert('您的浏览器不支持桌面通知');
        return;
      }
      const perm = await Notification.requestPermission();
      if (perm === 'granted') {
        notifyBtn.textContent = '已开启桌面通知 ✓';
        new Notification('WhenReset 雷达', {
          body: '桌面通知已就绪，当出现新额度重置时将在此弹窗提醒。',
        });
      } else {
        alert('通知权限已被拒绝，请在浏览器站点设置中允许通知。');
      }
    });
  }
</script>

