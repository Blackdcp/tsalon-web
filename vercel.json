{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd design-systems/01-protocol/prototype && npm install",
  "buildCommand": "cd design-systems/01-protocol/prototype && npm run build",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "tsalon.tech"
        }
      ],
      "destination": "https://www.tsalon.tech/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "tsalon.tech"
        }
      ],
      "destination": "https://www.tsalon.tech/:path*",
      "permanent": true
    },
    {
      "source": "/archives",
      "destination": "/articles/",
      "permanent": true
    },
    {
      "source": "/archives/(.*)",
      "destination": "/articles/$1",
      "permanent": true
    },
    {
      "source": "/en/archives",
      "destination": "/en/articles/",
      "permanent": true
    },
    {
      "source": "/en/archives/(.*)",
      "destination": "/en/articles/$1",
      "permanent": true
    },
    {
      "source": "/join",
      "destination": "/about/#join",
      "permanent": true
    },
    {
      "source": "/join/(.*)",
      "destination": "/about/#join",
      "permanent": true
    },
    {
      "source": "/gallery",
      "destination": "/history/",
      "permanent": true
    },
    {
      "source": "/gallery/(.*)",
      "destination": "/history/$1",
      "permanent": true
    },
    {
      "source": "/en/gallery",
      "destination": "/en/history/",
      "permanent": true
    },
    {
      "source": "/en/gallery/(.*)",
      "destination": "/en/history/$1",
      "permanent": true
    },
    {
      "source": "/stories",
      "destination": "/events/",
      "permanent": true
    },
    {
      "source": "/stories/(.*)",
      "destination": "/events/$1",
      "permanent": true
    },
    {
      "source": "/en/stories",
      "destination": "/en/events/",
      "permanent": true
    },
    {
      "source": "/en/stories/(.*)",
      "destination": "/en/events/$1",
      "permanent": true
    }
  ]
}
