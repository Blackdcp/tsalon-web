{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd design-systems/01-protocol/prototype && npm install",
  "buildCommand": "cd design-systems/01-protocol/prototype && npm run build",
  "outputDirectory": "design-systems/01-protocol/prototype/dist",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "tsalon.tech"
        }
      ],
      "destination": "https://www.tsalon.tech/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "tsalon.tech"
        }
      ],
      "destination": "https://www.tsalon.tech/:path*",
      "permanent": true
    },
    {
      "source": "/archives/:path*",
      "destination": "/articles/:path*",
      "permanent": true
    },
    {
      "source": "/en/archives/:path*",
      "destination": "/en/articles/:path*",
      "permanent": true
    },
    {
      "source": "/join/:path*",
      "destination": "/about/#join",
      "permanent": true
    },
    {
      "source": "/gallery/:path*",
      "destination": "/history/:path*",
      "permanent": true
    },
    {
      "source": "/en/gallery/:path*",
      "destination": "/en/history/:path*",
      "permanent": true
    },
    {
      "source": "/stories/:path*",
      "destination": "/events/:path*",
      "permanent": true
    },
    {
      "source": "/en/stories/:path*",
      "destination": "/en/events/:path*",
      "permanent": true
    }
  ]
}
